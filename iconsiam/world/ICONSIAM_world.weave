object grid {
    is_locked = true
    model = "grid"
    position = (0, 0, -110)
    size = (10000, 10000, 100)
}
#adjuster
section "Water"
knob SetWaterEnabled = 1
knob SetWaterSeaLevelCm = -200
knob SetWaterAmplitudeCm = 3.75
knob SetWaterShallowColor = #6b6a4e
knob SetWaterDeepColor = #2e3a3c
knob SetWaterMurkDensity = 1.6
knob SetWaterTransparency = 0.15
knob SetWaterReflectionStrength = 1.1
section "Dusk (match reference photos)"
knob SetSunRotation = 305
knob SetSunTilt = 6
knob SetSunIntensity = 2.2
knob SetSunColor = #ffb070
knob SetSkyLightIntensity = 1.1
knob SetSkyLightColor = #8a90c8
knob SetBloomIntensity = 0.6
knob SetSkyboxGroundColor = #6a6478
knob SetDistanceFogEnabled = 1
knob SetFogColor = #8c86a6
knob SetFogStartDistance = 500
knob SetFogEndDistance = 1400
knob SetFogSkyboxAffect = 0
knob SetSkyboxHorizonTilt = 10
#end

// imported_material_asset {"asset_id":"material_5dadcd66b9fe0fce92f34c9beaad4ac76956b1d733dfc67dc9cf17f9d1c72b3e","source_digest":"5dadcd66b9fe0fce92f34c9beaad4ac76956b1d733dfc67dc9cf17f9d1c72b3e","catalog_key":null,"local_root":"lib1_NaturalBrush","local_digest":"7cb476554f7f622b67e8d4f4e2264d6b6167aa620d6fa5c70942a6a570e93d93"}
#texture lib1_NaturalBrush
size = 512;
tile_m = 0.24;
let brush = noise.fbm(uv * vec2(170, 4), octaves: 2, period: vec2(170, 4));
let micro = noise.fbm(uv * 100, octaves: 2, period: 100);
out.color = vec3(0.98, 0.98, 0.98) * (0.99 + brush * 0.02);
out.normal = normal_from_height((brush - 0.5) * 0.002 + (micro - 0.5) * 0.001, strength: 0.3);
out.orm = orm(occlusion: 1, roughness: 0.22 + brush * 0.08, metallic: 0.94);
#end

// imported_material_asset {"asset_id":"material_de7fb926cf1665b208bd50033d6dbbb58985dc921142056375c397ffd15d9ddb","source_digest":"de7fb926cf1665b208bd50033d6dbbb58985dc921142056375c397ffd15d9ddb","catalog_key":null,"local_root":"LibPlaster","local_digest":"64ac8a0ee5022cfc1c270dd47844c2ed6b7b792a1cd80772b1065bbce801420b"}
#texture LibPlaster
size = 1024;
tile_m = 1.6;
mapping = triplanar_world;
let trowel = noise.fbm(uv*7+noise.vec2(uv*3,seed:97,period:3)*0.36,octaves:4,seed:153,period:7);
let grit = noise.gaussian(uv*230,seed:239,period:230);
let pores = smoothstep(0.72,0.89,noise.gaussian(uv*185,seed:312,period:185));
let sand = noise.fbm(uv*73,octaves:2,seed:573,period:73);
let skim = smoothstep(0.37,0.65,trowel);
let h = 0.50+trowel*0.25+skim*0.075+sand*0.085+grit*0.04-pores*0.14;
out.color = vec3(0.914+trowel*0.05+sand*0.026+grit*0.016-pores*0.017);
out.normal = normal_from_height(h,height_m:0.007,tile_m:1.6,strength:0.9);
out.orm = orm(occlusion:1-pores*0.07,roughness:0.78+(sand-0.5)*0.02+pores*0.025,metallic:0);
#end

// imported_material_asset {"asset_id":"material_06ee19182e43cf59d494cbf0b6ccec0cbe25b6dac670655e42c7212a423074da","source_digest":"06ee19182e43cf59d494cbf0b6ccec0cbe25b6dac670655e42c7212a423074da","catalog_key":null,"local_root":"LibDarkMetal","local_digest":"b0df824a91cc6a86e437b94a092e275e8a228f572eba9255cc18be25c1f9c031"}
#texture LibDarkMetal
size = 256;
tile_m = 0.48;
let n = noise.value(uv*150,seed: 39,period: 150);
out.color = mix(color("#141A1D"),color("#292F31"),n*0.44);
out.normal = normal_from_height(n*0.009,strength: 0.18);
out.orm = orm(occlusion: 1,roughness: 0.56+n*0.18,metallic: 0);
#end

// imported_material_asset {"asset_id":"material_6712447fde12b38b73462bd641009d1b3e15638c301c0c595f5e1ba35a253284","source_digest":"6712447fde12b38b73462bd641009d1b3e15638c301c0c595f5e1ba35a253284","catalog_key":null,"local_root":"LibConcrete","local_digest":"6caffe06d73f56def660ce8e733ec85d1a7946ff4317dfc2ed277217513edcc3"}
#texture LibConcrete
size=1024;tile_m=2.7;mapping=triplanar_world;parallax_cm=0.65;
let a=noise.fbm(uv*9,octaves:4,seed:661,period:9);
let f=noise.fbm(uv*280,octaves:3,seed:352,period:280);
let aggregate=pattern.voronoi(uv*135,seed:911,period:135);
let pore=smoothstep(0.83,0.96,rand(aggregate.id))*smoothstep(0.16,0.3,aggregate.edge);
let h=a*0.13+f*0.15-pore*0.16+0.48;
out.color=mix(color("#535654"),color("#92918A"),a*0.6+f*0.15)-pore*0.06;
out.normal=normal_from_height(h,height_m:0.009,tile_m:2.7,strength:1);
out.orm=orm(occlusion:1-pore*0.14,roughness:0.83+f*0.15,metallic:0);out.height=h;
#end

// imported_material_asset {"asset_id":"material_fc9ae968fec2e0e56a4f7ab4764a640343c00db72323661e97987f6dfec27a5e","source_digest":"fc9ae968fec2e0e56a4f7ab4764a640343c00db72323661e97987f6dfec27a5e","catalog_key":null,"local_root":"LibPlazaTile","local_digest":"60ea20fd12c17f110ac21b89ee23cd99ecea18cd35e67342ebcb7b4030bec311"}
#texture LibPlazaTile
tile_m = 1.2;
wrap = repeat;
let g = noise.fbm(uv * 3.0, octaves: 2, seed: 3, period: 3);
let fx = fract(uv.x * 4.0);
let fy = fract(uv.y * 4.0);
let joint = step(0.96, max(fx, fy));
let base = ramp(g, [0.0: vec3(0.78, 0.72, 0.62), 1.0: vec3(0.86, 0.80, 0.70)]);
out.color = mix(base, vec3(0.45, 0.42, 0.38), joint);
out.normal = normal_from_height(1.0 - joint, strength: 0.3);
out.orm = orm(occlusion: 1.0 - joint * 0.3, roughness: 0.75, metallic: 0.0);
#end

#doc_version 3
// ===== ICONSIAM material palette (library textures only: derived tints of imported library #textures and engine built-ins) =====
material ICS_Gold { base = "lib1_NaturalBrush" tint = "#C9AE7C" roughness = 0.34 }
material ICS_GoldRoof { base = "lib1_NaturalBrush" tint = "#D2A54E" roughness = 0.4 }
material ICS_GoldPanel { base = "lib1_NaturalBrush" tint = "#B8975E" roughness = 0.5 }
material ICS_White { base = "LibPlaster" roughness = 0.62 }
material ICS_DarkMetal { base = "LibDarkMetal" metallic = 0.5 roughness = 0.45 }
material ICS_Concrete { base = "LibConcrete" }
material ICS_Paving { base = "LibPlazaTile" tileM = 2.4 }
material ICS_TowerGlass { base = "InteriorRooms" shader = "interior_window_pbr" tint = "#C9AE7C" glassTint = "#3E5566" roomH = 4.0 bayW = 1.5 }
material ICS_TowerGlass2 { base = "InteriorRooms" shader = "interior_window_pbr" tint = "#C9AE7C" glassTint = "#3A5260" roomH = 4.3 roomOffsetZ = 2.5 bayW = 1.5 }
material ICS_MallGlass { base = "InteriorOffice" shader = "interior_window_pbr" tint = "#C9AE7C" glassTint = "#4A5A58" roomH = 6.0 bayW = 2.0 }
material ICS_SolidGlass { base = "Glass" tint = "#8FA2B0" }
material ICS_Balustrade { base = "GlassTransparent" tint = "#5E9C98" }
// D9 (client): ground-floor shop / lobby glazing is ordinary interior-window glass like the upper floors (no emission);
// the warm dusk glow comes from real pointLights in world/10_lights.weave.
material ICS_ShopLit { base = "InteriorOffice" shader = "interior_window_pbr" tint = "#C9AE7C" glassTint = "#45585A" roomH = 6.5 bayW = 2.0 }
material ICS_WarmLight { base = "MetalDetail" tint = "#FFD08A" emission = 1.2 }
material ICS_Deck { base = "WoodDark" tileM = 2.0 }
material ICS_Foliage { base = "Foliage" lighting = "foliage" }
material ICS_Asphalt { base = "Asphalt" tileM = 3.0 }
material ICS_Water { base = "Water" }
material ICS_SignRed { base = "MetalDetail" tint = "#C8102E" emission = 0.8 }
material ICS_SignWhite { base = "MetalDetail" tint = "#FFF6E8" emission = 1.0 }

#meshdefs
