let BANK_LINE = [(12530, -16190, 0), (11530, -16120, 0), (11370, -13150, 0), (12290, -13080, 0), (12220, -11990, 0), (12180, -11470, 0), (12140, -10920, 0), (14800, -10800, 0), (14600, -7390, 0), (14660, -6780, 0), (14620, -3800, 0), (14480, -3510, 0), (14330, -1100, 0), (13680, 6980, 0), (13550, 8900, 0), (13350, 11620, 0), (13230, 13190, 0), (13310, 15670, 0), (13030, 18740, 0), (12980, 19140, 0), (12890, 19550, 0)];
let PIER_SMALL_FP = [(13370, 11360), (16380, 11620), (16260, 12980), (15940, 12950), (16030, 11940), (15160, 11860), (15070, 12850), (14730, 12820), (14820, 11750), (13350, 11620)];
