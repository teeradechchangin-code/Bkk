// River Park plaza (derived, 10,252 m2) and riverside fountain basin w1190311738
let PLAZA_FP = [(2000, 2470), (2000, 2140), (5610, 2200), (6330, 3400), (7580, 4470), (9150, 5080), (10980, 5100), (11150, 3170), (11010, 2290), (10710, 1420), (9870, 470), (9510, -250), (9360, -2480), (9750, -4700), (9410, -5550), (8910, -6140), (9200, -6600), (9970, -6540), (9980, -8380), (9320, -9360), (8570, -9730), (7460, -9820), (7180, -8670), (4870, -8690), (3780, -9100), (2890, -9800), (2000, -9840), (2000, -11790), (12180, -11470), (12140, -10920), (14800, -10800), (14600, -7390), (14660, -6780), (14620, -3800), (14480, -3510), (14330, -1100), (13550, 8900), (12040, 7230), (10540, 6290), (7050, 4390), (5440, 2670)];
let BASIN_FP = [(13410, 1510), (12950, 1330), (12510, 990), (12290, 170), (12270, -570), (12240, -1120), (12790, -2940), (13110, -3430), (13290, -4020), (13270, -4820), (13180, -5420), (12860, -5880), (12800, -6500), (12840, -7080), (12900, -7450), (13190, -8260), (13660, -8610), (13990, -8660), (13920, -7370), (13890, -5840), (13790, -3640), (13740, -2430), (13600, -830)];
