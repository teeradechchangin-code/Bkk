// ===== Context land beyond the ICS_Site box (Management D14, QC r3 refinements) =====
// Plain west-bank ground outside ICS_Site's +/-240 m sim_box, so the complex no longer reads as an island (D11).
// Engine limit: a static-collidable object is clamped to 500 m per axis, so the apron is tiled into axis-aligned cubes
// of at most 500 m. Tops sit at z = -3 (just under grade, never coplanar with the site slab), bottoms at the river bed.
// East edges step along the OSM west riverbank (riverbank_west_line, footprints_local_m.json); nothing east of the river.
object ICS_Ctx_W1 {
    model = "cube"
    bounds_min = (-60000, -50000, -600)
    bounds_max = (-24000, 0, -3)
    material = "ICS_Foliage"
}
