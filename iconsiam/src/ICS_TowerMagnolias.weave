// ICS_TowerMagnolias - Magnolias Waterfront Residences (south tower), South-tower crew. REWORK round 1.
// World cm, Z up, +X east, +Y north; authored in WORLD coordinates and placed at (0,0,0).
// Plan: shaft = MAG_FP inset 4.8 m (brief 4: 2-5 m; QC r1 major: keeps Photo A's sky gap to MO, gap/width ~0.31),
// gold fins 1 m proud of the facade line. Facade detail is built in a LOCAL frame aligned to the river-facing
// SE face of MAG_FP (vertex 6 -> 7): local X runs along that face (toward NE), local Y points into the
// building (NW). Both client photos look straight at this face.
// Massing (Photo A): south block (local X <= U1) to the 281 m roof; deep gold slot (sky-garden bridges)
// with the gold spine rising as the mast to 315 m + rod to 317.95 m; concave GoldPanel sail capping the slot
// (rounded cap beside the mast, concave sweep to the slot's east edge, short vertical edge); lower north
// block (roof 239.4 m) with a 3-tier stepped glass crown 253 / 249 / 245 m (Photo A steps), gold-coped tiers.
// Floor pitch 4.2 m = ICS_TowerGlass roomH (palette), anchored at the origin like the shader's room grid, so
// every gold slab band lands on the shader's spandrel line. LOGGED DEVIATION from MAG_FLOOR_H = 4.0 m pending
// Management: if the palette roomH becomes 4.0, set FH = MAG_FLOOR_H; every level below re-derives from FH.
// Heights marked INFERRED (Photo A calibrated) are offsets from MAG_ROOF, not in #meshdefs.
// LOD1 and the collider are both generated by #meshpart MAG_Massing (one source); its frame/clip/height lets
// MIRROR the LOD0 lets textually - edit both together.

#meshpart MAG_Massing
// lod = 1: LOD1 display massing; lod = 0: collider prisms. MIRRORED lets: keep identical to LOD0 below.
param lod = 1;
let FH = 420;
let ZP = MAG_PODIUM_TOP;
let S_PAR = MAG_ROOF + 400;
let S_PIL = MAG_ROOF + 650;
let CAP_HI = MAG_ROOF - 2800;        // INFERRED (Photo A calibrated)
let CAP_STEP = 400;                  // INFERRED (Photo A calibrated)
let TOP_1 = CAP_HI;
let TOP_2 = CAP_HI - CAP_STEP;
let TOP_3 = CAP_HI - 2 * CAP_STEP;
let SAIL_BOT = CAP_HI - 100;         // INFERRED (Photo A calibrated)
let SAIL_END = MAG_ROOF - 1300;      // INFERRED (Photo A calibrated)
let INSET = 480;
let PE = at(MAG_FP, 6);
let PF = at(MAG_FP, 7);
let TH = atan2(PF.y - PE.y, PF.x - PE.x);
let CT = cos(TH);
let ST = sin(TH);
let SH_W = offset_polygon(points: MAG_FP, delta: -INSET);
var SHL = [];
for p in SH_W { SHL = append(SHL, (p.x * CT + p.y * ST, p.y * CT - p.x * ST)); }
let NSH = len(SHL);
var WF = 1000000;
for p in SHL { WF = min(WF, p.y); }
var UF = -1000000;
for p in SHL { if p.y < WF + 50 { UF = max(UF, p.x); } }
let U2 = UF - 300;
let U1 = U2 - 950;
let WB = WF + 1000;
let X1 = UF;
let X2 = U2 + 650;
var S_F = [];
for i in 0..NSH {
    let p = at(SHL, i);
    let q = at(SHL, mod(i + 1, NSH));
    let sp = U1 - p.x;
    let sq = U1 - q.x;
    if sp >= 0 { S_F = append(S_F, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        S_F = append(S_F, (p.x + (q.x - p.x) * t, p.y + (q.y - p.y) * t));
    }
}
var R_F = [];
for i in 0..NSH {
    let p = at(SHL, i);
    let q = at(SHL, mod(i + 1, NSH));
    let sp = p.x - U1;
    let sq = q.x - U1;
    if sp >= 0 { R_F = append(R_F, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        let iy = p.y + (q.y - p.y) * t;
        if iy < WF + 50 {
            R_F = append(R_F, (U1, WB));
            R_F = append(R_F, (U2, WB));
            R_F = append(R_F, (U2, iy));
        } else {
            R_F = append(R_F, (U1, iy));
        }
    }
}
let NR = len(R_F);
var RC1 = [];
for i in 0..NR {
    let p = at(R_F, i);
    let q = at(R_F, mod(i + 1, NR));
    let sp = X1 - p.x;
    let sq = X1 - q.x;
    if sp >= 0 { RC1 = append(RC1, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        RC1 = append(RC1, (X1, p.y + (q.y - p.y) * t));
    }
}
var RC2 = [];
for i in 0..NR {
    let p = at(R_F, i);
    let q = at(R_F, mod(i + 1, NR));
    let sp = X2 - p.x;
    let sq = X2 - q.x;
    if sp >= 0 { RC2 = append(RC2, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        RC2 = append(RC2, (X2, p.y + (q.y - p.y) * t));
    }
}
let SY = WF - 60;
var g = empty();
if lod > 0.5 {
    // ---- LOD1: podium + south prism + stepped north prisms + slot back + spine/mast/rod + sail + roof lids ----
    let pod = extrude(points: MAG_FP, height: ZP + 45, material: "ICS_TowerGlass");
    let s_blk = translate(extrude(points: S_F, height: S_PAR + 40 - (ZP + 40), material: "ICS_TowerGlass"), (0, 0, ZP + 40));
    let r_a = translate(extrude(points: R_F, height: TOP_3 + 35 - (ZP + 40), material: "ICS_TowerGlass"), (0, 0, ZP + 40));
    let r_b = translate(extrude(points: RC2, height: CAP_STEP, material: "ICS_TowerGlass"), (0, 0, TOP_3 + 35));
    let r_c = translate(extrude(points: RC1, height: CAP_STEP, material: "ICS_TowerGlass"), (0, 0, TOP_2 + 35));
    let slot_b = box_bounds(min: (U1, WB - 30, ZP + 45), max: (U2, WB, SAIL_BOT + 20), material: "ICS_GoldPanel");
    let sail_curve = bezier_points(start: (U1 + 370, SY, S_PIL - 150), control1: (U1 + 420, SY, MAG_ROOF - 600), control2: (U2 - 200, SY, MAG_ROOF - 1200), end: (U2 + 30, SY, SAIL_END), count: 8);
    let sail = extrude_loop(points: concat_points([(U1 + 30, SY, SAIL_BOT), (U1 + 30, SY, S_PIL - 120), (U1 + 140, SY, S_PIL), (U1 + 320, SY, S_PIL - 60)], sail_curve, [(U2 + 30, SY, SAIL_BOT)]), offset: (0, WB - SY, 0), material: "ICS_GoldPanel");
    let spine = box_bounds(min: (U1 - 170, WF - 120, ZP + 45), max: (U1 + 170, WF + 300, MAG_ROOF), material: "ICS_Gold");
    let mast = hull(box_bounds(min: (U1 - 170, WF - 120, MAG_ROOF), max: (U1 + 170, WF + 300, MAG_ROOF + 10)), box_bounds(min: (U1 - 130, WF - 60, MAG_ARCH_TOP - 10), max: (U1 + 130, WF + 240, MAG_ARCH_TOP)), material: "ICS_Gold");
    let rod = box_bounds(min: (U1 - 22, WF + 98, MAG_ARCH_TOP - 20), max: (U1 + 22, WF + 142, MAG_TIP), material: "ICS_Gold");
    let lids = merge(translate(extrude(points: offset_polygon(points: S_F, delta: -30), height: 20, material: "ICS_Paving"), (0, 0, S_PAR + 30)), translate(extrude(points: offset_polygon(points: R_F, delta: -30), height: 20, material: "ICS_Paving"), (0, 0, TOP_3 + 30)), translate(extrude(points: offset_polygon(points: RC2, delta: -30), height: 20, material: "ICS_Paving"), (0, 0, TOP_2 + 30)), translate(extrude(points: offset_polygon(points: RC1, delta: -30), height: 20, material: "ICS_Paving"), (0, 0, TOP_1 + 30)));
    g = merge(pod, rotate_z(merge(s_blk, r_a, r_b, r_c, slot_b, sail, spine, mast, rod, lids), degrees: TH, pivot: (0, 0, 0)));
} else {
    // ---- collider: walkable arcade at grade, podium to the deck top, south prism to the roof deck,
    // north prisms stepped to each crown tier's roof (no invisible slab above the north block) ----
    let c_gnd = extrude(points: offset_polygon(points: MAG_FP, delta: -260), height: 650);
    let c_pod = translate(extrude(points: MAG_FP, height: ZP + 45 - 650), (0, 0, 650));
    let c_s = translate(extrude(points: S_F, height: MAG_ROOF + 40 - (ZP + 45)), (0, 0, ZP + 45));
    let c_ra = translate(extrude(points: R_F, height: TOP_3 + 15 - (ZP + 45)), (0, 0, ZP + 45));
    let c_rb = translate(extrude(points: RC2, height: CAP_STEP), (0, 0, TOP_3 + 15));
    let c_rc = translate(extrude(points: RC1, height: CAP_STEP), (0, 0, TOP_2 + 15));
    g = merge(c_gnd, c_pod, rotate_z(merge(c_s, c_ra, c_rb, c_rc), degrees: TH, pivot: (0, 0, 0)));
}
out.geo = g;
#end

#mesh ICS_TowerMagnolias
budget(verts: 250000, indices: 750000);
sim_box(min: (-24000, -24000, 0), max: (24000, 24000, 32000));
anchor(mode: "origin");

// ---------- shared numbers (MIRRORED in #meshpart MAG_Massing: keep textually identical) ----------
let FH = 420;                        // floor pitch = ICS_TowerGlass roomH 4.2 m (logged deviation, see header)
let ZP = MAG_PODIUM_TOP;             // 2700
let S_PAR = MAG_ROOF + 400;          // south parapet top 285.0 m
let S_PIL = MAG_ROOF + 650;          // south pilaster tips = sail cap 287.5 m
let CAP_HI = MAG_ROOF - 2800;        // INFERRED (Photo A calibrated): north crown top at the slot edge 253.0 m
let CAP_STEP = 400;                  // INFERRED (Photo A calibrated): crown steps ~4 m per tier toward the NE
let TOP_1 = CAP_HI;                  // tier 1 (slot side)      253.0 m
let TOP_2 = CAP_HI - CAP_STEP;       // tier 2                  249.0 m
let TOP_3 = CAP_HI - 2 * CAP_STEP;   // tier 3 (NE silhouette)  245.0 m
let SAIL_BOT = CAP_HI - 100;         // INFERRED (Photo A calibrated): sail underside 252.0 m, slot open below
let SAIL_END = MAG_ROOF - 1300;      // INFERRED (Photo A calibrated): concave sweep meets the slot east edge 268.0 m
let INSET = 480;                     // shaft facade line = MAG_FP inset 4.8 m
// ---------- LOD0-only numbers ----------
let K0 = ceil((ZP + 200) / FH);      // first tower slab band (7 -> 29.4 m)
let KS = floor((MAG_ROOF - 300) / FH);  // last south slab band (66 -> 277.2 m)
let KN = floor((TOP_3 - 400) / FH);  // last north slab band (57 -> 239.4 m): crown screen >= 4 m on the low tier
let ZRN = KN * FH;                   // north block roof = crown screen base 239.4 m
let BAL = 160;                       // recessed balcony depth (facade line -> glass line)

// ---------- local frame from MAG_FP SE face (MIRRORED) ----------
let PE = at(MAG_FP, 6);
let PF = at(MAG_FP, 7);
let TH = atan2(PF.y - PE.y, PF.x - PE.x);
let CT = cos(TH);
let ST = sin(TH);
let SH_W = offset_polygon(points: MAG_FP, delta: -INSET);
var SHL = [];
for p in SH_W { SHL = append(SHL, (p.x * CT + p.y * ST, p.y * CT - p.x * ST)); }
let NSH = len(SHL);
var WF = 1000000;
for p in SHL { WF = min(WF, p.y); }
var UF = -1000000;
for p in SHL { if p.y < WF + 50 { UF = max(UF, p.x); } }
let U2 = UF - 300;                   // slot east wall (3 m corner strip beyond)
let U1 = U2 - 950;                   // slot west wall = gold spine / mast line
let WB = WF + 1000;                  // slot back wall (10 m deep)
let X1 = UF;                         // crown tier 1 | tier 2 at the SE-E corner (Photo A step positions)
let X2 = U2 + 650;                   // crown tier 2 | tier 3
// glass line (LOD0 only): MAG_FP minus its two tiny chamfer vertices (both adjacent edges < 3 m), which
// would invert at a 6.4 m inset; the facade line keeps the full outline
let NFP = len(MAG_FP);
var FP_G = [];
for i in 0..NFP {
    let a = at(MAG_FP, mod(i + NFP - 1, NFP));
    let b = at(MAG_FP, i);
    let c = at(MAG_FP, mod(i + 1, NFP));
    let la = sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y));
    let lc = sqrt((c.x - b.x) * (c.x - b.x) + (c.y - b.y) * (c.y - b.y));
    if (la < 300) * (lc < 300) < 0.5 { FP_G = append(FP_G, b); }
}
let GP_W = offset_polygon(points: FP_G, delta: -INSET - BAL);
var GPL = [];
for p in GP_W { GPL = append(GPL, (p.x * CT + p.y * ST, p.y * CT - p.x * ST)); }
let NGP = len(GPL);
var WFG = 1000000;
for p in GPL { WFG = min(WFG, p.y); }

// ---------- clip: south block S (X <= U1), remainder R (X >= U1) with the slot notch (MIRRORED) ----------
var S_F = [];
for i in 0..NSH {
    let p = at(SHL, i);
    let q = at(SHL, mod(i + 1, NSH));
    let sp = U1 - p.x;
    let sq = U1 - q.x;
    if sp >= 0 { S_F = append(S_F, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        S_F = append(S_F, (p.x + (q.x - p.x) * t, p.y + (q.y - p.y) * t));
    }
}
var R_F = [];
for i in 0..NSH {
    let p = at(SHL, i);
    let q = at(SHL, mod(i + 1, NSH));
    let sp = p.x - U1;
    let sq = q.x - U1;
    if sp >= 0 { R_F = append(R_F, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        let iy = p.y + (q.y - p.y) * t;
        if iy < WF + 50 {
            R_F = append(R_F, (U1, WB));
            R_F = append(R_F, (U2, WB));
            R_F = append(R_F, (U2, iy));
        } else {
            R_F = append(R_F, (U1, iy));
        }
    }
}
let NR = len(R_F);
// crown tiers: RC1 = R x <= X1 (tier 1), RC2 = R x <= X2 (tiers 1+2) (MIRRORED); T2, T3 = single tiers (LOD0 only)
var RC1 = [];
for i in 0..NR {
    let p = at(R_F, i);
    let q = at(R_F, mod(i + 1, NR));
    let sp = X1 - p.x;
    let sq = X1 - q.x;
    if sp >= 0 { RC1 = append(RC1, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        RC1 = append(RC1, (X1, p.y + (q.y - p.y) * t));
    }
}
var RC2 = [];
for i in 0..NR {
    let p = at(R_F, i);
    let q = at(R_F, mod(i + 1, NR));
    let sp = X2 - p.x;
    let sq = X2 - q.x;
    if sp >= 0 { RC2 = append(RC2, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        RC2 = append(RC2, (X2, p.y + (q.y - p.y) * t));
    }
}
let NC2 = len(RC2);
var T2 = [];
for i in 0..NC2 {
    let p = at(RC2, i);
    let q = at(RC2, mod(i + 1, NC2));
    let sp = p.x - X1;
    let sq = q.x - X1;
    if sp >= 0 { T2 = append(T2, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        T2 = append(T2, (X1, p.y + (q.y - p.y) * t));
    }
}
var T3 = [];
for i in 0..NR {
    let p = at(R_F, i);
    let q = at(R_F, mod(i + 1, NR));
    let sp = p.x - X2;
    let sq = q.x - X2;
    if sp >= 0 { T3 = append(T3, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        T3 = append(T3, (X2, p.y + (q.y - p.y) * t));
    }
}
// whole facade outline with the slot notch, for seam-free slab rings where both blocks exist (k <= KN)
var F_ALL = [];
for i in 0..NSH {
    let p = at(SHL, i);
    let q = at(SHL, mod(i + 1, NSH));
    F_ALL = append(F_ALL, p);
    let sp = p.x - U1;
    let sq = q.x - U1;
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        let iy = p.y + (q.y - p.y) * t;
        if iy < WF + 50 {
            F_ALL = append(F_ALL, (U1, iy));
            F_ALL = append(F_ALL, (U1, WB));
            F_ALL = append(F_ALL, (U2, WB));
            F_ALL = append(F_ALL, (U2, iy));
        }
    }
}
// glass-line versions of S and R
var S_G = [];
for i in 0..NGP {
    let p = at(GPL, i);
    let q = at(GPL, mod(i + 1, NGP));
    let sp = U1 - p.x;
    let sq = U1 - q.x;
    if sp >= 0 { S_G = append(S_G, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        S_G = append(S_G, (p.x + (q.x - p.x) * t, p.y + (q.y - p.y) * t));
    }
}
var R_G = [];
for i in 0..NGP {
    let p = at(GPL, i);
    let q = at(GPL, mod(i + 1, NGP));
    let sp = p.x - U1;
    let sq = q.x - U1;
    if sp >= 0 { R_G = append(R_G, p); }
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        let iy = p.y + (q.y - p.y) * t;
        if iy < WFG + 50 {
            R_G = append(R_G, (U1, WB));
            R_G = append(R_G, (U2, WB));
            R_G = append(R_G, (U2, iy));
        } else {
            R_G = append(R_G, (U1, iy));
        }
    }
}
// glass-line outline with the slot notch (inner edge of the k <= KN slab rings)
var G_ALL = [];
for i in 0..NGP {
    let p = at(GPL, i);
    let q = at(GPL, mod(i + 1, NGP));
    G_ALL = append(G_ALL, p);
    let sp = p.x - U1;
    let sq = q.x - U1;
    if sp * sq < 0 {
        let t = sp / (sp - sq);
        let iy = p.y + (q.y - p.y) * t;
        if iy < WFG + 50 {
            G_ALL = append(G_ALL, (U1, iy));
            G_ALL = append(G_ALL, (U1, WB));
            G_ALL = append(G_ALL, (U2, WB));
            G_ALL = append(G_ALL, (U2, iy));
        }
    }
}
let NS = len(S_F);

// ---------- glass cores (glass line, balconies recess to it) ----------
let core_s = translate(extrude(points: S_G, height: MAG_ROOF - (ZP + 5), material: "ICS_TowerGlass"), (0, 0, ZP + 5));
let core_r = translate(extrude(points: R_G, height: ZRN - (ZP + 5), material: "ICS_TowerGlass"), (0, 0, ZP + 5));

// ---------- slab bands = balcony slabs (gold edge), one per floor on the 4.2 m grid ----------
// k = K0..KN: ONE ring around the whole notched outline (no S/R seam); k = KN+1..KS: south block only.
// slab = facade line + 15 cm back to 10 cm inside the glass line
let ring_all = extrude_shape(outer: offset_polygon(points: F_ALL, delta: 15), holes: [offset_polygon(points: G_ALL, delta: -10)], height: 45, material: "ICS_GoldPanel");
let ring_s = extrude_shape(outer: offset_polygon(points: S_F, delta: 15), holes: [offset_polygon(points: S_G, delta: -10)], height: 45, material: "ICS_GoldPanel");
let bands = merge(array(translate(ring_all, (0, 0, K0 * FH - 50)), count: KN - K0 + 1, offset: (0, 0, FH)), array(translate(ring_s, (0, 0, (KN + 1) * FH - 50)), count: KS - KN, offset: (0, 0, FH)));

// ---------- facade edges: kind 0 = south full, 1 = south pilasters only (U1 face above the north crown),
// 2 = skip (internal seam / slot walls), 3 = north full (stepped crown) ----------
var EA = [];
var EB = [];
var EK = [];
for i in 0..NS {
    let p = at(S_F, i);
    let q = at(S_F, mod(i + 1, NS));
    let onu1 = (abs(p.x - U1) < 2) * (abs(q.x - U1) < 2);
    EA = append(EA, (p.x, p.y, select(ZP + 40, ZRN, onu1)));
    EB = append(EB, (q.x, q.y, MAG_ROOF));
    EK = append(EK, onu1 * 2 + mod(i, 2));
}
for i in 0..NR {
    let p = at(R_F, i);
    let q = at(R_F, mod(i + 1, NR));
    let onu1 = (abs(p.x - U1) < 2) * (abs(q.x - U1) < 2);
    let onwb = (abs(p.y - WB) < 2) * (abs(q.y - WB) < 2);
    let onu2 = (abs(p.x - U2) < 2) * (abs(q.x - U2) < 2);
    let skip = (onu1 + onwb + onu2) > 0.5;
    EA = append(EA, (p.x, p.y, ZP + 40));
    EB = append(EB, (q.x, q.y, ZRN));
    EK = append(EK, select(3, 2, skip) * 2 + mod(i, 2));
}
let NE = len(EK);

var PIL = [];
var PAN = [];
var BALC = [];
for e in 0..NE {
    let a = at(EA, e);
    let b = at(EB, e);
    let code = at(EK, e);
    let kind = floor(code / 2);
    let par = mod(code, 2);
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let L = sqrt(dx * dx + dy * dy);
    // every edge longer than 30 cm keeps the facade line (short chamfers get a glass panel only)
    if (kind != 2) * (L > 30) {
        let ux = dx / L;
        let uy = dy / L;
        let nx = uy;
        let ny = 0 - ux;
        let longe = L > 250;
        let nb = max(1, round(L / 850));
        let bw = L / nb;
        let nfl = select(KS - K0 + 1, KN - K0, kind > 2.5);
        for j in 0..nb {
            // pilaster (gold frame) at the bay start: 1 m proud, back to the glass line
            let px = a.x + ux * j * bw - nx * 45;
            let py = a.y + uy * j * bw - ny * 45;
            let tier = (px > X1) + (px > X2);
            let ztop = select(S_PIL, CAP_HI - tier * CAP_STEP + 60, kind > 2.5);
            let inslot = (kind > 0.5) * (kind < 1.5) * (py < WB + 100);
            if ((kind < 0.5) + (kind > 2.5) + (j > 0)) * longe * (1 - inslot) > 0.5 {
                PIL = append(PIL, beam_between(start: (px, py, a.z), end: (px, py, ztop), cross_width: 100, cross_height: 290, height_direction: (nx, ny, 0), material: "ICS_Gold"));
            }
            if kind != 1 {
                let mx = a.x + ux * (j + 0.5) * bw;
                let my = a.y + uy * (j + 0.5) * bw;
                let balc = (mod(j + par, 2) > 0.5) * (bw > 400);
                if balc {
                    let ax = a.x + ux * (j * bw + 55);
                    let ay = a.y + uy * (j * bw + 55);
                    let bx = a.x + ux * ((j + 1) * bw - 55);
                    let by = a.y + uy * ((j + 1) * bw - 55);
                    let zf = K0 * FH - 5;
                    // solid chamfered GoldPanel upstand (Photo A: thick pale-gold balcony edges, horizontal ribbing);
                    // 1 bevel segment keeps ~660 upstands inside the LOD0 vertex target
                    let upst = beam_between(start: (mx - nx * 16, my - ny * 16, zf - 3), end: (mx - nx * 16, my - ny * 16, zf + 100), cross_width: bw - 110, cross_height: 25, height_direction: (nx, ny, 0), bevel: 10, bevel_segments: 1, material: "ICS_GoldPanel");
                    let lamp = beam_between(start: (ax - nx * 45, ay - ny * 45, zf - 49), end: (bx - nx * 45, by - ny * 45, zf - 49), cross_width: 24, cross_height: 8, height_direction: (0, 0, 1), material: "ICS_WarmLight");
                    BALC = append(BALC, array(merge(upst, lamp), count: nfl, offset: (0, 0, FH)));
                } else {
                    PAN = append(PAN, beam_between(start: (mx - nx * 15, my - ny * 15, a.z + 5), end: (mx - nx * 15, my - ny * 15, b.z - 15), cross_width: bw - select(100, 10, L <= 250), cross_height: 30, height_direction: (nx, ny, 0), material: "ICS_TowerGlass"));
                }
            }
        }
    }
}

// ---------- south crown: glass parapet screen, gold coping, roof deck, plant room ----------
let s_par = translate(extrude_shape(outer: S_F, holes: [offset_polygon(points: S_F, delta: -30)], height: S_PAR - MAG_ROOF, material: "ICS_TowerGlass"), (0, 0, MAG_ROOF));
let s_cop = translate(extrude_shape(outer: offset_polygon(points: S_F, delta: 25), holes: [offset_polygon(points: S_F, delta: -55)], height: 40, material: "ICS_GoldPanel"), (0, 0, S_PAR));
let s_roof = translate(extrude(points: offset_polygon(points: S_F, delta: -25), height: 50, material: "ICS_Paving"), (0, 0, MAG_ROOF - 10));
let s_plant = box_bounds(min: (U1 - 1500, WF + 700, MAG_ROOF + 30), max: (U1 - 300, WF + 2200, MAG_ROOF + 550), material: "ICS_GoldPanel");
let s_bmu = merge(box_bounds(min: (U1 - 1150, WF + 1100, MAG_ROOF + 545), max: (U1 - 650, WF + 1800, MAG_ROOF + 800), material: "ICS_DarkMetal"), beam_between(start: (U1 - 900, WF + 1450, MAG_ROOF + 780), end: (U1 - 900, WF + 450, MAG_ROOF + 780), cross_width: 45, cross_height: 70, height_direction: (0, 0, 1), material: "ICS_DarkMetal"));

// ---------- north crown: 3 stepped glass tiers (stacked, no overlaps), gold coping per tier, paved roofs + plant/BMU ----------
let cr_a = translate(extrude(points: R_F, height: TOP_3 - (ZRN - 10), material: "ICS_TowerGlass"), (0, 0, ZRN - 10));
let cr_b = translate(extrude(points: RC2, height: TOP_2 - TOP_3, material: "ICS_TowerGlass"), (0, 0, TOP_3));
let cr_c = translate(extrude(points: RC1, height: TOP_1 - TOP_2, material: "ICS_TowerGlass"), (0, 0, TOP_2));
let r_cop = merge(translate(extrude_shape(outer: offset_polygon(points: RC1, delta: 25), holes: [offset_polygon(points: RC1, delta: -60)], height: 45, material: "ICS_GoldPanel"), (0, 0, TOP_1 - 10)), translate(extrude_shape(outer: offset_polygon(points: T2, delta: 25), holes: [offset_polygon(points: T2, delta: -60)], height: 45, material: "ICS_GoldPanel"), (0, 0, TOP_2 - 10)), translate(extrude_shape(outer: offset_polygon(points: T3, delta: 25), holes: [offset_polygon(points: T3, delta: -60)], height: 45, material: "ICS_GoldPanel"), (0, 0, TOP_3 - 10)));
let r_roof = merge(translate(extrude(points: offset_polygon(points: RC1, delta: -60), height: 20, material: "ICS_Paving"), (0, 0, TOP_1 - 5)), translate(extrude(points: offset_polygon(points: T2, delta: -60), height: 20, material: "ICS_Paving"), (0, 0, TOP_2 - 5)), translate(extrude(points: offset_polygon(points: T3, delta: -60), height: 20, material: "ICS_Paving"), (0, 0, TOP_3 - 5)));
let r_plant = merge(box_bounds(min: (U1 + 150, WB + 1200, TOP_1 + 10), max: (U1 + 750, WB + 2800, TOP_1 + 420), material: "ICS_GoldPanel"), box_bounds(min: (X1 + 90, WB + 1600, TOP_2 + 10), max: (X2 - 90, WB + 3200, TOP_2 + 260), material: "ICS_GoldPanel"), box_bounds(min: (X2 + 110, WB + 600, TOP_3 + 10), max: (X2 + 280, WB + 1900, TOP_3 + 230), material: "ICS_GoldPanel"));
let r_bmu = merge(box_bounds(min: (U1 + 300, WB + 3300, TOP_1 + 10), max: (U1 + 900, WB + 3900, TOP_1 + 260), material: "ICS_DarkMetal"), beam_between(start: (U1 + 600, WB + 3600, TOP_1 + 245), end: (U1 + 600, WB + 600, TOP_1 + 245), cross_width: 40, cross_height: 60, height_direction: (0, 0, 1), material: "ICS_DarkMetal"));

// ---------- gold slot: cladding to the sail underside, punched windows, sky-garden bridges ----------
let slot_l = box_bounds(min: (U1 - 40, WF, ZP), max: (U1 + 30, WB + 40, SAIL_BOT + 20), material: "ICS_GoldPanel");
let slot_b = box_bounds(min: (U1 - 40, WB - 30, ZP), max: (U2 + 40, WB + 40, SAIL_BOT + 20), material: "ICS_GoldPanel");
let slot_r = box_bounds(min: (U2 - 30, WF + 2, ZP), max: (U2 + 40, WB + 40, SAIL_BOT + 20), material: "ICS_GoldPanel");
let slot_top = box_bounds(min: (U1 + 30, WF - 50, SAIL_BOT - 50), max: (U2 - 30, WB - 30, SAIL_BOT + 10), material: "ICS_GoldPanel");
var BRK = [];
for i in 0..6 { BRK = append(BRK, round((5880 + 3360 * i) / FH)); }
BRK = append(BRK, KN);               // 14, 22, 30, 38, 46, 54 and 57 (239.4 m) at FH = 420
let KW = floor((SAIL_BOT - 330) / FH) + 1;
var SWIN = [];
for k in K0..KW {
    var isb = 0;
    for bk in BRK { isb = isb + (k == bk); }
    if isb < 0.5 {
        for c in 0..3 {
            let cx = U1 + 950 * (0.2 + 0.3 * c);
            SWIN = append(SWIN, box_bounds(min: (cx - 85, WB - 38, k * FH + 70), max: (cx + 85, WB - 26, k * FH + 310), material: pick(hash(k * 3 + c, seed: 7) > 0.7, "ICS_DarkMetal", "ICS_ShopLit")));
        }
    }
}
var BRG = [];
for k in BRK {
    let z = k * FH;
    BRG = append(BRG, box_bounds(min: (U1 + 20, WF - 25, z - 50), max: (U2 - 20, WB - 20, z + 10), material: "ICS_GoldPanel"));
    BRG = append(BRG, box_bounds(min: (U1 + 170, WF - 15, z + 8), max: (U2 - 50, WF - 11, z + 118), material: "ICS_Balustrade"));
    BRG = append(BRG, box_bounds(min: (U1 + 170, WF - 18, z + 118), max: (U2 - 50, WF - 8, z + 126), material: "ICS_Gold"));
    BRG = append(BRG, box_bounds(min: (U1 + 170, WF + 10, z - 58), max: (U2 - 50, WF + 50, z - 48), material: "ICS_WarmLight"));
    BRG = append(BRG, box_bounds(min: (U1 + 250, WB - 170, z + 8), max: (U2 - 250, WB - 28, z + 90), material: "ICS_Foliage"));
    BRG = append(BRG, sphere_center(radius: 150, segments: 10, center: (U1 + 340, WB - 110, z + 210), material: "ICS_Foliage"));
    BRG = append(BRG, sphere_center(radius: 130, segments: 10, center: (U2 - 330, WB - 120, z + 190), material: "ICS_Foliage"));
}

// ---------- gold spine -> mast -> rod, and the concave sail capping the slot (Photo A) ----------
// spine/mast ends are offset from the glass core (ZP + 5 .. MAG_ROOF) and the parapet underside (MAG_ROOF):
// no flush same-facing faces; the mast base is buried 15 cm in the spine and inset 5 cm from its sides
let spine = box_bounds(min: (U1 - 170, WF - 120, ZP + 20), max: (U1 + 170, WF + 300, MAG_ROOF - 5), material: "ICS_Gold");
let mast = hull(box_bounds(min: (U1 - 165, WF - 115, MAG_ROOF - 20), max: (U1 + 165, WF + 295, MAG_ROOF - 10)), box_bounds(min: (U1 - 130, WF - 60, MAG_ARCH_TOP - 10), max: (U1 + 130, WF + 240, MAG_ARCH_TOP)), material: "ICS_Gold");
let rod = cylinder_at(radius: 22, height: MAG_TIP - MAG_ARCH_TOP + 20, bottom_center: (U1, WF + 120, MAG_ARCH_TOP - 20), segments: 10, material: "ICS_DarkMetal");
let SY = WF - 60;
// rounded ~3 m cap beside the mast, then a CONCAVE sweep (steep, then flaring out) to the slot's east edge,
// then a short vertical edge down to the sail underside; solid back to the slot back wall (no pocket)
let sail_curve = bezier_points(start: (U1 + 370, SY, S_PIL - 150), control1: (U1 + 420, SY, MAG_ROOF - 600), control2: (U2 - 200, SY, MAG_ROOF - 1200), end: (U2 + 30, SY, SAIL_END), count: 14);
let sail = extrude_loop(points: concat_points([(U1 + 30, SY, SAIL_BOT), (U1 + 30, SY, S_PIL - 120), (U1 + 60, SY, S_PIL - 40), (U1 + 140, SY, S_PIL), (U1 + 240, SY, S_PIL - 10), (U1 + 320, SY, S_PIL - 60)], sail_curve, [(U2 + 30, SY, SAIL_BOT)]), offset: (0, WB - SY, 0), material: "ICS_GoldPanel");

let tower_local = merge(core_s, bands, PIL, s_roof, BALC, core_r, PAN, cr_a, cr_b, cr_c, r_cop, r_roof, r_plant, r_bmu, s_par, s_cop, s_plant, s_bmu, slot_l, slot_b, slot_r, slot_top, SWIN, BRG, spine, mast, rod, sail);
let tower = rotate_z(tower_local, degrees: TH, pivot: (0, 0, 0));

// ---------- SE pool terrace on the podium roof (Photo B: curved pool at the tower's SE foot, rounded edge to the river) ----------
// local frame: straight run along the SE face, quarter-round around the E corner F' = (UF, WF), short run up the E face
let AE = atan2(at(MAG_FP, 8).y - PF.y, at(MAG_FP, 8).x - PF.x) - TH;   // E face direction in the local frame
let P_IN = 170;                      // pool inner edge from the facade line (0.7 m clear of the 1 m fins)
let P_OUT = INSET - 125;             // pool outer edge (1.25 m inside MAG_FP, clear of the planter ring)
let P_RC = (P_OUT - P_IN) / 2;
let P_X0 = UF - 2000;                // west end of the straight run
let P_LE = 900;                      // run up the E face
var POOL_L = [];
for i in 0..9 {
    let ang = 90 + 22.5 * i;
    POOL_L = append(POOL_L, (P_X0 + P_RC * cos(ang), WF - P_IN - P_RC + P_RC * sin(ang)));
}
for i in 0..9 {
    let ang = -90 + AE * i / 8;
    POOL_L = append(POOL_L, (UF + P_OUT * cos(ang), WF + P_OUT * sin(ang)));
}
for i in 0..9 {
    let ang = AE - 90 + 22.5 * i;
    POOL_L = append(POOL_L, (UF + (P_IN + P_RC) * cos(AE - 90) + P_LE * cos(AE) + P_RC * cos(ang), WF + (P_IN + P_RC) * sin(AE - 90) + P_LE * sin(AE) + P_RC * sin(ang)));
}
for i in 0..9 {
    let ang = AE - 90 - AE * i / 8;
    POOL_L = append(POOL_L, (UF + P_IN * cos(ang), WF + P_IN * sin(ang)));
}
var POOL_W = [];
for p in POOL_L { POOL_W = append(POOL_W, (p.x * CT - p.y * ST, p.x * ST + p.y * CT)); }
let pool_water = translate(extrude(points: POOL_W, height: 25, material: "ICS_Water"), (0, 0, ZP + 5));
let pool_floor = translate(extrude(points: POOL_W, height: 10, material: "ICS_Paving"), (0, 0, ZP - 5));
let pool_cop = translate(extrude_shape(outer: offset_polygon(points: POOL_W, delta: 25), holes: [offset_polygon(points: POOL_W, delta: -3)], height: 20, material: "ICS_GoldPanel"), (0, 0, ZP + 40));

// ---------- podium on the full MAG_FP outline (world coords) ----------
let pod_glass = translate(extrude(points: offset_polygon(points: MAG_FP, delta: -80), height: ZP - 640, material: "ICS_TowerGlass"), (0, 0, 640));
let lobby = extrude(points: offset_polygon(points: MAG_FP, delta: -260), height: 650, material: "ICS_ShopLit");
let canopy = translate(extrude_shape(outer: offset_polygon(points: MAG_FP, delta: 100), holes: [offset_polygon(points: MAG_FP, delta: -270)], height: 60, material: "ICS_Gold"), (0, 0, 600));
let pod_band = translate(extrude_shape(outer: offset_polygon(points: MAG_FP, delta: 20), holes: [offset_polygon(points: MAG_FP, delta: -100)], height: 45, material: "ICS_GoldPanel"), (0, 0, 1155));
let pod_bands = array(pod_band, count: 3, offset: (0, 0, 600));
let cornice = translate(extrude_shape(outer: offset_polygon(points: MAG_FP, delta: 60), holes: [offset_polygon(points: MAG_FP, delta: -100)], height: 180, material: "ICS_GoldPanel"), (0, 0, ZP - 120));
let deck = translate(extrude_shape(outer: offset_polygon(points: MAG_FP, delta: -60), holes: [POOL_W], height: 55, material: "ICS_Paving"), (0, 0, ZP - 10));
let rail_ring = translate(extrude_shape(outer: offset_polygon(points: MAG_FP, delta: -25), holes: [offset_polygon(points: MAG_FP, delta: -31)], height: 115, material: "ICS_Balustrade"), (0, 0, ZP + 55));
let planter = translate(extrude_shape(outer: offset_polygon(points: MAG_FP, delta: -40), holes: [offset_polygon(points: MAG_FP, delta: -95)], height: 90, material: "ICS_Foliage"), (0, 0, ZP + 40));
let NP = len(MAG_FP);
var PPIL = [];
for i in 0..NP {
    let a = at(MAG_FP, i);
    let b = at(MAG_FP, mod(i + 1, NP));
    let dx = b.x - a.x;
    let dy = b.y - a.y;
    let L = sqrt(dx * dx + dy * dy);
    if L > 400 {
        let ux = dx / L;
        let uy = dy / L;
        let nb = max(1, round(L / 850));
        let bw = L / nb;
        for j in 0..nb {
            let px = a.x + ux * j * bw - uy * 30;
            let py = a.y + uy * j * bw + ux * 30;
            // tops buried 20 cm inside the cornice (no coplanar cap on the cornice top at ZP + 60)
            PPIL = append(PPIL, beam_between(start: (px, py, 0), end: (px, py, ZP + 40), cross_width: 80, cross_height: 120, height_direction: (uy, 0 - ux, 0), material: "ICS_Gold"));
        }
    }
}
let podium = merge(pod_glass, lobby, canopy, pod_bands, cornice, deck, rail_ring, planter, PPIL, pool_floor, pool_cop, pool_water);

out.geo = merge(tower, podium);
#end

#mesh ICS_TowerMagnolias lod: 1
out.geo = part(MAG_Massing, lod: 1);
#end

#mesh ICS_TowerMagnolias collider
out.geo = part(MAG_Massing, lod: 0);
#end
