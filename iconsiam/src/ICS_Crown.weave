// ICS_Crown - gold "krathong" crown on the Z4 roof (CROWN_BASE 58 m -> CROWN_TOP 75 m)      [scene QC rework round 1]
// Crown crew. World cm, Z up, authored in WORLD coordinates (object placed at 0,0,0).
// Parts (top-level bindings in every #mesh, so parts_log reports each one):
//   CROWN_Rim    gold rim band (ICS_Gold, scene QC: GoldRoof read dark bronze at dusk) ending in a short 2 m beak under
//                an upturned point at the prow, champagne coping, a warm line just under the coping and a warm cove
//                (1.1-1.4 m) along the WHOLE sloped soffit (ICS_WarmLight strips/coves only, D9)
//   CROWN_Drum   drum glazing (ICS_ShopLit at LOD0 and LOD1) behind white fins (30 x 120 cm @ 88 cm, every 6th a
//                45 x 170 cm primary fin), white kerb, white canopy skirt (3 m wide, 60.0-61.0 m) round the drum base
//   CROWN_Gable  Wisdom Hall bow on the river face: white stem post, right-triangle glass (ICS_SolidGlass, DarkMetal
//                cable net, WarmLight floor lines + vertical strips) raised to a 56 m sill, broad white raking prow
//                blade (8.5 m along the facade, ICS_White with 5 diagonal DarkMetal mullions) raking back to the rim
//                soffit, then lit raked glazing (ICS_ShopLit + DarkMetal mullions) back to the drum on the south flank
//   CROWN_Canopy cream (ICS_White) canopy deck + 3 stepped tiers on gold (ICS_Gold) fascias = three gold rings, a warm
//                strip under each ring lip
// Scene QC r1 (QCA/QCB majors, D4): the rim is lifted so the drum + rim wall stands ~16 m on the 58 m roof all round:
// rim top 73.8 m at the stern (CROWN_TOP - 1.2 m), rising 0.2 m to the bow root, then flicking up 1.0 m over the last
// 9 m to the upturned point at CROWN_TOP 75.0 m. Flank band 2.8 m (stern) -> 3.1 m (bow root), was 3.5-4.0 m, so the
// soffit sits at 71.0 m (was 66.0 m) and the finned drum stands 13 m on the roof. Everything stays <= CROWN_TOP; the
// sheer is derived from CROWN_TOP, so a Management allowance (QC-B asks ~78 m) only needs the #meshdefs value.
// Calibration vs Photos A/B: boat-shaped oval, long axis on the site grid (SITE_ROT_DEG), stern semi-axis 42.4 m,
// prow semi-axis DERIVED from Z4_FP (river face edge 1->2).
// Bow zone (Management allowance, rev C): every crown surface on the river face stays within CR_UF+40 .. CR_UF+100 east
// of the Z4 river face. Below the Z4 roof nothing of the crown lies inside Z4_FP except the usual 10-15 cm embedment
// of the drum foot, kerb, fins and glazing foot in the roof deck; the blade and the lit glazing stay >= 30 cm clear of
// MallMain's coping (57.8-58.8 m), and every bow member on the river face stays >= 5 cm in front of MallMain's +45 cm
// fascias, mullions and coping. Stem post bottom 52.0 m: 2.0 m above the river-logo envelope (49.9 m, D8 >= 0.5 m).
// Local construction frame inside CROWN_Body: u = along the long axis toward the prow (east), v = across (north),
// z = world height; rotated by SITE_ROT_DEG about the crown centre at the end. In this frame the river face is the
// line u = CR_UF (the Z4 east edge runs exactly along the rotated grid).
// Interface data (#meshdefs rev B, Management D8): CROWN_C = (-750, -2250, 0); stem axis on the river face at
// world y ~ -1906 (MallMain STEM_Y = -1906); the rev A CROWN_FP outline is superseded by this file's rim.

#meshpart CROWN_Body
param lod = 0;                  // 0 = full detail, 1 = far display, 2 = collider
param piece = 0;                // 0 rim, 1 drum + kerb + fins + skirt, 2 Wisdom Hall bow, 3 canopy, 4 collider
// ---- calibrated frame: #meshdefs rev B (Management D8) ----
let CR_CX = CROWN_C.x;          // crown centre, world x (cm)
let CR_CY = CROWN_C.y;          // crown centre, world y (cm)
let CR_CS = cos(SITE_ROT_DEG);
let CR_SN = sin(SITE_ROT_DEG);
// river face (Z4_FP edge 1 -> 2) in the crown frame, where it crosses the crown axis (v = 0)
let CR_F1 = at(Z4_FP, 1);
let CR_F2 = at(Z4_FP, 2);
let CR_F1U = (CR_F1.x - CR_CX) * CR_CS + (CR_F1.y - CR_CY) * CR_SN;
let CR_F1V = (CR_F1.y - CR_CY) * CR_CS - (CR_F1.x - CR_CX) * CR_SN;
let CR_F2U = (CR_F2.x - CR_CX) * CR_CS + (CR_F2.y - CR_CY) * CR_SN;
let CR_F2V = (CR_F2.y - CR_CY) * CR_CS - (CR_F2.x - CR_CX) * CR_SN;
let CR_UF = CR_F1U + (CR_F2U - CR_F1U) * (0 - CR_F1V) / (CR_F2V - CR_F1V);
// ---- plan ----
let CR_AS = 4240;               // centre -> stern tip (rim lip stays east of world x -52 m: clear of MallMain's AHU row)
let CR_AP = CR_UF + 40;         // centre -> prow tip (derived): outline tip 40 cm proud of the river face
let CR_B = 2300;                // half width
let CR_P = 0.68;                // prow pinch -> ~1 m tip radius (sharp prow)
// ---- sheer and band (scene QC r1) ----
let CR_ZPR = CROWN_TOP;         // upturned prow point: 75.0 m
let CR_ZST = CROWN_TOP - 120;   // rim top at the stern: 73.8 m (QC-B ~74 m, QC-A >= 72 m), 74.0 m at the bow root
let CR_FLICK = 100;             // upturned point: the sheer flicks up 1.0 m over the last 9 m to CROWN_TOP
let CR_FLW = 900;               // ... flick length
let CR_BD0 = 280;               // band depth at the stern (QC-A: flanks shallower than r3's 3.5-4.0 m)
let CR_BD1 = 30;                // ... + 0.3 m toward the bow
let CR_BEAK = 200;              // QC-A: a short 2 m beak at the tip instead of the 5 m rolled hook
let CR_IB = 150;                // band soffit width (drum glazing and fins tuck under it)
let CR_SLP = 40;                // the soffit rises 40 cm inward over CR_IB, so its warm cove faces the river
let CR_CRL = 60;                // C-lip: at the beak the soffit curls back and up by 0.6 m behind the flat underside
let CR_ZB0 = CROWN_BASE - 10;   // drum foot, embedded 10 cm into the Z4 roof
// ---- white canopy skirt round the drum base (QC-B) ----
let CR_ZSK = CROWN_BASE + 200;  // skirt underside 60.0 m
let CR_SKT = 100;               // skirt thickness at the drum (top 61.0 m), 50 cm at the edge (30 cm fall)
let CR_SKW = 300;               // skirt width beyond the drum glazing
// ---- canopy: cream deck + 3 stepped gold rings ----
let CR_DK = 160;                // deck top 1.6 m below the sheer line
let CR_TS = 60;                 // ring step (60 cm of gold fascia each)
let CR_TT = 80;                 // ring tier thickness (20 cm into the tier below)
// ---- Wisdom Hall bow on the river face ----
let CR_UCUT = CR_UF - 120;      // the oval drum ends on this plane behind the bow
let CR_UG = CR_UF + 65;         // glass front face (pane 55..65 cm east of the face: clear of MallMain's +45 cm members)
let CR_UR = CR_UF + 80;         // blade plane below the knee (75..85 cm, mullions to 95 cm: >= 30 cm off the coping)
let CR_US0 = CR_UF + 50;        // stem post back face (5 cm clear of MallMain's +45 cm fascias and coping)
let CR_US1 = CR_UF + 100;       // stem post front face = outermost bow surface (bow zone)
let CR_HS = 100;                // stem post half width (2 m post)
let CR_ZGF = 5600;              // glass sill 56.0 m (QC r3 open item: triangle raised ~4.5 m)
let CR_ZPB = 5200;              // stem post foot 52.0 m: shows 4 m below the sill
let CR_LG = 1150;               // glass base along the river face, south of the stem
let CR_WB = 850;                // white blade width along the facade (QC-B: broad raking prow blade)
let CR_ZK = 5920;               // blade knee: 40 cm above the coping top (58.8 m); above it the blade rakes back
let CR_USAIL = CR_UF - 1600;    // west end of the lit raked glazing on the south flank
let n = select(160, 36, lod > 0.5);
let CR_DW = select(60, 150, lod > 0.5);   // drum wall thickness, larger than the worst quad fold so the walls never cross

// ---------------- outline stations (pinched oval: stern semi-axis CR_AS, prow semi-axis CR_AP) ----------------
var ou = []; var ov = []; var onx = []; var ony = []; var ozt = []; var ozb = [];
var r_ot = []; var r_om = []; var r_ob = []; var r_im = []; var r_ib = []; var r_it = [];
var c_ot = []; var c_ob = []; var c_ib = []; var c_it = [];
var l_ot = []; var l_ob = []; var l_ib = []; var l_it = [];
var w_ot = []; var w_ob = []; var w_ib = []; var w_it = [];
var d_b = []; var d_t = []; var d_ti = []; var d_bi = [];
var kerb = []; var deck = []; var shead = []; var sfoot = [];
var k_ot = []; var k_it = []; var k_ib = []; var k_ob = [];
for i in 0..n {
    let t = 360 * i / n;
    let c = cos(t);
    let s = sin(t);
    let pc = max(c, 0);
    let aa = select(CR_AS, CR_AP, c > 0);
    let u = aa * c;
    let v = CR_B * s * (1 - CR_P * pc * pc);
    let du = 0 - aa * s;
    let dv = CR_B * (c * (1 - CR_P * pc * pc) + 2 * CR_P * pc * s * s);
    let ln = sqrt(du * du + dv * dv);
    let nx = dv / ln;
    let ny = 0 - du / ln;
    let q = (u + CR_AS) / (CR_AS + CR_AP);
    let zt = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(q, 2.5) + CR_FLICK * smoothstep(CR_AP - CR_FLW, CR_AP, u);
    let hk = smoothstep(CR_AP - 1000, CR_AP, u);
    let bk = pow(hk, 1.5);
    let zb = zt - (CR_BD0 + CR_BD1 * q * q + CR_BEAK * bk);   // band 2.8 m stern -> 3.1 m bow, 5.1 m at the beak tip
    let fl = 120 + 60 * pow(q, 4) - 140 * hk;            // outward lean of the band top (1.2 m stern, 40 cm at the tip)
    let th = 70 + 60 * smoothstep(CR_AP - 1600, CR_AP - 600, u);   // band thickness: 70 cm, 130 cm in the beak
    let bu = 25 + 10 * bk;                               // outer bulge at mid-depth
    let rr = CR_SLP + 5 + CR_CRL * bk;                   // inner soffit edge height (10 x 5 cm chamfer, C-curl at the beak)
    let dd = CR_IB + 10 + 60 * bk;
    // inward offsets near the sharp tip (radius ~1 m) fade their sideways part so no ring folds over itself
    let gh = 1 - smoothstep(CR_AP - 800, CR_AP - 200, u);
    let kit = fl - th;
    let vit = select(1, gh, kit < 0);
    let kc = fl - th - 6;
    let vc = select(1, gh, kc < 0);
    let lw = 110 + 30 * bk;                              // cove strip inner edge: 1.1 m, 1.4 m under the beak
    let zm = (zb + zt) * 0.5;
    let om = fl * 0.5 + bu;
    ou = append(ou, u); ov = append(ov, v); onx = append(onx, nx); ony = append(ony, ny);
    ozt = append(ozt, zt); ozb = append(ozb, zb);
    // rim band profile (outer face bulges through r_om; sloped soffit r_ob -> r_im, then the chamfer/C-curl r_im -> r_ib)
    r_ob = append(r_ob, (u, v, zb));
    r_im = append(r_im, (u - nx * CR_IB, v - ny * CR_IB * gh, zb + CR_SLP));
    r_om = append(r_om, (u + nx * om, v + ny * om, zm));
    r_ot = append(r_ot, (u + nx * fl, v + ny * fl, zt - 6));
    r_it = append(r_it, (u + nx * kit, v + ny * kit * vit, zt - 6));
    r_ib = append(r_ib, (u - nx * dd, v - ny * dd * gh, zb + rr));
    // champagne-gold coping on the lip (14 cm, tops out at the sheer line, 6 cm proud outside)
    c_ot = append(c_ot, (u + nx * (fl + 6), v + ny * (fl + 6), zt));
    c_ob = append(c_ob, (u + nx * (fl + 6), v + ny * (fl + 6), zt - 14));
    c_ib = append(c_ib, (u + nx * kc, v + ny * kc * vc, zt - 14));
    c_it = append(c_it, (u + nx * kc, v + ny * kc * vc, zt));
    // warm line on the outer face just under the coping (24 cm, 4 cm proud): the rim reads as a lit gold band
    let wa = om + (fl - om) * (zt - 16 - zm) / (zt - 6 - zm);
    let wb = om + (fl - om) * (zt - 40 - zm) / (zt - 6 - zm);
    w_ot = append(w_ot, (u + nx * (wa + 4), v + ny * (wa + 4), zt - 16));
    w_it = append(w_it, (u + nx * (wa - 6), v + ny * (wa - 6), zt - 16));
    w_ib = append(w_ib, (u + nx * (wb - 6), v + ny * (wb - 6), zt - 40));
    w_ob = append(w_ob, (u + nx * (wb + 4), v + ny * (wb + 4), zt - 40));
    // warm cove strip under the sloped soffit along the whole rim (QC-A): embedded 3 cm, 7 cm proud below
    l_ot = append(l_ot, (u - nx * 10, v - ny * 10 * gh, zb + CR_SLP * 10 / CR_IB + 3));
    l_ob = append(l_ob, (u - nx * 10, v - ny * 10 * gh, zb + CR_SLP * 10 / CR_IB - 7));
    l_ib = append(l_ib, (u - nx * lw, v - ny * lw * gh, zb + CR_SLP * lw / CR_IB - 7));
    l_it = append(l_it, (u - nx * lw, v - ny * lw * gh, zb + CR_SLP * lw / CR_IB + 3));
    // drum: foot inset by the taper (5.5 m stern -> 1.8 m river half), head under the soffit; both end on CR_UCUT.
    // v offsets fade out toward the prow so the clamped points stay monotone (no swallowtail at the sharp tip).
    let taper = 550 - 370 * smoothstep(-1500, 1500, u);
    let gw = 1 - smoothstep(CR_AP - 1600, CR_AP - 400, u);
    let fu = u - nx * taper;
    let fv = v - ny * taper * gw;
    let hu = u - nx * 130;
    let hv = v - ny * 130 * gh;
    let zh = zb + CR_SLP * 130 / CR_IB + 15;            // 15 cm into the sloped soffit, 130 cm in from the lip
    d_b = append(d_b, (min(fu, CR_UCUT), fv, CR_ZB0));
    d_t = append(d_t, (min(hu, CR_UCUT), hv, zh + CR_CRL * bk));
    d_ti = append(d_ti, (min(hu - nx * CR_DW, CR_UCUT - CR_DW), hv - ny * CR_DW * gh, zh + CR_CRL * bk));
    d_bi = append(d_bi, (min(fu - nx * CR_DW, CR_UCUT - CR_DW), fv - ny * CR_DW * gw, CR_ZB0));
    kerb = append(kerb, (min(fu + nx * 45, CR_UCUT + 45), fv + ny * 45 * gw));
    shead = append(shead, (hu, hv, zh));
    sfoot = append(sfoot, (fu, fv, CR_ZB0));
    // canopy skirt profile: glazing face at the skirt level (the drum leans out along the normal), 20 cm into the
    // drum wall, 3 m out; only where it stays clear of the bow (south: west of the lit glazing; north: 5 m behind the cut)
    let f0 = (CR_ZSK - CR_ZB0) / (zh + CR_CRL * bk - CR_ZB0);
    let f1 = (CR_ZSK + CR_SKT - CR_ZB0) / (zh + CR_CRL * bk - CR_ZB0);
    let g0 = taper + (130 - taper) * f0;                 // inward offset of the glazing face at the skirt underside
    let g1 = taper + (130 - taper) * f1;                 // ... at the skirt top
    let gm = (g0 + g1) * 0.5;
    k_ot = append(k_ot, (u - nx * (gm - CR_SKW), v - ny * (gm - CR_SKW), CR_ZSK + CR_SKT - 30));
    k_it = append(k_it, (u - nx * (g1 + 20), v - ny * (g1 + 20), CR_ZSK + CR_SKT));
    k_ib = append(k_ib, (u - nx * (g0 + 20), v - ny * (g0 + 20), CR_ZSK));
    k_ob = append(k_ob, (u - nx * (gm - CR_SKW), v - ny * (gm - CR_SKW), CR_ZSK + 20));
    // canopy deck edge: 25 cm into the band's inner face at deck level
    let zd = zt - CR_DK;
    let e = 0 - dd + (kit + dd) * (zd - zb - rr) / (zt - 6 - zb - rr) + 25;
    let gd = 1 - smoothstep(CR_AP - 800, CR_AP - 200, u);
    deck = append(deck, (u + nx * e, v + ny * e * gd, 0));
}
// glass triangle apex just under the beak's soffit at the stem
let CR_ZGA = at(ozb, 0) + 40;
let CR_H = CR_ZGA - CR_ZGF;
let CR_SL = CR_LG / CR_H;      // hypotenuse elevation slope: cm of v per cm of z; every blade line is parallel to it
// outermost blade line (d = CR_WB) meets the soffit head line on the south flank at tout (between stations kx-1, kx)
let vfo = 0 - CR_HS - CR_LG - CR_WB;
var tout = (CR_UR, 0 - CR_HS, CR_ZGA);
var kx = 0;
var fnd = 0;
var prv0 = at(shead, n - 1);
var pfo = 0;
for k in 0..(n / 2) {
    let i = n - 1 - k;
    let sh = at(shead, i);
    let f = sh.y - (vfo + CR_SL * (sh.z - CR_ZGF));
    let hit = (fnd < 0.5) * (k > 0.5) * (pfo >= 0) * (f < 0);
    if hit > 0.5 {
        tout = prv0 + (sh - prv0) * (pfo / (pfo - f));
        fnd = 1;
        kx = k;
    }
    prv0 = sh;
    pfo = f;
}
// lit raked glazing stations (south flank, counted from the tip): k >= kx back to CR_USAIL, always at least kx and
// kx + 1 (the coarse LOD1 ring); CR_UGW = the glazing's west end, which also ends the skirt and the fins there
var gsel = [];
var CR_UGW = at(ou, n - 1 - kx);
for k in 0..(n / 2) {
    let i = n - 1 - k;
    let ok = (k >= kx) * (at(ov, i) < 0 - CR_HS - 60) * min((at(ou, i) >= CR_USAIL) + (k <= kx + 1), 1);
    gsel = append(gsel, ok);
    if ok > 0.5 {
        CR_UGW = min(CR_UGW, at(ou, i));
    }
}

var g = empty();

if piece < 0.5 {
    // ================= CROWN_Rim =================
    // Each ring is lofted along the stations from the stern round and back to the stern: the end sections are
    // planar profiles (v = 0 at the stern), so the loft's outward orientation is established (no W_LOFT_WINDING).
    var rs = []; var cs = []; var ls = []; var ws = [];
    for k in 0..(n + 1) {
        let i = mod(k + n / 2, n);
        rs = append(rs, [at(r_ot, i), at(r_it, i), at(r_ib, i), at(r_im, i), at(r_ob, i), at(r_om, i)]);
        cs = append(cs, [at(c_ot, i), at(c_it, i), at(c_ib, i), at(c_ob, i)]);
        ls = append(ls, [at(l_ot, i), at(l_it, i), at(l_ib, i), at(l_ob, i)]);
        ws = append(ws, [at(w_ot, i), at(w_it, i), at(w_ib, i), at(w_ob, i)]);
    }
    g = merge(g, loft_sections(sections: rs, closed: "yes", material: "ICS_Gold"));
    g = merge(g, loft_sections(sections: ls, closed: "yes", material: "ICS_WarmLight"));
    g = merge(g, loft_sections(sections: ws, closed: "yes", material: "ICS_WarmLight"));
    if lod < 0.5 {
        g = merge(g, loft_sections(sections: cs, closed: "yes", material: "ICS_Gold"));
    }
} else if piece < 1.5 {
    // ================= CROWN_Drum =================
    // warm interior-window glazing seen between the fins (ShopLit at both LODs: QC r3 open item)
    g = merge(g, loft_sections(sections: [d_b, d_t, d_ti, d_bi, d_b], closed: "yes", material: "ICS_ShopLit"));
    // white kerb where the drum meets the Z4 roof
    g = merge(g, translate(extrude(points: kerb, height: 55, material: "ICS_White"), (0, 0, CR_ZB0 + 5)));
    // white canopy skirt round the drum base (QC-B): one solid strip from the north side round the stern to the south
    var sk = [];
    for i in 0..n {
        let su = at(ou, i);
        let son = (su <= select(CR_UGW - 100, CR_UCUT - 500, at(ov, i) >= 0)) * (su < CR_AP - 1600);
        if son > 0.5 {
            sk = append(sk, [at(k_ot, i), at(k_it, i), at(k_ib, i), at(k_ob, i)]);
        }
    }
    g = merge(g, loft_solid(sections: sk, closed: "yes", cap_start: "yes", cap_end: "yes", material: "ICS_White"));
    if lod < 0.5 {
        // white fins: 30 cm wide x 120 cm deep at 88 cm pitch (arc length), every 6th a 45 x 170 cm primary fin.
        // None on the drum's end plane or on the south flank behind the bow glazing. Over the skirt they start 40 cm
        // inside it; elsewhere 15 cm into the roof deck. Heads end 25 cm (+ the C-lip rise) inside the band.
        var acc = 0;
        var pu = 0;
        var pv = 0;
        var nf = 0;
        for j in 0..480 {
            let t = 360 * j / 480;
            let c = cos(t);
            let s = sin(t);
            let pc = max(c, 0);
            let aa = select(CR_AS, CR_AP, c > 0);
            let u = aa * c;
            let v = CR_B * s * (1 - CR_P * pc * pc);
            let ds = select(0, sqrt((u - pu) * (u - pu) + (v - pv) * (v - pv)), j > 0);
            acc = acc + ds;
            pu = u;
            pv = v;
            if acc >= 88 {
                acc = acc - 88;
                let du = 0 - aa * s;
                let dv = CR_B * (c * (1 - CR_P * pc * pc) + 2 * CR_P * pc * s * s);
                let ln = sqrt(du * du + dv * dv);
                let nx = dv / ln;
                let ny = 0 - du / ln;
                let q = (u + CR_AS) / (CR_AS + CR_AP);
                let zt = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(q, 2.5) + CR_FLICK * smoothstep(CR_AP - CR_FLW, CR_AP, u);
                let bk = pow(smoothstep(CR_AP - 1000, CR_AP, u), 1.5);
                let zb = zt - (CR_BD0 + CR_BD1 * q * q + CR_BEAK * bk);
                let taper = 550 - 370 * smoothstep(-1500, 1500, u);
                let gw = 1 - smoothstep(CR_AP - 1600, CR_AP - 400, u);
                let fu = u - nx * taper;
                let fv = v - ny * taper * gw;
                let hu = u - nx * 130;
                let hv = v - ny * 130;
                let ok = (fu < CR_UCUT - 80) * (hu < CR_UCUT - 80) * (1 - (v < 0) * (u > CR_UGW - 100));
                let thr = min(select(CR_UGW - 100, CR_UCUT - 500, v >= 0), CR_AP - 1600);
                let onsk = u <= thr - 150;
                let offsk = u > thr + 150;
                if ok * (onsk + offsk) > 0.5 {
                    nf = nf + 1;
                    let pri = mod(nf, 6) < 0.5;
                    let fw = select(30, 45, pri);
                    let fd = select(120, 170, pri);
                    let ztop = zb + CR_SLP * 130 / CR_IB + 25 + CR_CRL * bk;
                    let a0 = (fu + nx * fd * 0.5, fv + ny * fd * 0.5, CR_ZB0);
                    let a1 = (hu + nx * fd * 0.5, hv + ny * fd * 0.5, ztop);
                    let zs = select(CR_ZB0 - 5, CR_ZSK + CR_SKT - 40, onsk > 0.5);
                    let a = a0 + (a1 - a0) * ((zs - CR_ZB0) / (ztop - CR_ZB0));
                    g = merge(g, beam_between(start: a, end: a1, cross_width: fw, cross_height: fd, height_direction: (nx, ny, 0), material: "ICS_White"));
                }
            }
        }
    }
} else if piece < 2.5 {
    // ================= CROWN_Gable: Wisdom Hall bow =================
    let ztip = at(ozb, 0);
    // white stem post on the river face, from 4 m below the glass sill up into the beak
    g = merge(g, box_bounds(min: (CR_US0, 0 - CR_HS, CR_ZPB), max: (CR_US1, CR_HS, ztip + 120), material: "ICS_White"));
    // right-triangle glass on the river face: vertical edge on the stem, 11.5 m base, apex under the beak
    let pa = (CR_UG, 0 - CR_HS, CR_ZGA);
    let pf = (CR_UG, 0 - CR_HS, CR_ZGF);
    let pe = (CR_UG, 0 - CR_HS - CR_LG, CR_ZGF);
    g = merge(g, extrude_loop(points: [pf, pa, pe], offset: (-10, 0, 0), material: "ICS_SolidGlass"));
    // white sill under the glass and the blade's foot (stops at the stem post's side face; bottom 15 cm above the post's)
    g = merge(g, box_bounds(min: (CR_US0, 0 - CR_HS - CR_LG - CR_WB - 50, CR_ZGF - 55), max: (CR_US1, 0 - CR_HS, CR_ZGF + 5), material: "ICS_White"));
    // ---- white raking prow blade: every line is parallel to the hypotenuse in the east elevation. Below the knee
    // (59.2 m) it stands on the face plane CR_UR; above the knee each line rakes back to the point where it meets the
    // rim soffit (searched along the south flank), so the blade tucks under the rim. The inner edge (d = 0) stays on
    // the face up to the apex. ----
    let nb = select(11, 1, lod > 0.5);
    var bsec = [];
    for jb in 0..(nb + 1) {
        let d = CR_WB * jb / nb;
        let vf = 0 - CR_HS - CR_LG - d;
        var tp = (CR_UR, 0 - CR_HS, CR_ZGA);
        if jb > 0.5 {
            var found = 0;
            var prv = at(shead, n - 1);
            var pf0 = 0;
            for k in 0..(n / 2) {
                let i = n - 1 - k;
                let sh = at(shead, i);
                let f = sh.y - (vf + CR_SL * (sh.z - CR_ZGF));
                let hit = (found < 0.5) * (k > 0.5) * (pf0 >= 0) * (f < 0);
                if hit > 0.5 {
                    tp = prv + (sh - prv) * (pf0 / (pf0 - f));
                    found = 1;
                }
                prv = sh;
                pf0 = f;
            }
        }
        bsec = append(bsec, [(CR_UR, vf, CR_ZGF), (CR_UR, vf + CR_SL * (CR_ZK - CR_ZGF), CR_ZK), tp]);
    }
    g = merge(g, solidify(loft_sections(sections: bsec, closed: "no", material: "ICS_White"), thickness: select(10, 20, lod > 0.5), offset: 0));
    if lod < 0.5 {
        // 60 cm white frame on the hypotenuse (the blade's inner edge, covers the glass/blade seam; top lands on the post)
        let fv0 = 0 - CR_HS - CR_LG - 30;
        g = merge(g, beam_between(start: (CR_UF + 77, fv0 - 5 * CR_SL, CR_ZGF - 5), end: (CR_UF + 77, fv0 + CR_SL * (CR_H + 25), CR_ZGA + 25), cross_width: 60, cross_height: 42, height_direction: (1, 0, 0), material: "ICS_White"));
        // 5 diagonal DarkMetal mullions (30 cm wide, 12 cm proud) on the blade, each a face part + a raked part
        for jw in 1..6 {
            let dc = CR_WB * jw / 6;
            let vf = 0 - CR_HS - CR_LG - dc;
            var tp = (CR_UR, 0 - CR_HS, CR_ZGA);
            var found = 0;
            var prv = at(shead, n - 1);
            var pf0 = 0;
            for k in 0..(n / 2) {
                let i = n - 1 - k;
                let sh = at(shead, i);
                let f = sh.y - (vf + CR_SL * (sh.z - CR_ZGF));
                let hit = (found < 0.5) * (k > 0.5) * (pf0 >= 0) * (f < 0);
                if hit > 0.5 {
                    tp = prv + (sh - prv) * (pf0 / (pf0 - f));
                    found = 1;
                }
                prv = sh;
                pf0 = f;
            }
            let ft = (CR_UR + 9, vf - 5 * CR_SL, CR_ZGF - 5);
            let kn = (CR_UR, vf + CR_SL * (CR_ZK - CR_ZGF), CR_ZK);
            let ax = normalize(tp - kn);
            let nu = normalize((ax.z, 0, 0 - ax.x));
            let nm = normalize((1, 0, 0) + nu);
            let km = kn + nm * (9 / nm.x);
            let al = normalize(km - ft);
            g = merge(g, beam_between(start: ft, end: km + al * 8, cross_width: 30, cross_height: 12, height_direction: (1, 0, 0), material: "ICS_DarkMetal"));
            g = merge(g, beam_between(start: km - ax * 8, end: tp + nu * 9 + ax * 30, cross_width: 30, cross_height: 12, height_direction: nu, material: "ICS_DarkMetal"));
        }
    }
    // ---- lit raked glazing between the blade and the drum (Photo A's warm panels under the rim): top along the rim
    // soffit (= drum head) back to CR_USAIL, bottom over the coping at the knee height, then down behind the coping
    // (>= 30 cm clear) and along the roof to the drum foot. Nothing below 58 m inside Z4_FP. ----
    let kout = (CR_UR, 0 - CR_HS - CR_LG - CR_WB + CR_SL * (CR_ZK - CR_ZGF), CR_ZK);
    var gt = [tout];
    var lastf = kout;
    for k in 0..(n / 2) {
        if at(gsel, k) > 0.5 {
            gt = append(gt, at(shead, n - 1 - k));
            lastf = at(sfoot, n - 1 - k);
        }
    }
    let mg = select(9, 5, lod > 0.5);
    let gtop = resample_path(gt, count: mg);
    let c1 = kout + (lastf - kout) * ((kout.x - (CR_UF - 100)) / (kout.x - lastf.x));
    let c2 = kout + (lastf - kout) * ((kout.x - (CR_UF - 105)) / (kout.x - lastf.x));
    let c2r = (c2.x, c2.y, CR_ZB0);
    var gbot = [kout, (c1.x, c1.y, CR_ZK), c2r];
    for j in 3..mg {
        gbot = append(gbot, c2r + (lastf - c2r) * ((j - 2) / (mg - 3)));
    }
    g = merge(g, solidify(loft_sections(sections: [gtop, gbot], closed: "no", material: "ICS_ShopLit"), thickness: 10, offset: 0));
    if lod < 0.5 {
        // raked DarkMetal mullions (20 cm) on the glazing rulings, and a bottom rail along its stepped foot
        for j in 1..(mg - 1) {
            let tq = at(gtop, j);
            let bq = at(gbot, j);
            let ax = normalize(tq - bq);
            let n0 = cross(at(gbot, j + 1) - at(gbot, j - 1), ax);
            let hd = normalize(n0) * select(-1, 1, dot(n0, (0.3, -1, 0.3)) > 0);
            g = merge(g, beam_between(start: bq + hd * 10, end: tq + hd * 10 + ax * 20, cross_width: 20, cross_height: 14, height_direction: hd, material: "ICS_DarkMetal"));
        }
        for j in 0..(mg - 1) {
            let sa = at(gbot, j);
            let sb = at(gbot, j + 1);
            let sd = normalize(sb - sa);
            g = merge(g, beam_between(start: sa + (0, 0, 6) - sd * 10, end: sb + (0, 0, 6) + sd * 10, cross_width: 20, cross_height: 20, height_direction: select((0, 0, 1), (1, 0, 0), abs(sd.z) > 0.9), material: "ICS_DarkMetal"));
        }
        // cable-net mullions in front of the glass, from 10 cm into the sill up into the hypotenuse frame
        for j in 1..8 {
            let fj = j / 8;
            let mv = 0 - CR_HS - CR_LG * fj;
            let mz = CR_ZGF + CR_H * (1 - fj) + 20;
            g = merge(g, beam_between(start: (CR_UG + 20, mv, CR_ZGF - 5), end: (CR_UG + 20, mv, mz), cross_width: 12, cross_height: 16, height_direction: (1, 0, 0), material: "ICS_DarkMetal"));
        }
        // warm floor-edge lines (38 cm tall: read at 300 m), 2 cm into the glass, 5 cm into the post, ending under the frame
        for k in 1..4 {
            let lz = CR_ZGF + 420 * k;
            let lv = 0 - CR_HS - CR_LG + CR_SL * (lz - CR_ZGF) - 15;
            g = merge(g, beam_between(start: (CR_UG + 6, 0 - CR_HS + 5, lz), end: (CR_UG + 6, lv, lz), cross_width: 16, cross_height: 38, height_direction: (0, 0, 1), material: "ICS_WarmLight"));
        }
        // three vertical warm strips (25 cm) beside the cable-net mullions
        for j in 1..4 {
            let fj = j / 4;
            let sv = 0 - CR_HS - CR_LG * fj - 20;
            let sz = CR_ZGF + (sv + CR_HS + CR_LG) / CR_SL + 10;
            g = merge(g, beam_between(start: (CR_UG + 4, sv, CR_ZGF - 5), end: (CR_UG + 4, sv, sz), cross_width: 25, cross_height: 12, height_direction: (1, 0, 0), material: "ICS_WarmLight"));
        }
    }
} else if piece < 3.5 {
    // ================= CROWN_Canopy: cream deck + three stepped gold rings following the sweep =================
    // deck top 1.6 m below the sheer line; each ring steps up 0.6 m on an 0.8 m gold fascia (ICS_Gold) with a 18 cm
    // warm strip just under its lip; the top ring peaks ~0.5 m above the local rim top at the centre line (< 75 m)
    let ns = select(7, 5, lod > 0.5);
    let nt = select(4, 2, lod > 0.5);
    let u0 = -300;
    for k in 0..nt {
        let su = 1 - (k * 450 - 100 * step(0.5, k)) / 4700;
        let sv = 1 - (k * 450 - 100 * step(0.5, k)) / CR_B;
        var secs = [];
        var edn = [];
        var eds = [];
        for i in (1 + 2 * step(0.5, k))..(n / 2 - 2 * step(0.5, k)) {
            let pn = at(deck, i);
            let ps = at(deck, n - i);
            let uu = u0 + (pn.x - u0) * su;
            let q = clamp((uu + CR_AS) / (CR_AS + CR_AP), 0, 1);
            let zt = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(q, 2.5) + CR_FLICK * smoothstep(CR_AP - CR_FLW, CR_AP, uu);
            let cmb = 40 * clamp(pn.y * sv / 1200, 0, 1);    // camber scales with the local half width
            var sec = [];
            for j in 0..ns {
                let fj = j / (ns - 1);
                let cv = (2 * fj - 1);
                sec = append(sec, (uu, (ps.y + (pn.y - ps.y) * fj) * sv, zt - CR_DK + k * CR_TS + cmb * (1 - cv * cv) - select(20, CR_TT / 2, k > 0.5)));
            }
            secs = append(secs, sec);
            edn = append(edn, (uu, pn.y * sv, zt - CR_DK + k * CR_TS));
            eds = append(eds, (uu, ps.y * sv, zt - CR_DK + k * CR_TS));
        }
        let sheet = loft_sections(sections: secs, closed: "no", material: "ICS_White");
        g = merge(g, solidify(sheet, thickness: select(40, CR_TT, k > 0.5), offset: 0, side_material: select("ICS_White", "ICS_Gold", k > 0.5)));
        if (k > 0.5) * (lod < 0.5) > 0.5 {
            // warm strip under the ring lip (18 cm tall, 12-30 cm below the tier top, 5 cm proud of the gold fascia)
            let ring = concat_points(edn, reverse_points(eds));
            let m = len(ring);
            var ls = [];
            for jj in 0..(m + 1) {
                let j = mod(jj, m);
                let p = at(ring, j);
                let tg = at(ring, mod(j + 1, m)) - at(ring, mod(j + m - 1, m));
                let no = normalize((tg.y, 0 - tg.x, 0));
                let pa = (p.x, p.y, 0);
                ls = append(ls, [pa + no * 5 + (0, 0, p.z - 12), pa - no * 5 + (0, 0, p.z - 12), pa - no * 5 + (0, 0, p.z - 30), pa + no * 5 + (0, 0, p.z - 30)]);
            }
            g = merge(g, loft_sections(sections: ls, closed: "yes", material: "ICS_WarmLight"));
        }
    }
} else {
    // ================= collider: drum foot prism + 4 stepped deck prisms + bow slab + stem post =================
    // (the canopy is not a walkable roof; the stepped prisms keep the collider within ~1 m of the deck/tiers)
    var kp = [];
    for i in 0..n {
        kp = append(kp, at(kerb, i));
    }
    let zc0 = CR_ZST - CR_BD0 - 60;
    g = merge(g, translate(extrude(points: kp, height: zc0 - CR_ZB0, material: "ICS_White"), (0, 0, CR_ZB0)));
    for b in 0..4 {
        let ua = pick(b, 0 - CR_AS - 100, -1500, 1000, 3000);
        let ub = pick(b, -1500, 1000, 3000, CR_AP + 100);
        var bp = [];
        for i in 0..n {
            let p = at(deck, i);
            let inb = (p.x >= ua - 300) * (p.x <= ub + 300);
            if inb > 0.5 {
                bp = append(bp, (p.x, p.y));
            }
        }
        let qb = clamp((min(ub, CR_AP) + CR_AS) / (CR_AS + CR_AP), 0, 1);
        let ztb = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(qb, 2.5);
        g = merge(g, translate(extrude(points: bp, height: ztb - CR_DK - zc0, material: "ICS_White"), (0, 0, zc0)));
    }
    let k0v = 0 - CR_HS - CR_LG + CR_SL * (CR_ZK - CR_ZGF);
    g = merge(g, extrude_loop(points: [(CR_US1, 0 - CR_HS, CR_ZGF - 55), (CR_US1, 0 - CR_HS, CR_ZGA), (CR_US1, k0v, CR_ZK), (CR_US1, k0v - CR_WB, CR_ZK), (CR_US1, 0 - CR_HS - CR_LG - CR_WB, CR_ZGF - 55)], offset: (-50, 0, 0), material: "ICS_White"));
    g = merge(g, box_bounds(min: (CR_US0, 0 - CR_HS, CR_ZPB), max: (CR_US1, CR_HS, at(ozb, 0) + 120), material: "ICS_White"));
}
out.geo = translate(rotate_z(g, degrees: SITE_ROT_DEG, pivot: (0, 0, 0)), (CR_CX, CR_CY, 0));
#end

#meshpart CROWN_Rim
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 0);
#end

#meshpart CROWN_Drum
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 1);
#end

#meshpart CROWN_Gable
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 2);
#end

#meshpart CROWN_Canopy
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 3);
#end

#mesh ICS_Crown
budget(verts: 250000, indices: 750000);
sim_box(min: (-24000, -24000, 0), max: (24000, 24000, 8000));
anchor(mode: "origin");
let rim = part(CROWN_Rim, lod: 0);
let drum = part(CROWN_Drum, lod: 0);
let gable = part(CROWN_Gable, lod: 0);
let canopy = part(CROWN_Canopy, lod: 0);
out.geo = merge(rim, drum, gable, canopy);
#end

#mesh ICS_Crown lod: 1
let rim = part(CROWN_Rim, lod: 1);
let drum = part(CROWN_Drum, lod: 1);
let gable = part(CROWN_Gable, lod: 1);
let canopy = part(CROWN_Canopy, lod: 1);
out.geo = merge(rim, drum, gable, canopy);
#end

#mesh ICS_Crown collider
out.geo = part(CROWN_Body, lod: 2, piece: 4);
#end
