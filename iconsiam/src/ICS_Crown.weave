// ICS_Crown - gold "krathong" crown on the Z4 roof (CROWN_BASE 58 m -> CROWN_TOP 75 m)      [rework round 1]
// Crown crew. World cm, Z up, authored in WORLD coordinates (object placed at 0,0,0).
// Parts (top-level bindings in every #mesh, so parts_log reports each one):
//   CROWN_Rim    gold rim band (ICS_GoldRoof) with a rolled outer lip, champagne coping (ICS_Gold), warm cove strip
//   CROWN_Drum   drum glazing (ICS_ShopLit, warm) behind ~230 deep white fins (30 x 120 cm @ 88 cm), white kerb
//   CROWN_Gable  Wisdom Hall bow on the river face: white stem post under the hook, right-triangle glass
//                (ICS_SolidGlass, DarkMetal cable-net mullions, WarmLight floor lines), white raked rib sail
//   CROWN_Canopy white canopy deck + 3 stepped tiers on gold fascias, all following the rim's sweep
// Calibration vs Photos A/B: boat-shaped oval, long axis on the site grid (SITE_ROT_DEG), 93.5 m tip-to-stern
// (96.3 m over the lip) x 46 m (50 m over the lip). Prow semi-length is DERIVED from Z4_FP (river face edge 1->2):
// the outline tip stands 1.2 m proud of the river face and lands on the stem post. Rim top 69.5 m at the stern
// sweeping to CROWN_TOP 75.0 m at the prow tip (q^2.5 + 1.5 m flick), band 3.5 -> 4.0 m deep, then a 5 m hook
// over the last 10 m. The Wisdom Hall glass hangs on the river face from 51.5 m to 71.0 m (D5 interface item:
// the crown owns the stem, glass and sail on the Z4 east face from 51 m up; MallMain must not duplicate there).
// Local construction frame inside CROWN_Body: u = along the long axis toward the prow (east), v = across (north),
// z = world height; rotated by SITE_ROT_DEG about the crown centre at the end. In this frame the river face is the
// line u = CR_UF (the Z4 east edge runs exactly along the rotated grid).

#meshpart CROWN_Body
param lod = 0;                  // 0 = full detail, 1 = far display, 2 = collider
param piece = 0;                // 0 rim, 1 drum + kerb + fins, 2 Wisdom Hall bow, 3 canopy, 4 collider
// ---- calibrated frame: crew calibration, to be replaced by CROWN_C once Management republishes #meshdefs rev B ----
let CR_CX = -750;               // crown centre, world x (cm)
let CR_CY = -3500;              // crown centre, world y (cm)
let CR_CS = cos(SITE_ROT_DEG);
let CR_SN = sin(SITE_ROT_DEG);
// river face (Z4_FP edge 1 -> 2) in the crown frame, where it crosses the crown axis (v = 0)
let CR_F1 = at(Z4_FP, 1);
let CR_F2 = at(Z4_FP, 2);
let CR_F1U = (CR_F1.x - CR_CX) * CR_CS + (CR_F1.y - CR_CY) * CR_SN;
let CR_F1V = (CR_F1.y - CR_CY) * CR_CS - (CR_F1.x - CR_CX) * CR_SN;
let CR_F2U = (CR_F2.x - CR_CX) * CR_CS + (CR_F2.y - CR_CY) * CR_SN;
let CR_F2V = (CR_F2.y - CR_CY) * CR_CS - (CR_F2.x - CR_CX) * CR_SN;
let CR_UF = CR_F1U + (CR_F2U - CR_F1U) * (0 - CR_F1V) / (CR_F2V - CR_F1V);
// ---- plan, sheer, band ----
let CR_AS = 4240;               // centre -> stern tip (rim lip stays east of world x -52 m: clear of MallMain's AHU row)
let CR_AP = CR_UF + 120;        // centre -> prow tip (derived): 1.2 m proud of the river face, over the stem post
let CR_B = 2300;                // half width
let CR_P = 0.68;                // prow pinch -> ~1 m tip radius (sharp prow)
let CR_ZST = 6950;              // rim top at the stern (west end)
let CR_ZPR = CROWN_TOP;         // rim top at the prow tip (75 m)
let CR_FLICK = 150;             // upward flick of the sheer over the last 6 m
let CR_BEAK = 500;              // hook: the band rolls down 5 m more over the last 10 m and lands on the stem post
let CR_IB = 150;                // band soffit width (drum glazing and fins tuck under it)
let CR_ZB0 = CROWN_BASE - 10;   // drum foot, embedded 10 cm into the Z4 roof
// ---- Wisdom Hall bow on the river face ----
let CR_UCUT = CR_UF - 120;      // the oval drum ends on this plane behind the bow (kerb clears MallMain's coping)
let CR_UG = CR_UF + 90;         // glass plane: 45 cm clear of MallMain's curtain-wall fascias (they reach +45 cm)
let CR_US0 = CR_UF + 40;        // stem post back face
let CR_US1 = CR_UF + 160;       // stem post front face
let CR_HS = 100;                // stem post half width (2 m post)
let CR_ZGF = 5150;              // glass foot (below the Z4 roof: hangs on the river face)
let CR_ZGA = 7100;              // glass apex, just under the hook
let CR_LG = 1700;               // glass base along the river face, south of the stem
let CR_USAIL = CR_UF - 1400;    // west end of the raked sail on the south flank
let n = select(160, 36, lod > 0.5);

// ---------------- outline stations (pinched oval: stern semi-axis CR_AS, prow semi-axis CR_AP) ----------------
var ou = []; var ov = []; var onx = []; var ony = []; var ozt = []; var ozb = [];
var r_ot = []; var r_om = []; var r_ob = []; var r_ib = []; var r_it = [];
var c_ot = []; var c_ob = []; var c_ib = []; var c_it = [];
var l_ot = []; var l_ob = []; var l_ib = []; var l_it = [];
var d_b = []; var d_t = []; var d_ti = []; var d_bi = [];
var kerb = []; var deck = []; var odz = []; var shead = []; var sfoot = []; var ocl = [];
for i in 0..n {
    let t = 360 * i / n;
    let c = cos(t);
    let s = sin(t);
    let pc = max(c, 0);
    let aa = select(CR_AS, CR_AP, c > 0);
    let u = aa * c;
    let v = CR_B * s * (1 - CR_P * pc * pc);
    let du = 0 - aa * s;
    let dv = CR_B * (c * (1 - CR_P * pc * pc) + 2 * CR_P * pc * s * s);
    let ln = sqrt(du * du + dv * dv);
    let nx = dv / ln;
    let ny = 0 - du / ln;
    let q = (u + CR_AS) / (CR_AS + CR_AP);
    let zt = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(q, 2.5) + CR_FLICK * smoothstep(CR_AP - 600, CR_AP, u);
    let hk = smoothstep(CR_AP - 1000, CR_AP, u);
    let bk = pow(hk, 1.5);
    let zb = zt - (350 + 50 * q * q + CR_BEAK * bk);     // band 3.5 m stern -> 4.0 m bow, hook to 9 m at the tip
    let fl = 200 + 80 * pow(q, 4) - 180 * hk;            // outward lean of the band top (small at the tip: lands on the stem)
    let th = 70 + 80 * smoothstep(CR_AP - 1600, CR_AP - 600, u);   // band thickness: 70 cm, 150 cm rolled lip in the hook
    let bu = 30 + 70 * bk;                               // outer bulge at mid-depth (rolled C-hook profile)
    ou = append(ou, u); ov = append(ov, v); onx = append(onx, nx); ony = append(ony, ny);
    ozt = append(ozt, zt); ozb = append(ozb, zb);
    // rim band rings (outer face bulges through r_om)
    r_ob = append(r_ob, (u, v, zb));
    r_om = append(r_om, (u + nx * (fl * 0.5 + bu), v + ny * (fl * 0.5 + bu), (zb + zt) * 0.5));
    r_ot = append(r_ot, (u + nx * fl, v + ny * fl, zt - 6));
    r_it = append(r_it, (u + nx * (fl - th), v + ny * (fl - th), zt - 6));
    r_ib = append(r_ib, (u - nx * CR_IB, v - ny * CR_IB, zb));
    // champagne-gold coping on the lip (14 cm, tops out at the sheer line, 6 cm proud outside)
    c_ot = append(c_ot, (u + nx * (fl + 6), v + ny * (fl + 6), zt));
    c_ob = append(c_ob, (u + nx * (fl + 6), v + ny * (fl + 6), zt - 14));
    c_ib = append(c_ib, (u + nx * (fl - th - 6), v + ny * (fl - th - 6), zt - 14));
    c_it = append(c_it, (u + nx * (fl - th - 6), v + ny * (fl - th - 6), zt));
    // warm cove light strip in the band soffit (embedded 3 cm, 7 cm proud below)
    l_ot = append(l_ot, (u - nx * 10, v - ny * 10, zb + 3));
    l_ob = append(l_ob, (u - nx * 10, v - ny * 10, zb - 7));
    l_ib = append(l_ib, (u - nx * 60, v - ny * 60, zb - 7));
    l_it = append(l_it, (u - nx * 60, v - ny * 60, zb + 3));
    // drum: foot inset by the taper (5.5 m stern -> 1.8 m river half), head under the soffit; both end on CR_UCUT.
    // v offsets fade out toward the prow so the clamped points stay monotone (no swallowtail at the sharp tip).
    let taper = 550 - 370 * smoothstep(-1500, 1500, u);
    let gw = 1 - smoothstep(CR_AP - 1600, CR_AP - 400, u);
    let gh = 1 - smoothstep(CR_AP - 800, CR_AP - 200, u);
    let fu = u - nx * taper;
    let fv = v - ny * taper * gw;
    let hu = u - nx * 130;
    let hv = v - ny * 130 * gh;
    d_b = append(d_b, (min(fu, CR_UCUT), fv, CR_ZB0));
    d_t = append(d_t, (min(hu, CR_UCUT), hv, zb + 15));
    d_ti = append(d_ti, (min(hu - nx * 40, CR_UCUT - 40), hv - ny * 40 * gh, zb + 15));
    d_bi = append(d_bi, (min(fu - nx * 40, CR_UCUT - 40), fv - ny * 40 * gw, CR_ZB0));
    kerb = append(kerb, (min(fu + nx * 45, CR_UCUT + 45), fv + ny * 45 * gw));
    ocl = append(ocl, step(CR_UCUT, fu));
    shead = append(shead, (hu, hv, zb + 15));
    sfoot = append(sfoot, (fu, fv, CR_ZB0));
    // canopy deck edge: 25 cm into the band's inner face at deck level (deck 1.5 m below the sheer line)
    let zd = zt - 150;
    let e = 0 - CR_IB + (fl - th + CR_IB) * (zd - zb) / (zt - zb) + 25;
    let gd = 1 - smoothstep(CR_AP - 800, CR_AP - 200, u);
    deck = append(deck, (u + nx * e, v + ny * e * gd, 0));
    odz = append(odz, zd);
}

var g = empty();

if piece < 0.5 {
    // ================= CROWN_Rim =================
    g = merge(g, loft_sections(sections: [r_ot, r_it, r_ib, r_ob, r_om, r_ot], closed: "yes", material: "ICS_GoldRoof"));
    if lod < 0.5 {
        g = merge(g, loft_sections(sections: [l_ot, l_it, l_ib, l_ob, l_ot], closed: "yes", material: "ICS_WarmLight"));
        g = merge(g, loft_sections(sections: [c_ot, c_it, c_ib, c_ob, c_ot], closed: "yes", material: "ICS_Gold"));
    }
} else if piece < 1.5 {
    // ================= CROWN_Drum =================
    // glazing: warm lit glass at LOD0 (seen between the fins), white at LOD1 (the fins' colour at distance)
    g = merge(g, loft_sections(sections: [d_b, d_t, d_ti, d_bi, d_b], closed: "yes", material: select("ICS_ShopLit", "ICS_White", lod > 0.5)));
    // white kerb where the drum meets the Z4 roof
    g = merge(g, translate(extrude(points: kerb, height: 55, material: "ICS_White"), (0, 0, CR_ZB0 + 5)));
    if lod < 0.5 {
        // white fins: 30 cm wide x 120 cm deep at 88 cm pitch (arc length), glazing 120 cm behind their faces.
        // None on the drum's end plane (plain) or on the south flank behind the sail.
        var acc = 0;
        var pu = 0;
        var pv = 0;
        for j in 0..480 {
            let t = 360 * j / 480;
            let c = cos(t);
            let s = sin(t);
            let pc = max(c, 0);
            let aa = select(CR_AS, CR_AP, c > 0);
            let u = aa * c;
            let v = CR_B * s * (1 - CR_P * pc * pc);
            let ds = select(0, sqrt((u - pu) * (u - pu) + (v - pv) * (v - pv)), j > 0);
            acc = acc + ds;
            pu = u;
            pv = v;
            if acc >= 88 {
                acc = acc - 88;
                let du = 0 - aa * s;
                let dv = CR_B * (c * (1 - CR_P * pc * pc) + 2 * CR_P * pc * s * s);
                let ln = sqrt(du * du + dv * dv);
                let nx = dv / ln;
                let ny = 0 - du / ln;
                let q = (u + CR_AS) / (CR_AS + CR_AP);
                let zt = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(q, 2.5) + CR_FLICK * smoothstep(CR_AP - 600, CR_AP, u);
                let bk = pow(smoothstep(CR_AP - 1000, CR_AP, u), 1.5);
                let zb = zt - (350 + 50 * q * q + CR_BEAK * bk);
                let taper = 550 - 370 * smoothstep(-1500, 1500, u);
                let gw = 1 - smoothstep(CR_AP - 1600, CR_AP - 400, u);
                let fu = u - nx * taper;
                let fv = v - ny * taper * gw;
                let hu = u - nx * 130;
                let hv = v - ny * 130;
                let ok = (fu < CR_UCUT - 80) * (hu < CR_UCUT - 80) * (1 - (v < 0) * (u > CR_USAIL - 100));
                if ok > 0.5 {
                    g = merge(g, beam_between(start: (fu + nx * 60, fv + ny * 60, CR_ZB0 + 40), end: (hu + nx * 60, hv + ny * 60, zb + 8), cross_width: 30, cross_height: 120, height_direction: (nx, ny, 0), material: "ICS_White"));
                }
            }
        }
    }
} else if piece < 2.5 {
    // ================= CROWN_Gable: Wisdom Hall bow =================
    let ztip = at(ozb, 0);
    // white stem post on the river face, from below the glass sill up into the hook
    g = merge(g, box_bounds(min: (CR_US0, 0 - CR_HS, CR_ZGF - 60), max: (CR_US1, CR_HS, ztip + 40), material: "ICS_White"));
    // right-triangle glass on the river face: vertical edge on the stem, base running south, apex under the hook
    let pa = (CR_UG, 0 - CR_HS, CR_ZGA);
    let pf = (CR_UG, 0 - CR_HS, CR_ZGF);
    let pe = (CR_UG, 0 - CR_HS - CR_LG, CR_ZGF);
    g = merge(g, extrude_loop(points: [pf, pa, pe], offset: (-10, 0, 0), material: "ICS_SolidGlass"));
    // white sill under the glass (closes the gap to MallMain's curtain wall)
    g = merge(g, box_bounds(min: (CR_UF + 50, 0 - CR_HS - CR_LG - 60, CR_ZGF - 60), max: (CR_UG + 30, 0 - CR_HS + 10, CR_ZGF + 5), material: "ICS_White"));
    // raked sail: top edge = glass apex + band soffit along the south flank back to CR_USAIL,
    // bottom edge = straight line from the glass foot corner to the drum foot there
    var top = [pa];
    var lastf = pe;
    for k in 0..(n / 2) {
        let i = n - 1 - k;
        if at(ou, i) >= CR_USAIL {
            if at(ov, i) < 0 - CR_HS - 60 {
                top = append(top, at(shead, i));
                lastf = at(sfoot, i);
            }
        }
    }
    let m = len(top);
    var bot = [];
    for j in 0..m {
        bot = append(bot, pe + (lastf - pe) * (j / (m - 1)));
    }
    g = merge(g, solidify(loft_sections(sections: [top, bot], closed: "no", material: "ICS_SolidGlass"), thickness: 20, offset: 0));
    // white sail ribs (40 x 100 cm), fanning from the glass hypotenuse (rib 0 = the thick white frame) to the drum
    let nr = select(12, 2, lod > 0.5);
    for j in 0..(nr + 1) {
        let f = j / nr;
        let tp = at(top, round(f * (m - 1)));
        let bp = pe + (lastf - pe) * f;
        let ns0 = cross(tp - bp, lastf - pe);
        let hd = normalize(ns0) * select(-1, 1, dot(ns0, (1, -1, 0)) > 0);
        g = merge(g, beam_between(start: bp + hd * 30, end: tp + hd * 30, cross_width: select(40, 60, j < 0.5), cross_height: 100, height_direction: hd, material: "ICS_White"));
    }
    if lod < 0.5 {
        // cable-net mullions in front of the glass (12 cm clear of the warm lines: no coplanar faces)
        for j in 1..8 {
            let fj = j / 8;
            let mv = 0 - CR_HS - CR_LG * fj;
            let mz = CR_ZGF + (CR_ZGA - CR_ZGF) * (1 - fj) - 25;
            g = merge(g, beam_between(start: (CR_UG + 20, mv, CR_ZGF + 5), end: (CR_UG + 20, mv, mz), cross_width: 12, cross_height: 16, height_direction: (1, 0, 0), material: "ICS_DarkMetal"));
        }
        // warm floor-edge lines behind the cable net
        for k in 1..5 {
            let lz = CR_ZGF + 420 * k;
            let fr = (lz - CR_ZGF) / (CR_ZGA - CR_ZGF);
            let lv = 0 - CR_HS - CR_LG * (1 - fr) + 60;
            g = merge(g, beam_between(start: (CR_UG + 5, 0 - CR_HS - 10, lz), end: (CR_UG + 5, lv, lz), cross_width: 6, cross_height: 16, height_direction: (0, 0, 1), material: "ICS_WarmLight"));
        }
    }
} else if piece < 3.5 {
    // ================= CROWN_Canopy: white deck + stepped tiers following the sweep =================
    let ns = select(7, 5, lod > 0.5);
    let nt = select(4, 2, lod > 0.5);
    let u0 = -300;
    for k in 0..nt {
        let su = 1 - (k * 450 - 100 * step(0.5, k)) / 4700;
        let sv = 1 - (k * 450 - 100 * step(0.5, k)) / CR_B;
        var secs = [];
        for i in (1 + 2 * step(0.5, k))..(n / 2 - 2 * step(0.5, k)) {
            let pn = at(deck, i);
            let ps = at(deck, n - i);
            let uu = u0 + (pn.x - u0) * su;
            let q = clamp((uu + CR_AS) / (CR_AS + CR_AP), 0, 1);
            let zt = CR_ZST + (CR_ZPR - CR_FLICK - CR_ZST) * pow(q, 2.5) + CR_FLICK * smoothstep(CR_AP - 600, CR_AP, uu);
            let cmb = 40 * clamp(pn.y * sv / 1200, 0, 1);    // camber scales with the local half width
            var sec = [];
            for j in 0..ns {
                let fj = j / (ns - 1);
                let cv = (2 * fj - 1);
                sec = append(sec, (uu, (ps.y + (pn.y - ps.y) * fj) * sv, zt - 150 + k * 55 + cmb * (1 - cv * cv) - select(20, 30, k > 0.5)));
            }
            secs = append(secs, sec);
        }
        let sheet = loft_sections(sections: secs, closed: "no", material: "ICS_White");
        g = merge(g, solidify(sheet, thickness: select(40, 60, k > 0.5), offset: 0, side_material: select("ICS_White", "ICS_GoldRoof", k > 0.5)));
    }
} else {
    // ================= collider: drum foot prism + deck prisms + bow wedge =================
    var kp = [];
    var dp = [];
    var fp = [];
    for i in 0..n {
        kp = append(kp, at(kerb, i));
        let p = at(deck, i);
        dp = append(dp, (p.x, p.y));
        if p.x > 1500 { fp = append(fp, (p.x, p.y)); }
    }
    g = merge(g, translate(extrude(points: kp, height: 6600 - CR_ZB0, material: "ICS_White"), (0, 0, CR_ZB0)));
    g = merge(g, translate(extrude(points: dp, height: 220, material: "ICS_White"), (0, 0, 6590)));
    g = merge(g, translate(extrude(points: fp, height: 420, material: "ICS_White"), (0, 0, 6800)));
    g = merge(g, extrude_loop(points: [(CR_UG, 0 - CR_HS, CR_ZGF), (CR_UG, 0 - CR_HS, CR_ZGA), (CR_UG, 0 - CR_HS - CR_LG, CR_ZGF)], offset: (-130, 0, 0), material: "ICS_White"));
    g = merge(g, box_bounds(min: (CR_US0, 0 - CR_HS, CR_ZGF - 60), max: (CR_US1, CR_HS, at(ozb, 0) + 40), material: "ICS_White"));
}
out.geo = translate(rotate_z(g, degrees: SITE_ROT_DEG, pivot: (0, 0, 0)), (CR_CX, CR_CY, 0));
#end

#meshpart CROWN_Rim
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 0);
#end

#meshpart CROWN_Drum
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 1);
#end

#meshpart CROWN_Gable
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 2);
#end

#meshpart CROWN_Canopy
param lod = 0;
out.geo = part(CROWN_Body, lod: lod, piece: 3);
#end

#mesh ICS_Crown
budget(verts: 250000, indices: 750000);
sim_box(min: (-24000, -24000, 0), max: (24000, 24000, 8000));
anchor(mode: "origin");
let rim = part(CROWN_Rim, lod: 0);
let drum = part(CROWN_Drum, lod: 0);
let gable = part(CROWN_Gable, lod: 0);
let canopy = part(CROWN_Canopy, lod: 0);
out.geo = merge(rim, drum, gable, canopy);
#end

#mesh ICS_Crown lod: 1
let rim = part(CROWN_Rim, lod: 1);
let drum = part(CROWN_Drum, lod: 1);
let gable = part(CROWN_Gable, lod: 1);
let canopy = part(CROWN_Canopy, lod: 1);
out.geo = merge(rim, drum, gable, canopy);
#end

#mesh ICS_Crown collider
out.geo = part(CROWN_Body, lod: 2, piece: 4);
#end
