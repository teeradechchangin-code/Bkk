// ===== ST_Crown rev C (rework round 4, D4) - Crown crew (Subcontractors & Labor) =====
// Everything inside / above ROOFDECK_FP from MAIN_ROOF - 2 up, plus the round Sky Bar off the main block's NW corner.
// World centimetres, Z up, +X east, +Y true north. All heights / footprints come from the shared #meshdefs.
// Photo reading (P1 night target, P2 day, P4 crown drone):
//  - dome terrace storey 216 -> 220 m: white plinth + fascia, inset warm glazing band between white piers, Sirocco deck
//    edged by a white balustrade (plinth, vase balusters, posts, rail, small warm lamp heads), a few tables on the NW/W deck
//  - drum: stylobate, 12 PAIRS of white classical columns (24) with warm glazing behind, a cyan uplight box in front of
//    every column base (P4), entablature with a strongly projecting corona
//  - blue LED band at the dome springing in 12 bays (dark 70 cm piers over the column pairs, 3 lit sub-panels per bay
//    with white mullions and X frames, P1), gold lip with a scalloped hem and a slender dark ledge railing (P4)
//  - gold dome: 28 bulged gores (broad lit flutes / dark grooves of P1) on the superellipse n 1.65 fitted on P1/P2
//  - gold lantern (warm-lit core), cupola, slender spire, orb, warm aviation lamp, spike; tip exactly DOME_TIP
//  - Sky Bar: round cantilevered platform (white double-banded rim, soffit), dark metal rail, island bar with a blue
//    fascia, stools, white-walled stair down from the terrace NW corner
// Single source for every derived value: CROWN_SkyBarLink owns the stair search and the whole Sky Bar / stair /
//        terrace-balustrade layout for LOD0-LOD2 (mode 2, lvl 0/1/2), LOD3 (mode 0) and the collider (mode 1);
//        CROWN_Upper owns the drum / LED / dome / lantern constants (az_view, n_flute, ent_h, rc, rglass, floodlights)
//        for LOD0-LOD2 (detail 1, lvl 0/1/2) and LOD3 (detail 0), and LOD0's emitter sockets read the floodlight point
//        back from it.
// LOD chain (D5): every display level is built from the same parts, frame, radii and heights as LOD0. New `lvl` params
//        (default 0 = LOD0, unchanged) only lower segment / sample counts or drop small pieces:
//        LOD1 (lvl 1, ~57 %) keeps every LOD0 feature (small repeated pieces as flat boxes, so it also stays well
//        under the default 90k-index LOD cap); LOD2 (lvl 2, ~28 %) keeps the silhouette and colour pattern;
//        LOD3 (detail 0 / mode 0, ~4 %) is the far massing.
// Round 4 (D4): entablature fixed at 270 cm (D4 a; columns gain the rest), rc = DRUM_R - 110 (D4 b); stair head made
//        robust for any SKYBAR_C within 3 m (D4 c): guarded axis search (opposite-side edges, foot >= 80 cm from the bar
//        counter), per-side ENTER / RETURN head modes, every edge length clamped to its own edge, landing = slab minus
//        terrace prism, collider edge barrier = one box per balustrade run; cheek tops deck + 120 behind the head, no
//        balustrade posts inside the cheek walls; stools skip the stair band; collider drum at the stylobate step radius;
//        LED band regrouped into P1's bays.
// Interfaces (ST_TowerMain): inside the circle SKYBAR_R about SKYBAR_C the Sky Bar slab occupies MAIN_ROOF - 40 ->
//        MAIN_ROOF + 150 (inside offset(MAIN_FP, -60) nothing of this mesh is lower than MAIN_ROOF - 40, i.e. it stays
//        inside the main roof slab); the soffit cone MAIN_ROOF - 75 -> MAIN_ROOF - 36 exists only outside offset(MAIN_FP,
//        -60) (cantilever + main cornice-ring band, ring bottom MAIN_ROOF - 80). The stair, its head landing, return
//        guards and cheek walls stand on the main roof inside a 3.5 m band (|lateral| <= hw + ct = 175 cm about the
//        stair axis) from 120 cm behind the nearest ROOFDECK_FP vertex to the platform (keep-out corridor, D4 d).

// ---------- generic closed ring (annulus) solid, lathed about (cx, cy) ----------
#meshpart CROWN_Ring
param cx = 0;
param cy = 0;
param z0 = 0;
param z1 = 100;
param r_in = 100;
param r_out = 120;
param seg = 64;
param mat = "ST_Facade";
let ring = lathe_z(profile: [(z0, r_in), (z0, r_out), (z1, r_out), (z1, r_in), (z0, r_in)], segments: seg, material: mat);
out.geo = translate(ring, (cx, cy, 0));
#end

// ---------- one straight run of the terrace balustrade A -> B (deck top z) ----------
// plinth + top rail (ST_Stone), square posts every ~post_sp (post at A only when start_post = 1 - a run that starts in a
// cheek wall leaves it out, the wall is the termination; at B only when end_post = 1), lathe vase balusters between
// posts, optional small warm lamp heads on every lamp_every-th post.
// lvl (display level): 0 = LOD0 (6-sided vase balusters, dark-capped lamps); 1 = LOD1 (the same balusters as square
// shafts, lamp = warm head block); 2 = LOD2 (one solid panel between plinth and rail, no balusters). Same posts / plinth /
// rail at every level. (Display variants carry the default 90k-index cap, so LOD1 uses flat boxes, not lathes.)
#meshpart CROWN_Balustrade
param ax = 0;
param ay = 0;
param bx = 400;
param by = 0;
param z = 22000;
param h = 110;
param post_sp = 250;
param bal_sp = 30;
param start_post = 1;
param end_post = 0;
param lamp_every = 0;
param lvl = 0;
let dx = bx - ax;
let dy = by - ay;
let L = sqrt(dx * dx + dy * dy);
let ux = dx / L;
let uy = dy / L;
let ang = atan2(dy, dx);
let pw = 30;
let ph = 18;
let rh = 14;
let plinth = beam_between(start: (ax, ay, z - 2 + ph * 0.5), end: (bx, by, z - 2 + ph * 0.5), cross_width: 26, cross_height: ph, height_direction: (0, 0, 1), material: "ST_Stone");
let rail = beam_between(start: (ax, ay, z + h - rh * 0.5), end: (bx, by, z + h - rh * 0.5), cross_width: 28, cross_height: rh, height_direction: (0, 0, 1), material: "ST_Stone");
let n = max(1, round(L / post_sp));
let seg = L / n;
var post_pts = [];
var lamp_pts = [];
var n_post = 0;
var n_lamp = 0;
for i in 0..(n + end_post) {
    if i >= 1 - start_post {
        post_pts = append(post_pts, (ax + ux * seg * i, ay + uy * seg * i, 0));
        n_post = n_post + 1;
        if lamp_every > 0 {
            if mod(i, lamp_every) == 0 {
                lamp_pts = append(lamp_pts, (ax + ux * seg * i, ay + uy * seg * i, 0));
                n_lamp = n_lamp + 1;
            }
        }
    }
}
let post = rotate_z(box_at(size: (pw, pw, h + 8), bottom_center: (0, 0, z - 2), material: "ST_Stone"), degrees: ang, pivot: (0, 0, 0));
var g = merge(plinth, rail);
if n_post > 0 {
    g = merge(g, copy_to_points(post, points: post_pts));
}
let bz = z + ph - 3;
let hb = (z + h - rh + 1) - bz;
let baluster = lathe_z(profile: [(bz, 0), (bz, 6.5), (bz + hb * 0.34, 7.5), (bz + hb * 0.74, 4), (bz + hb, 5.5), (bz + hb, 0)], segments: 6, material: "ST_Stone");
let usable = seg - pw;
let nb = max(1, round(usable / bal_sp));
let bs = usable / nb;
var bal_pts = [];
for j in 0..n {
    for k in 0..nb {
        let s = seg * j + pw * 0.5 + bs * (k + 0.5);
        bal_pts = append(bal_pts, (ax + ux * s, ay + uy * s, 0));
    }
}
if lvl < 1 {
    g = merge(g, copy_to_points(baluster, points: bal_pts));
} else if lvl < 2 {
    // LOD1: the same balusters as 12 cm square shafts (same feet / heads, 1 cm into plinth and rail)
    g = merge(g, copy_to_points(rotate_z(box_at(size: (12, 12, hb), bottom_center: (0, 0, bz), material: "ST_Stone"), degrees: ang, pivot: (0, 0, 0)), points: bal_pts));
} else {
    // LOD2: solid panel from 2 cm into the plinth top to 2 cm into the rail bottom
    g = merge(g, beam_between(start: (ax, ay, (bz - 1 + z + h - rh + 2) * 0.5), end: (bx, by, (bz - 1 + z + h - rh + 2) * 0.5), cross_width: 14, cross_height: (z + h - rh + 2) - (bz - 1), height_direction: (0, 0, 1), material: "ST_Stone"));
}
if n_lamp > 0 {
    if lvl > 0 {
        // LOD1: warm head only (12 cm block), 2 cm into the post top, up to the LOD0 cap height
        g = merge(g, copy_to_points(rotate_z(box_at(size: (12, 12, 18), bottom_center: (0, 0, z + h + 4), material: "ST_WarmLight"), degrees: ang, pivot: (0, 0, 0)), points: lamp_pts));
    } else {
        let lamp = merge(
            cylinder_at(radius: 9, height: 4, bottom_center: (0, 0, z + h + 5), segments: 8, material: "ST_DarkMetal"),
            cylinder_at(r_bot: 6, r_top: 7.5, height: 14, bottom_center: (0, 0, z + h + 8), segments: 8, material: "ST_WarmLight"),
            cylinder_at(r_bot: 10, r_top: 2, height: 6, bottom_center: (0, 0, z + h + 21), segments: 8, material: "ST_DarkMetal"));
        g = merge(g, copy_to_points(lamp, points: lamp_pts));
    }
}
out.geo = g;
#end

// ---------- one classical drum column at the local origin (x radial, y tangential), base on zb, abacus top = zt + 2 ----------
// lvl: 0 = LOD0 (16 sides); 1 = LOD1 (10-sided tapered shaft + echinus on the plinth, abacus: no torus / astragal);
// 2 = LOD2 (the same as 8-sided prisms). Same radii and heights at every level (the shaft starts on the plinth top).
#meshpart CROWN_Column
param zb = 22064;
param zt = 22750;
param r = 55;
param lvl = 0;
let cs = pick(lvl, 16, 10, 8);
let zcap = zt - 30;
let plinth = box_at(size: (130, 130, 28), bottom_center: (0, 0, zb - 2), material: "ST_Stone");
let torus_base = torus_center(major_radius: r - 1, tube_radius: 10, segments: cs, tube_segments: 6, center: (0, 0, zb + 34), material: "ST_Stone");
let shaft = cylinder_at(r_bot: r, r_top: r - 8, height: zcap - (zb + 26), bottom_center: (0, 0, zb + 26), segments: cs, material: "ST_Stone");
let astragal = cylinder_at(radius: r - 4, height: 8, bottom_center: (0, 0, zcap - 18), segments: cs, material: "ST_Stone");
let echinus = cylinder_at(r_bot: r - 6, r_top: r + 11, height: 22, bottom_center: (0, 0, zcap - 10), segments: cs, material: "ST_Stone");
let abacus = box_at(size: (140, 140, 20), bottom_center: (0, 0, zcap + 12), material: "ST_Stone");
var g = empty();
if lvl < 1 {
    g = merge(plinth, torus_base, shaft, astragal, echinus, abacus);
} else {
    g = merge(plinth, shaft, echinus, abacus);
}
out.geo = g;
#end

// ---------- dome terrace storey shell (shared by LOD0-LOD3): plinth, inset warm glazing band, fascia, deck ----------
// detail 1 = LOD0, LOD1, LOD2; detail 0 = LOD3.
// Both details: plinth / glazing band / white fascia ring (40 cm) + FacadeShade deck inside the inset line (same z splits
// and the same deck tone, so neither the lit band nor the 1,443 m2 deck changes at the LOD switch).
// detail 1 (LOD0) adds the white piers across the glazing band.
#meshpart CROWN_TerraceShell
param detail = 1;
let zr = MAIN_ROOF - 2;              // storey base, embedded 2 cm in the main roof
let zt = ROOFDECK_TOP;               // Sirocco terrace deck
let zg0 = zr + 62;                   // glazing band bottom (white plinth below)
let zg1 = zt - 110;                  // glazing band top (white fascia above)
let nfp = len(ROOFDECK_FP);
let fp_in = offset_polygon(points: ROOFDECK_FP, delta: -40);
var g = merge(
    translate(extrude(points: ROOFDECK_FP, height: zg0 - zr, material: "ST_Facade"), (0, 0, zr)),
    translate(extrude(points: fp_in, height: zg1 - zg0, material: "ST_DrumGlass"), (0, 0, zg0)),
    translate(extrude_shape(outer: ROOFDECK_FP, holes: [fp_in], height: zt - zg1, material: "ST_Facade"), (0, 0, zg1)),
    translate(extrude(points: fp_in, height: zt - zg1, material: "ST_FacadeShade"), (0, 0, zg1)));
if detail > 0 {
    for e in 0..nfp {
        let p1 = at(ROOFDECK_FP, e);
        let p2 = at(ROOFDECK_FP, mod(e + 1, nfp));
        let el = sqrt((p2.x - p1.x) * (p2.x - p1.x) + (p2.y - p1.y) * (p2.y - p1.y));
        let ex = (p2.x - p1.x) / el;
        let ey = (p2.y - p1.y) / el;
        let nx = 0 - ey;
        let ny = ex;
        let np = max(1, round(el / BAY_W));
        for i in 0..np {
            let s = clamp(i * el / np, 29, el - 29);
            let px = p1.x + ex * s;
            let py = p1.y + ey * s;
            g = merge(g, beam_between(start: (px + nx * 4, py + ny * 4, (zg0 + zg1) * 0.5), end: (px + nx * 50, py + ny * 50, (zg0 + zg1) * 0.5), cross_width: 50, cross_height: zg1 - zg0, height_direction: (0, 0, 1), material: "ST_Facade"));
        }
    }
}
out.geo = g;
#end

// ---------- LED band at the dome springing: white sill, blue panel ring, white top band, bay grid ----------
// Panels fill DRUM_TOP + 16 -> LED_BAND_TOP - 18 (blue face DOME_R + 20). Bay grid (QC r3; P1 8x crop: the band reads
// in ~8 m bays of ~3 lit sub-panels with light diagonal frames, separated by dark gaps): nbay bays, one centred on az
// (the photo-1 sightline; the bay joints then sit over the drum's column pairs). Each joint is a 70 cm dark pier 3 cm
// proud of the panels; nsub sub-panels per bay split by 20 cm white mullions; two thin white diagonal bars (an X, the
// second 2 cm further out) per sub-panel. az is always passed by CROWN_Upper. (The bake's W_NEAR_PARALLEL notes pair the
// same diagonal in neighbouring sub-panels, 9 deg apart round the band: intended, each X lies in its own panel plane.)
// lvl (detail 1 only): 0 = LOD0 (64-sided rings); 1 = LOD1 (40-sided rings); 2 = LOD2 (32-sided rings). The bay grid
// (piers, mullions, X frames: flat bars, cheap in indices) is kept at every level for P1's lit-panel pattern.
#meshpart CROWN_LedBand
param detail = 1;
param az = 0;
param nbay = 12;
param nsub = 3;
param lvl = 0;
let cx = DOME_C.x;
let cy = DOME_C.y;
let seg = select(32, pick(lvl, 64, 40, 32), detail);
let lz1 = DRUM_TOP + 16;
let lz2 = LED_BAND_TOP - 18;
var g = merge(
    part(CROWN_Ring, cx: cx, cy: cy, z0: DRUM_TOP - 2, z1: lz1, r_in: DOME_R - 40, r_out: DOME_R + 42, seg: seg, mat: "ST_Facade"),
    part(CROWN_Ring, cx: cx, cy: cy, z0: lz1, z1: lz2, r_in: DOME_R - 40, r_out: DOME_R + 20, seg: seg, mat: "ST_BlueLED"),
    part(CROWN_Ring, cx: cx, cy: cy, z0: lz2, z1: LED_BAND_TOP, r_in: DOME_R - 40, r_out: DOME_R + 38, seg: seg, mat: "ST_Facade"));
if detail > 0 {
    let zm = (lz1 + lz2) * 0.5;
    let hb = lz2 - lz1;
    let rf = DOME_R + 20;
    let bstep = 360 / nbay;
    let pier_deg = 70 / rf * 57.29578;
    let sub = (bstep - pier_deg) / nsub;
    let dm = 0.6;
    var grid = empty();
    for k in 0..nbay {
        let a = az + bstep * 0.5 + k * bstep;
        grid = merge(grid, beam_between(start: (cx + (rf - 10) * cos(a), cy + (rf - 10) * sin(a), zm), end: (cx + (rf + 3) * cos(a), cy + (rf + 3) * sin(a), zm), cross_width: 70, cross_height: hb + 4, height_direction: (0, 0, 1), material: "ST_DarkMetal"));
        for j in 0..nsub {
            let a1 = a + pier_deg * 0.5 + j * sub;
            let a2 = a1 + sub;
            let am = (a1 + a2) * 0.5;
            if j > 0 {
                grid = merge(grid, beam_between(start: (cx + (rf - 10) * cos(a1), cy + (rf - 10) * sin(a1), zm), end: (cx + (rf + 8) * cos(a1), cy + (rf + 8) * sin(a1), zm), cross_width: 20, cross_height: hb + 4, height_direction: (0, 0, 1), material: "ST_Facade"));
            }
            let rd1 = rf + 6;
            let rd2 = rf + 8;
            grid = merge(grid,
                beam_between(start: (cx + rd1 * cos(a1 + dm), cy + rd1 * sin(a1 + dm), lz1 + 8), end: (cx + rd1 * cos(a2 - dm), cy + rd1 * sin(a2 - dm), lz2 - 8), cross_width: 6, cross_height: 4, height_direction: (cos(am), sin(am), 0), material: "ST_Facade"),
                beam_between(start: (cx + rd2 * cos(a2 - dm), cy + rd2 * sin(a2 - dm), lz1 + 8), end: (cx + rd2 * cos(a1 + dm), cy + rd2 * sin(a1 + dm), lz2 - 8), cross_width: 6, cross_height: 4, height_direction: (cos(am), sin(am), 0), material: "ST_Facade"));
        }
    }
    g = merge(g, grid);
}
out.geo = g;
#end

// ---------- gold dome: superellipse n 1.65 (fitted on P1/P2) from LED_BAND_TOP to DOME_TOP ----------
// detail 1 (LOD0): nfl bulged gores (+gore_b at mid-gore at the springing, fading to 0 at the crown) with hard grooves on
//   the LED mullion lines, so the cornice uplights give P1's broad lit flutes / dark grooves; gold lip; scalloped hem of
//   nfl half-elliptic lobes hanging over the LED band's top rail, centred on the gores; slender dark ledge railing on the
//   lip (P4: posts + top rail right above the LED band).
// lvl (detail 1 only): 0 = LOD0; 1 = LOD1 (4 ring points per gore, 16 rings, 40-sided lip, 6-sample hem lobes, the 64
//   ledge posts as slim square bars, 40-sided rail); 2 = LOD2 (4 points per gore, 14 rings, 40-sided lip, 6-sample hem
//   lobes, no ledge railing). Same grooves, gore bulge, radii and heights at every level.
// detail 0 (LOD3): smooth 32-segment lathe of the same profile. az / nfl are always passed by CROWN_Upper.
#meshpart CROWN_Dome
param detail = 1;
param az = 0;
param nfl = 24;
param lvl = 0;
let cx = DOME_C.x;
let cy = DOME_C.y;
let dome_h = DOME_TOP - LED_BAND_TOP;
let dome_n = 1.65;
let fstep = 360 / nfl;
var g = empty();
if detail > 0 {
    let ppg = pick(lvl, 8, 4, 4);                   // ring points per gore (groove at point 0)
    let npts = nfl * ppg;
    let gore_b = 24;                                // mid-gore bulge at the springing (QC: +20-25 cm)
    let nsec = pick(lvl, 24, 16, 14);
    let th_max = asin(pow(0.995, dome_n / 2));      // last ring at 99.5 % of the dome height (under the lantern base)
    var secs = [];
    for i in 0..(nsec + 1) {
        var zz = LED_BAND_TOP - 6;
        var r0 = DOME_R;
        var bb = gore_b;
        if i > 0 {
            let th = th_max * (i - 1) / (nsec - 1);
            let f = pow(sin(th), 2 / dome_n);
            zz = LED_BAND_TOP + dome_h * f;
            r0 = DOME_R * pow(cos(th), 2 / dome_n);
            bb = gore_b * (1 - pow(f, 1.5));
        }
        var ring = [];
        for p in 0..npts {
            let ph = az + fstep * 0.5 + p * 360 / npts;
            let rr = r0 + bb * sqrt(sin(180 * mod(p, ppg) / ppg));
            ring = append(ring, (cx + rr * cos(ph), cy + rr * sin(ph), zz));
        }
        secs = append(secs, ring);
    }
    let shell = loft_solid(sections: secs, closed: "yes", cap_start: "yes", cap_end: "yes", material: "ST_Gold");
    let lip = translate(lathe_z(profile: [(LED_BAND_TOP - 2, DOME_R - 20), (LED_BAND_TOP - 2, DOME_R + 58), (LED_BAND_TOP + 8, DOME_R + 58), (LED_BAND_TOP + 18, DOME_R + 12), (LED_BAND_TOP + 18, DOME_R - 20), (LED_BAND_TOP - 2, DOME_R - 20)], segments: pick(lvl, 64, 40, 40), material: "ST_Gold"), (cx, cy, 0));
    // scalloped hem: tangential half-ellipse lobes 12 cm thick, inner face 6 cm outside the LED top band,
    // top embedded 6 cm in the lip, bottom ~40 cm below the LED band's top rail (P1)
    let lob_r0 = DOME_R + 44;
    let lob_hw = 0.25 * 2 * (lob_r0 + 6) * sin(fstep * 0.5);
    let lob_z = LED_BAND_TOP + 4;
    let lob_d = 62;
    let hk = pick(lvl, 12, 6, 6);                   // half-ellipse samples per lobe
    var lob_pts = [];
    for j in 0..(hk + 1) {
        let t = j * 180 / hk;
        lob_pts = append(lob_pts, (lob_r0, lob_hw * cos(t), lob_z - lob_d * sin(t)));
    }
    let lobe = extrude_loop(points: lob_pts, offset: (12, 0, 0), material: "ST_Gold");
    var hem = empty();
    for k in 0..nfl {
        hem = merge(hem, translate(rotate_z(lobe, degrees: az + k * fstep, pivot: (0, 0, 0)), (cx, cy, 0)));
    }
    // ledge railing (P4): 64 slim posts (~1.45 m apart) on the lip's sloped top (bottoms ~2.7 cm into it) + a round top
    // rail on the posts
    if lvl < 2 {
        let rail_r = DOME_R + 50;
        let n_rp = 64;
        var rpost = empty();
        if lvl < 1 {
            rpost = cylinder_at(radius: 3, height: 91, bottom_center: (0, 0, LED_BAND_TOP + 7), segments: 6, material: "ST_DarkMetal");
        } else {
            rpost = box_at(size: (6, 6, 91), bottom_center: (0, 0, LED_BAND_TOP + 7), material: "ST_DarkMetal");
        }
        let ledge_posts = copy_to_points(rpost, points: arc_points(center: (cx, cy, 0), radius: rail_r, start_degrees: az, end_degrees: az + 360 - 360 / n_rp, count: n_rp, plane: "xy"));
        let ledge_rail = torus_center(major_radius: rail_r, tube_radius: 3, segments: pick(lvl, 64, 40, 40), tube_segments: pick(lvl, 6, 4, 4), center: (cx, cy, LED_BAND_TOP + 95), material: "ST_DarkMetal");
        g = merge(shell, lip, hem, ledge_posts, ledge_rail);
    } else {
        g = merge(shell, lip, hem);
    }
} else {
    var dprof = [];
    dprof = append(dprof, (LED_BAND_TOP - 6, 0));
    dprof = append(dprof, (LED_BAND_TOP - 6, DOME_R));
    for i in 0..10 {
        let th = i * 90 / 10;
        dprof = append(dprof, (LED_BAND_TOP + dome_h * pow(sin(th), 2 / dome_n), DOME_R * pow(cos(th), 2 / dome_n)));
    }
    dprof = append(dprof, (DOME_TOP, 0));
    g = translate(lathe_z(profile: dprof, segments: 32, material: "ST_Gold"), (cx, cy, 0));
}
out.geo = g;
#end

// ---------- lantern + spire + orb + aviation lamp + spike; tip exactly DOME_TIP ----------
// Fixed head under DOME_TIP (88 cm): orb r 20 (centre DOME_TIP - 70), warm lamp r 10 (centre DOME_TIP - 42), 34 cm spike.
// Stack below it (QC P1/P4 calibration, 392 cm at lk = 1): base ring 25 (sunk 20 into the crown), lantern drum 120
// (warm-lit core + 8 gold posts), cap 14, cupola 55, slender spire ~178. lk scales the stack to the defs span.
// az is always passed by CROWN_Upper. lvl (detail 1 only): 0 = LOD0; 1 = LOD1 / 2 = LOD2 keep every piece, profile and
// height with fewer sides. detail 0 (LOD3): 8-sided drum + cone.
#meshpart CROWN_Lantern
param detail = 1;
param az = 0;
param lvl = 0;
let cx = DOME_C.x;
let cy = DOME_C.y;
let head = 88;
let lk = clamp((DOME_TIP - DOME_TOP - head) / 392, 0.3, 1.5);
let zl0 = DOME_TOP + 25 * lk;
let zl1 = zl0 + 120 * lk;
let zl2 = zl1 + 14 * lk;
let zl3 = zl2 + 55 * lk;
let z_orb = DOME_TIP - 70;
let z_lamp = DOME_TIP - 42;
var g = empty();
if detail > 0 {
    let s32 = pick(lvl, 32, 16, 12);
    let s24 = pick(lvl, 24, 12, 10);
    let s16 = pick(lvl, 16, 10, 8);
    let s12 = pick(lvl, 12, 8, 6);
    let s8 = pick(lvl, 8, 6, 4);
    var posts = empty();
    for k in 0..8 {
        let a = az + 22.5 + k * 45;
        posts = merge(posts, cylinder_at(radius: 8, height: zl1 - zl0 + 2, bottom_center: (cx + 70 * cos(a), cy + 70 * sin(a), zl0 - 1), segments: s8, material: "ST_Gold"));
    }
    g = merge(
        translate(lathe_z(profile: [(DOME_TOP - 20, 0), (DOME_TOP - 20, 110), (zl0 - 10 * lk, 110), (zl0, 98), (zl0, 0)], segments: s32, material: "ST_Gold"), (cx, cy, 0)),
        cylinder_at(radius: 62, height: zl1 - zl0 + 4, bottom_center: (cx, cy, zl0 - 2), segments: s24, material: "ST_DrumGlass"),
        posts,
        cylinder_at(radius: 95, height: zl2 - zl1, bottom_center: (cx, cy, zl1), segments: s32, material: "ST_Gold"),
        translate(lathe_z(profile: [(zl2 - 1, 0), (zl2 - 1, 82), (zl2 + 14 * lk, 76), (zl2 + 30 * lk, 58), (zl2 + 44 * lk, 34), (zl3, 16), (zl3, 0)], segments: s24, material: "ST_Gold"), (cx, cy, 0)),
        cylinder_at(r_bot: 14, r_top: 4, height: (z_orb - 18) - (zl3 - 6), bottom_center: (cx, cy, zl3 - 6), segments: s12, material: "ST_Gold"),
        sphere_center(radius: 20, center: (cx, cy, z_orb), segments: s16, material: "ST_Gold"),
        sphere_center(radius: 10, center: (cx, cy, z_lamp), segments: s12, material: "ST_WarmLight"),
        cylinder_at(r_bot: 4, r_top: 0, height: DOME_TIP - (z_lamp + 8), bottom_center: (cx, cy, z_lamp + 8), segments: s8, material: "ST_Gold"));
} else {
    g = merge(
        cylinder_at(radius: 90, height: zl2 - (DOME_TOP - 20), bottom_center: (cx, cy, DOME_TOP - 20), segments: 8, material: "ST_Gold"),
        cylinder_at(r_bot: 18, r_top: 0, height: DOME_TIP - (zl2 - 2), bottom_center: (cx, cy, zl2 - 2), segments: 6, material: "ST_Gold"));
}
out.geo = g;
#end

// ---------- drum + LED band + dome + lantern: the ONE home of the crown's photo constants ----------
// detail 1 (LOD0): stylobate, 12 pairs of columns (24), column-base uplights, glazing + mullions + trim rings,
//   entablature + modillions, 8 floodlight fixtures, LED band, gored dome, lantern. piece = "drum" | "led" | "dome" |
//   "lantern" | "all" picks the sub-assembly (LOD0 calls each for a readable parts_log).
//   lvl (detail 1 only, passed on to the column / LED / dome / lantern parts): 0 = LOD0; 1 = LOD1 (every piece kept:
//   32-sided stylobate / trims, 40-sided entablature, 10-sided columns); 2 = LOD2 (8-sided column prisms, 32-sided
//   stylobate / glass / trims, 40-sided entablature, no modillions / floodlight fixtures).
// detail 0 (LOD3): stylobate, glazed core, 24 column boxes on the LOD0 column centres, entablature drum, LED band,
//   smooth dome, lantern + spire.
// detail -1: a 2 cm probe box centred on floodlight 0's emitter point. Emitter sockets are mesh-level statements, so
//   LOD0 reads azimuth / radius / height of its 8 DomeUp sockets back from this probe instead of re-typing them.
#meshpart CROWN_Upper
param detail = 1;
param piece = "all";
param lvl = 0;
let cx = DOME_C.x;
let cy = DOME_C.y;
let az_view = 132;                   // math azimuth of the photo-1 line of sight (bearing 318): a wide bay faces it
let n_flute = 28;                    // dome gores = LED panels (P1: ~13-14 across the visible half)
let ent_h = 270;                     // entablature depth FIXED (D4 a, P1: 11 px ~2.6-2.7 m); columns take the rest of the drum
let es = ent_h / 300;                // profile scale of the entablature mouldings (designed at 300 cm)
let zsty = DRUM_BASE + 64;           // stylobate top = column base
let zarch = DRUM_TOP - ent_h;        // entablature soffit (architrave bottom); column abacus tops at zarch + 2
let rc = DRUM_R - 110;               // column centre radius: corona (DRUM_R + 40) overhangs the shaft faces ~95 cm (P1)
let rglass = DRUM_R - 250;           // drum glazing radius (>= 70 cm inside the plinths / abaci)
let r_fx = DRUM_R + 12;              // floodlight fixtures on the corona's outer edge
let z_fx = DRUM_TOP + 60;            // floodlight emitter point, 4 cm above the fixture heads
let w_drum = (piece == "all") + (piece == "drum");
let w_led = (piece == "all") + (piece == "led");
let w_dome = (piece == "all") + (piece == "dome");
let w_lan = (piece == "all") + (piece == "lantern");
var g = empty();
if detail < 0 {
    g = box_center(size: (2, 2, 2), center: (cx + r_fx * cos(az_view + 22.5), cy + r_fx * sin(az_view + 22.5), z_fx), material: "ST_DarkMetal");
} else if detail > 0 {
    if w_drum > 0 {
        let sseg = pick(lvl, 64, 32, 32);
        let stylobate = merge(
            cylinder_at(radius: DRUM_R + 80, height: 34, bottom_center: (cx, cy, DRUM_BASE - 2), segments: sseg, material: "ST_Stone"),
            cylinder_at(radius: DRUM_R + 40, height: 34, bottom_center: (cx, cy, DRUM_BASE + 30), segments: sseg, material: "ST_Stone"));
        let col = part(CROWN_Column, zb: zsty, zt: zarch, r: 55, lvl: lvl);
        // cyan uplight box in front of every column base (P4: the shafts read cyan at dusk), on the stylobate top
        let uplight = box_at(size: (40, 60, 40), bottom_center: (87, 0, zsty - 2), material: "ST_BlueLED");
        var columns = empty();
        var col_lights = empty();
        for k in 0..12 {
            for s in 0..2 {
                let a = az_view + 15 + k * 30 + (s * 2 - 1) * 5.5;
                columns = merge(columns, translate(rotate_z(col, degrees: a, pivot: (0, 0, 0)), (cx + rc * cos(a), cy + rc * sin(a), 0)));
                col_lights = merge(col_lights, translate(rotate_z(uplight, degrees: a, pivot: (0, 0, 0)), (cx + rc * cos(a), cy + rc * sin(a), 0)));
            }
        }
        let drum_glass = cylinder_at(radius: rglass, height: zarch + 5 - (zsty - 2), bottom_center: (cx, cy, zsty - 2), segments: pick(lvl, 48, 48, 32), material: "ST_DrumGlass");
        var mullions = empty();
        for k in 0..24 {
            let a = az_view + k * 15;
            mullions = merge(mullions, beam_between(start: (cx + (rglass - 4) * cos(a), cy + (rglass - 4) * sin(a), (zsty + zarch) * 0.5), end: (cx + (rglass + 12) * cos(a), cy + (rglass + 12) * sin(a), (zsty + zarch) * 0.5), cross_width: 16, cross_height: zarch - zsty, height_direction: (0, 0, 1), material: "ST_Facade"));
        }
        let tseg = pick(lvl, 48, 32, 32);
        let drum_trim = merge(
            part(CROWN_Ring, cx: cx, cy: cy, z0: zsty - 2, z1: zsty + 38, r_in: rglass - 10, r_out: rglass + 22, seg: tseg, mat: "ST_Facade"),
            part(CROWN_Ring, cx: cx, cy: cy, z0: zarch - 260, z1: zarch - 246, r_in: rglass - 6, r_out: rglass + 10, seg: tseg, mat: "ST_Facade"));
        // architrave zarch -> +115 (two fascias, step at +60, taenia), frieze +115 -> +200 at DRUM_R - 5,
        // bed moulding, corona face at DRUM_R + 40, cymatium to DRUM_TOP (QC r2 profile)
        let entablature = translate(lathe_z(profile: [
            (zarch, rglass - 20), (zarch, DRUM_R - 5), (zarch + 60 * es, DRUM_R - 5), (zarch + 60 * es, DRUM_R + 5),
            (zarch + 102 * es, DRUM_R + 5), (zarch + 102 * es, DRUM_R + 15), (zarch + 115 * es, DRUM_R + 15),
            (zarch + 115 * es, DRUM_R - 5), (zarch + 200 * es, DRUM_R - 5), (zarch + 200 * es, DRUM_R + 10),
            (zarch + 214 * es, DRUM_R + 22), (zarch + 219 * es, DRUM_R + 40), (zarch + 272 * es, DRUM_R + 40),
            (DRUM_TOP, DRUM_R + 28), (DRUM_TOP, rglass - 20), (zarch, rglass - 20)], segments: pick(lvl, 64, 40, 40), material: "ST_Facade"), (cx, cy, 0));
        // cornice modillions under the corona (96 brackets, tops 1 cm into the corona soffit; none at LOD2)
        var modillions = empty();
        for k in 0..(pick(lvl, 96, 96, 0)) {
            let a = az_view + k * 3.75;
            modillions = merge(modillions, beam_between(start: (cx + (DRUM_R + 6) * cos(a), cy + (DRUM_R + 6) * sin(a), zarch + 210 * es), end: (cx + (DRUM_R + 34) * cos(a), cy + (DRUM_R + 34) * sin(a), zarch + 210 * es), cross_width: 18, cross_height: 18, height_direction: (0, 0, 1), material: "ST_Facade"));
        }
        // eight dark floodlight fixtures on the corona's outer edge, 45 deg apart and 22.5 deg off the photo-1 sightline:
        // base, stem and a lamp head just under the DomeUp emitter point (z_fx)
        var flood_fx = empty();
        for k in 0..(pick(lvl, 8, 8, 0)) {
            let a = az_view + 22.5 + k * 45;
            flood_fx = merge(flood_fx, translate(rotate_z(merge(
                box_at(size: (30, 34, 14), bottom_center: (0, 0, DRUM_TOP - 2), material: "ST_DarkMetal"),
                box_at(size: (8, 8, 30), bottom_center: (0, 0, DRUM_TOP + 10), material: "ST_DarkMetal"),
                box_at(size: (20, 28, 18), bottom_center: (-3, 0, z_fx - 22), material: "ST_DarkMetal")), degrees: a, pivot: (0, 0, 0)), (cx + r_fx * cos(a), cy + r_fx * sin(a), 0)));
        }
        g = merge(g, stylobate, columns, col_lights, drum_glass, mullions, drum_trim, entablature, modillions, flood_fx);
    }
    if w_led > 0 {
        g = merge(g, part(CROWN_LedBand, detail: 1, az: az_view, lvl: lvl));
    }
    if w_dome > 0 {
        g = merge(g, part(CROWN_Dome, detail: 1, az: az_view, nfl: n_flute, lvl: lvl));
    }
    if w_lan > 0 {
        g = merge(g, part(CROWN_Lantern, detail: 1, az: az_view, lvl: lvl));
    }
} else {
    let stylobate = cylinder_at(radius: DRUM_R + 80, height: 66, bottom_center: (cx, cy, DRUM_BASE - 2), segments: 24, material: "ST_Stone");
    let drum_core = cylinder_at(radius: rglass, height: DRUM_TOP - DRUM_BASE, bottom_center: (cx, cy, DRUM_BASE - 2), segments: 24, material: "ST_DrumGlass");
    let col_box = box_at(size: (110, 110, zarch - DRUM_BASE), bottom_center: (0, 0, DRUM_BASE), material: "ST_Stone");
    var cols = empty();
    for k in 0..12 {
        for s in 0..2 {
            let a = az_view + 15 + k * 30 + (s * 2 - 1) * 5.5;
            cols = merge(cols, translate(rotate_z(col_box, degrees: a, pivot: (0, 0, 0)), (cx + rc * cos(a), cy + rc * sin(a), 0)));
        }
    }
    let entab = cylinder_at(radius: DRUM_R + 30, height: ent_h, bottom_center: (cx, cy, zarch), segments: 32, material: "ST_Facade");
    g = merge(stylobate, drum_core, cols, entab,
        part(CROWN_LedBand, detail: 0, az: az_view),
        part(CROWN_Dome, detail: 0, az: az_view, nfl: n_flute),
        part(CROWN_Lantern, detail: 0, az: az_view));
}
out.geo = g;
#end

// ---------- Sky Bar + stair + terrace balustrade: the ONE home of the stair-frame derivation ----------
// Stair axis: from the terrace corner pc nearest SKYBAR_C, searched over -20..+20 deg about the Sky Bar centre line.
//   Hard: both cheek walls enter the platform 40 cm inside its rim. Score (lowest wins): the two terrace edges at pc on
//   opposite sides of the axis and neither running forward along it (1e7 each), flight foot + cheek ends >= bar_r + 18
//   + 80 from SKYBAR_C (1e4 per cm short), then the cheek entry points as deep inside MAIN_FP as possible.
// Stair head (round 4, D4 c - robust for any SKYBAR_C within 3 m): per side, the terrace edge at pc either ENTERS the
//   cheek wall directly (|w| >= 0.5 = >= 30 deg off the axis, its cheek-face crossing within s_ret behind the head and
//   >= 40 cm before the next ROOFDECK_FP vertex): balustrade ends on the cheek centre line, cheek starts 40 cm past the
//   crossing; or it is near-parallel / oblique (RETURN mode): cheek starts at -(s_ret + 20), a short return balustrade
//   on the line s = -s_ret closes the guard from the edge's balustrade line to the cheek. Every edge parameter is
//   clamped to [20, edge - 40], so nothing extrapolates past the adjacent vertices. Head landing = the deck-level slab
//   [-(s_ret + 20), s_h + 2] x [-hw, hw] in the stair frame MINUS the terrace prism (exact boolean): it never overlaps
//   the deck and always meets both cheek inner faces. s_h > 0 only if an edge runs forward into the stair band.
// The balustrade runs (ra -> rb, start-post flags rs) are built once and drive LOD0 (mode 2) and the collider (mode 1).
// mode 2 (LOD0, piece = "bal" | "tables" | "platform" | "stair" | "all"): terrace balustrade + returns, Sirocco tables,
//   Sky Bar platform (slab, clipped soffit, deck, curb, rail, island bar, stools), stair, head landing, cheek walls.
//   lvl (mode 2 only): 0 = LOD0; 1 = LOD1 (the same balusters / lamps / rail posts as flat boxes, simplified tables and
//   stools, 32-sided platform / bar, 24-sided rail tubes); 2 = LOD2 (solid balustrade panels between the posts, no
//   lamps / tables / stools, one solid dark rail band on the Sky Bar rim). Stair, landing and cheek walls identical at
//   all three levels; every level uses the same runs, arcs and radii.
// mode 0 (LOD3): head landing, sloped stair block, platform disc, blue bar ring + counter.
// mode 1 (collider): stair ramp, head landing, cheek walls, platform disc, rim barrier (open at the stair), island bar,
//   one box per balustrade run (terrace edges + returns, open at the stair head).
#meshpart CROWN_SkyBarLink
param mode = 2;
param piece = "all";
param lvl = 0;
let hw = 150;                        // stair half width
let ct = 25;                         // stair cheek wall thickness
let s_ret = 100;                     // return-guard line behind the stair head (RETURN-mode sides)
let w_enter = 0.5;                   // an edge enters a cheek directly only when >= 30 deg off the axis
let sx = SKYBAR_C.x;
let sy = SKYBAR_C.y;
let SR = SKYBAR_R;
let zr = MAIN_ROOF - 2;              // stair / landing / cheek base, embedded 2 cm in the main roof
let zt = ROOFDECK_TOP;               // Sirocco terrace deck
let zsd = MAIN_ROOF + 150;           // Sky Bar deck top
let bar_r = SR * 0.65;               // island bar outer radius (P4: blue bar ring ~0.67 x the platform diameter)
let clr = bar_r + 18 + 80;           // flight foot / cheek ends: >= 80 cm clear of the counter top (r bar_r + 18)
let nfp = len(ROOFDECK_FP);
let nmf = len(MAIN_FP);
// stair head = terrace corner nearest the Sky Bar, and its two edges (clamped use only, never extrapolated)
var ks = 0;
var kd = 1000000000;
for i in 0..nfp {
    let p = at(ROOFDECK_FP, i);
    let d = sqrt((p.x - sx) * (p.x - sx) + (p.y - sy) * (p.y - sy));
    if d < kd {
        kd = d;
        ks = i;
    }
}
let pc = at(ROOFDECK_FP, ks);
let kprev = mod(ks + nfp - 1, nfp);
let knext = mod(ks + 1, nfp);
let pp = at(ROOFDECK_FP, kprev);
let pn = at(ROOFDECK_FP, knext);
let lpp = sqrt((pp.x - pc.x) * (pp.x - pc.x) + (pp.y - pc.y) * (pp.y - pc.y));
let lpn = sqrt((pn.x - pc.x) * (pn.x - pc.x) + (pn.y - pc.y) * (pn.y - pc.y));
let epx = (pp.x - pc.x) / lpp;
let epy = (pp.y - pc.y) / lpp;
let enx = (pn.x - pc.x) / lpn;
let eny = (pn.y - pc.y) / lpn;
// stair axis search (see header)
let a0 = atan2(sy - pc.y, sx - pc.x);
var phi_s = 0;
var score_s = 1000000000000;
for k in 0..41 {
    let au = a0 - 20 + k;
    let uxk = cos(au);
    let uyk = sin(au);
    let nxk = 0 - uyk;
    let nyk = uxk;
    let cax_k = (sx - pc.x) * uxk + (sy - pc.y) * uyk;
    let clat_k = (sx - pc.x) * nxk + (sy - pc.y) * nyk;
    let qa = (SR - 40) * (SR - 40) - (clat_k - hw - ct) * (clat_k - hw - ct);
    let qb = (SR - 40) * (SR - 40) - (clat_k + hw + ct) * (clat_k + hw + ct);
    if (qa > 0) * (qb > 0) > 0 {
        let se_k = max(cax_k - sqrt(SR * SR - (clat_k - hw) * (clat_k - hw)), cax_k - sqrt(SR * SR - (clat_k + hw) * (clat_k + hw))) + 12;
        let lx = max(0, abs(clat_k) - hw);
        var fc = sqrt((cax_k - se_k) * (cax_k - se_k) + lx * lx);
        var worst = -1000000000;
        for side in 0..2 {
            let lm = (side * 2 - 1) * (hw + ct * 0.5);
            let ce_k = max(se_k + 6, cax_k - sqrt((SR - 40) * (SR - 40) - (lm - clat_k) * (lm - clat_k)));
            fc = min(fc, sqrt((cax_k - ce_k) * (cax_k - ce_k) + (lm - clat_k) * (lm - clat_k)));
            let lc = (side * 2 - 1) * (hw + ct);
            let se2 = cax_k - sqrt(SR * SR - (clat_k - lc) * (clat_k - lc));
            let qx = pc.x + uxk * se2 + nxk * lc;
            let qy = pc.y + uyk * se2 + nyk * lc;
            for e in 0..nmf {
                let m1 = at(MAIN_FP, e);
                let m2 = at(MAIN_FP, mod(e + 1, nmf));
                let mlen = sqrt((m2.x - m1.x) * (m2.x - m1.x) + (m2.y - m1.y) * (m2.y - m1.y));
                worst = max(worst, ((m2.y - m1.y) * (qx - m1.x) - (m2.x - m1.x) * (qy - m1.y)) / mlen);
            }
        }
        let wpk = epx * nxk + epy * nyk;
        let wnk = enx * nxk + eny * nyk;
        let dpk = epx * uxk + epy * uyk;
        let dnk = enx * uxk + eny * uyk;
        let score = 10000000 * (wpk * wnk >= 0) + 10000000 * (max(dpk, dnk) > 0) + 10000 * max(0, clr - fc) + worst;
        if score < score_s {
            score_s = score;
            phi_s = k - 20;
        }
    }
}
let sa = a0 + phi_s;
let sux = cos(sa);                     // stair axis (down toward the Sky Bar)
let suy = sin(sa);
let snx = 0 - suy;                     // stair lateral axis
let sny = sux;
let cax = (sx - pc.x) * sux + (sy - pc.y) * suy;     // Sky Bar centre in the stair frame
let clat = (sx - pc.x) * snx + (sy - pc.y) * sny;
let wp = epx * snx + epy * sny;        // lateral / axial components of the two terrace edges at the corner
let dp = epx * sux + epy * suy;
let wn = enx * snx + eny * sny;
let dn = enx * sux + eny * suy;
let sp_sign = select(select(1, -1, wn >= 0), sign(wp), wp != 0);
let sn_sign = 0 - sp_sign;
// head line: 0, or past an edge that runs forward into the stair band (fallback configurations only)
let fwd_p = select(0, dp * min((hw + ct) / max(abs(wp), 0.05), lpp), dp > 0);
let fwd_n = select(0, dn * min((hw + ct) / max(abs(wn), 0.05), lpn), dn > 0);
let s_h = min(max(fwd_p, fwd_n), 150);
// flight ends 12 cm inside the platform edge; curb / rail open between g1 and g2 (curb ends 2 cm into the cheeks)
let s_end = max(cax - sqrt(max(0, SR * SR - (clat - hw) * (clat - hw))), cax - sqrt(max(0, SR * SR - (clat + hw) * (clat + hw)))) + 12;
let r_cb = SR - 12.5;
let lg = hw + ct - 2;
let g1 = sa + 180 + asin(clamp((lg + clat) / r_cb, -1, 1));
let g2 = sa + 180 - asin(clamp((lg - clat) / r_cb, -1, 1)) + 360;
// terrace balustrade line: ROOFDECK_FP inset 20 cm (mitred)
var rail_q = [];
for i in 0..nfp {
    let p0 = at(ROOFDECK_FP, mod(i + nfp - 1, nfp));
    let p1 = at(ROOFDECK_FP, i);
    let p2 = at(ROOFDECK_FP, mod(i + 1, nfp));
    let l1 = sqrt((p1.x - p0.x) * (p1.x - p0.x) + (p1.y - p0.y) * (p1.y - p0.y));
    let l2 = sqrt((p2.x - p1.x) * (p2.x - p1.x) + (p2.y - p1.y) * (p2.y - p1.y));
    let n1x = 0 - (p1.y - p0.y) / l1;
    let n1y = (p1.x - p0.x) / l1;
    let n2x = 0 - (p2.y - p1.y) / l2;
    let n2y = (p2.x - p1.x) / l2;
    let mx = n1x + n2x;
    let my = n1y + n2y;
    let ml = sqrt(mx * mx + my * my);
    let k = 20 / ((mx / ml) * n1x + (my / ml) * n1y);
    rail_q = append(rail_q, (p1.x + mx / ml * k, p1.y + my / ml * k));
}
let q0 = at(rail_q, ks);
let qn1 = at(rail_q, knext);
let qp1 = at(rail_q, kprev);
let lq_n = sqrt((qn1.x - q0.x) * (qn1.x - q0.x) + (qn1.y - q0.y) * (qn1.y - q0.y));
let lq_p = sqrt((qp1.x - q0.x) * (qp1.x - q0.x) + (qp1.y - q0.y) * (qp1.y - q0.y));
let ax_q = (q0.x - pc.x) * sux + (q0.y - pc.y) * suy;
let lat_q = (q0.x - pc.x) * snx + (q0.y - pc.y) * sny;
// ---- side p (edge ks -> ks-1): guarded + clamped
let wq_p = ((qp1.x - q0.x) * snx + (qp1.y - q0.y) * sny) / lq_p * sp_sign;
let dq_p = ((qp1.x - q0.x) * sux + (qp1.y - q0.y) * suy) / lq_p;
let to_p = (hw + ct) / max(wp * sp_sign, 0.05);          // along the edge to the cheek outer face
let so_p = dp * to_p;
let ent_p = (wp * sp_sign >= w_enter) * (to_p <= lpp - 40) * (so_p >= 0 - s_ret);
let gap_p = clamp(((hw + ct * 0.5) - sp_sign * lat_q) / max(wq_p, 0.05), 20, lq_p - 40);
let tr_p = clamp(select(20, (0 - s_ret - ax_q) / min(dq_p, -0.05), dq_p < -0.05), 20, lq_p - 40);
let tb_p = select(tr_p, gap_p, ent_p);
let bal_b = (q0.x + (qp1.x - q0.x) / lq_p * tb_p, q0.y + (qp1.y - q0.y) / lq_p * tb_p, 0);   // end of run kprev
let ds_p = min(select(0 - s_ret - 20, so_p - 40, ent_p), s_h - 20);                              // cheek back end
let lm_p = sp_sign * (hw + ct * 0.5);
let rc_p = (pc.x - sux * s_ret + snx * lm_p, pc.y - suy * s_ret + sny * lm_p, 0);                // return end
let ret_p = (1 - ent_p) * (sqrt((rc_p.x - bal_b.x) * (rc_p.x - bal_b.x) + (rc_p.y - bal_b.y) * (rc_p.y - bal_b.y)) >= 20);
// ---- side n (edge ks -> ks+1): guarded + clamped
let wq_n = ((qn1.x - q0.x) * snx + (qn1.y - q0.y) * sny) / lq_n * sn_sign;
let dq_n = ((qn1.x - q0.x) * sux + (qn1.y - q0.y) * suy) / lq_n;
let to_n = (hw + ct) / max(wn * sn_sign, 0.05);
let so_n = dn * to_n;
let ent_n = (wn * sn_sign >= w_enter) * (to_n <= lpn - 40) * (so_n >= 0 - s_ret);
let gap_n = clamp(((hw + ct * 0.5) - sn_sign * lat_q) / max(wq_n, 0.05), 20, lq_n - 40);
let tr_n = clamp(select(20, (0 - s_ret - ax_q) / min(dq_n, -0.05), dq_n < -0.05), 20, lq_n - 40);
let tb_n = select(tr_n, gap_n, ent_n);
let bal_a = (q0.x + (qn1.x - q0.x) / lq_n * tb_n, q0.y + (qn1.y - q0.y) / lq_n * tb_n, 0);   // start of run ks
let ds_n = min(select(0 - s_ret - 20, so_n - 40, ent_n), s_h - 20);
let lm_n = sn_sign * (hw + ct * 0.5);
let rc_n = (pc.x - sux * s_ret + snx * lm_n, pc.y - suy * s_ret + sny * lm_n, 0);
let ret_n = (1 - ent_n) * (sqrt((rc_n.x - bal_a.x) * (rc_n.x - bal_a.x) + (rc_n.y - bal_a.y) * (rc_n.y - bal_a.y)) >= 20);
// ---- balustrade runs (every terrace edge; the two at pc clamped to the opening; plus the returns)
var ra = [];
var rb = [];
var rs = [];
for e in 0..nfp {
    let qa = at(rail_q, e);
    let qb = at(rail_q, mod(e + 1, nfp));
    let is_first = e == ks;
    let is_last = e == kprev;
    ra = append(ra, (select(qa.x, bal_a.x, is_first), select(qa.y, bal_a.y, is_first), 0));
    rb = append(rb, (select(qb.x, bal_b.x, is_last), select(qb.y, bal_b.y, is_last), 0));
    rs = append(rs, 1 - is_first);
}
if ret_p > 0 {
    ra = append(ra, bal_b);
    rb = append(rb, rc_p);
    rs = append(rs, 1);
}
if ret_n > 0 {
    ra = append(ra, bal_a);
    rb = append(rb, rc_n);
    rs = append(rs, 1);
}
let n_run = len(ra);
// ---- head landing: deck-level slab behind the stair head minus the terrace prism (never on the deck)
let lb = 0 - s_ret - 20;
let lf = s_h + 2;
let land_blank = translate(extrude(points: [
    (pc.x + sux * lb - snx * hw, pc.y + suy * lb - sny * hw), (pc.x + sux * lf - snx * hw, pc.y + suy * lf - sny * hw),
    (pc.x + sux * lf + snx * hw, pc.y + suy * lf + sny * hw), (pc.x + sux * lb + snx * hw, pc.y + suy * lb + sny * hw)], height: zt - zr, material: "ST_Stone"), (0, 0, zr));
let land_cut = translate(extrude(points: ROOFDECK_FP, height: zt - zr + 20, material: "ST_Stone"), (0, 0, zr - 10));
let landing = boolean(land_blank, land_cut, op: "difference", solver: "exact");
// ---- solid white cheek walls (P4 white stair enclosure): from ds (40 cm past the edge crossing, or 20 cm behind the
// return line) to 40 cm inside the rim; top deck + 120 behind the head (balustrade rails / plinths end inside the wall,
// 10 cm below its top), sloping to 125 cm above the platform deck at the platform end (Sky Bar rails embed >= 20 cm)
let ce_p = max(s_end + 6, cax - sqrt(max(0, (SR - 40) * (SR - 40) - (lm_p - clat) * (lm_p - clat))));
let ce_n = max(s_end + 6, cax - sqrt(max(0, (SR - 40) * (SR - 40) - (lm_n - clat) * (lm_n - clat))));
let cheek_p = extrude_loop(points: [
    (pc.x + sux * ds_p + snx * sp_sign * hw, pc.y + suy * ds_p + sny * sp_sign * hw, zr),
    (pc.x + sux * ce_p + snx * sp_sign * hw, pc.y + suy * ce_p + sny * sp_sign * hw, zr),
    (pc.x + sux * ce_p + snx * sp_sign * hw, pc.y + suy * ce_p + sny * sp_sign * hw, zsd + 125),
    (pc.x + sux * s_h + snx * sp_sign * hw, pc.y + suy * s_h + sny * sp_sign * hw, zt + 120),
    (pc.x + sux * ds_p + snx * sp_sign * hw, pc.y + suy * ds_p + sny * sp_sign * hw, zt + 120)], offset: (snx * sp_sign * ct, sny * sp_sign * ct, 0), material: "ST_Facade");
let cheek_n = extrude_loop(points: [
    (pc.x + sux * ds_n + snx * sn_sign * hw, pc.y + suy * ds_n + sny * sn_sign * hw, zr),
    (pc.x + sux * ce_n + snx * sn_sign * hw, pc.y + suy * ce_n + sny * sn_sign * hw, zr),
    (pc.x + sux * ce_n + snx * sn_sign * hw, pc.y + suy * ce_n + sny * sn_sign * hw, zsd + 125),
    (pc.x + sux * s_h + snx * sn_sign * hw, pc.y + suy * s_h + sny * sn_sign * hw, zt + 120),
    (pc.x + sux * ds_n + snx * sn_sign * hw, pc.y + suy * ds_n + sny * sn_sign * hw, zt + 120)], offset: (snx * sn_sign * ct, sny * sn_sign * ct, 0), material: "ST_Facade");
let w_bal = (piece == "all") + (piece == "bal");
let w_tab = ((piece == "all") + (piece == "tables")) * (lvl < 2);
let w_plat = (piece == "all") + (piece == "platform");
let w_stair = (piece == "all") + (piece == "stair");
var g = empty();
if mode == 2 {
    if w_bal > 0 {
        // terrace balustrade on the 20 cm inset line + the return guards, open at the stair head
        var terrace_bal = empty();
        for i in 0..n_run {
            let a = at(ra, i);
            let b = at(rb, i);
            terrace_bal = merge(terrace_bal, part(CROWN_Balustrade, ax: a.x, ay: a.y, bx: b.x, by: b.y, z: zt, h: 110, post_sp: 250, bal_sp: 30, start_post: at(rs, i), end_post: 0, lamp_every: pick(lvl, 2, 2, 0), lvl: lvl));
        }
        g = merge(g, terrace_bal);
    }
    if w_tab > 0 {
        // Sirocco tables on the NW / W deck along the terrace's west edge (vertex ks -> ks+1), white tops, warm lamps;
        // grid in the stair-corner frame, >= 60 cm clear of the stylobate (DRUM_R + 80), the balustrade and the stair head
        var table = empty();
        if lvl < 1 {
            table = merge(
                cylinder_at(radius: 30, height: 4, bottom_center: (0, 0, zt - 1), segments: 10, material: "ST_DarkMetal"),
                cylinder_at(radius: 5, height: 70, bottom_center: (0, 0, zt + 2), segments: 8, material: "ST_DarkMetal"),
                cylinder_at(r_bot: 44, r_top: 46, height: 6, bottom_center: (0, 0, zt + 70), segments: 16, material: "ST_Stone"),
                cylinder_at(r_bot: 5, r_top: 6, height: 11, bottom_center: (0, 0, zt + 75), segments: 8, material: "ST_WarmLight"));
        } else {
            // LOD1: square stem from 1 cm under the deck (no foot disc), 8-sided top, lamp block; same heights
            table = merge(
                box_at(size: (10, 10, 73), bottom_center: (0, 0, zt - 1), material: "ST_DarkMetal"),
                cylinder_at(r_bot: 44, r_top: 46, height: 6, bottom_center: (0, 0, zt + 70), segments: 8, material: "ST_Stone"),
                box_at(size: (11, 11, 11), bottom_center: (0, 0, zt + 75), material: "ST_WarmLight"));
        }
        var terrace_tables = empty();
        for i in 0..2 {
            for j in 0..18 {
                let ta = 150 + i * 170;
                let tb = 330 + j * 180;
                let tx = pc.x + epx * ta + enx * tb;
                let ty = pc.y + epy * ta + eny * tb;
                let tdd = sqrt((tx - DOME_C.x) * (tx - DOME_C.x) + (ty - DOME_C.y) * (ty - DOME_C.y));
                let tlat = abs((tx - pc.x) * snx + (ty - pc.y) * sny);
                if tdd >= DRUM_R + 186 {
                    if tlat >= hw + ct + 110 {
                        if tb <= lpn - 140 {
                            terrace_tables = merge(terrace_tables, translate(table, (tx, ty, 0)));
                        }
                    }
                }
            }
        }
        g = merge(g, terrace_tables);
    }
    if w_plat > 0 {
        // slab bottom MAIN_ROOF - 40 sits inside the main roof slab; the soffit cone (MAIN_ROOF - 75 ->) is clipped to the
        // cantilever + the main cornice-ring band (outside offset(MAIN_FP, -60)), so nothing hangs into the top storey
        // (lvl 1 / 2: same profiles and arcs, fewer sides / samples)
        let pseg = pick(lvl, 64, 32, 32);
        let sb_slab = translate(lathe_z(profile: [(zsd - 190, 0), (zsd - 190, SR), (zsd - 105, SR), (zsd - 105, SR - 22), (zsd - 85, SR - 22), (zsd - 85, SR), (zsd - 8, SR), (zsd - 8, 0)], segments: pseg, material: "ST_Facade"), (sx, sy, 0));
        let soffit_full = translate(lathe_z(profile: [(MAIN_ROOF - 75, 0), (MAIN_ROOF - 75, SR - 200), (zsd - 186, SR - 44), (zsd - 186, 0)], segments: pseg, material: "ST_FacadeShade"), (sx, sy, 0));
        let soffit_cut = translate(extrude(points: offset_polygon(points: MAIN_FP, delta: -60), height: 300, material: "ST_FacadeShade"), (0, 0, MAIN_ROOF - 200));
        let sb_soffit = boolean(soffit_full, soffit_cut, op: "difference", solver: "exact");
        let sb_deck = cylinder_at(radius: SR - 15, height: 20, bottom_center: (sx, sy, zsd - 20), segments: pseg, material: "ST_FacadeShade");
        // rim curb / rail open at the stair: the curb ends embed 2 cm into the cheek walls' outer faces
        let sb_curb = sweep_box_path(points: arc_points(center: (sx, sy, zsd - 8 + 30), radius: r_cb, start_degrees: g1, end_degrees: g2, count: pick(lvl, 56, 28, 20), plane: "xy"), width: 25, height: 60, up: (0, 0, 1), material: "ST_Facade");
        var rail_post = empty();
        if lvl < 1 {
            rail_post = cylinder_at(radius: 3.5, height: 66, bottom_center: (0, 0, zsd + 50), segments: 6, material: "ST_DarkMetal");
        } else {
            rail_post = box_at(size: (7, 7, 66), bottom_center: (0, 0, zsd + 50), material: "ST_DarkMetal");
        }
        let n_rpost = max(8, round((g2 - g1) * 3.14159 / 180 * (SR - 12) / 70));
        let sb_posts = copy_to_points(rail_post, points: arc_points(center: (sx, sy, 0), radius: SR - 12, start_degrees: g1 + 1, end_degrees: g2 - 1, count: n_rpost, plane: "xy"));
        let sb_rails = merge(
            torus_center(major_radius: SR - 12, tube_radius: 4, segments: pick(lvl, 64, 24, 24), tube_segments: pick(lvl, 6, 4, 4), start_degrees: g1, end_degrees: g2, center: (sx, sy, zsd + 114), material: "ST_DarkMetal"),
            torus_center(major_radius: SR - 12, tube_radius: 2.5, segments: pick(lvl, 64, 24, 24), tube_segments: pick(lvl, 5, 4, 4), start_degrees: g1, end_degrees: g2, center: (sx, sy, zsd + 84), material: "ST_DarkMetal"));
        // island bar: white counter ring with a blue-lit outer fascia (P4), dark counter top, back-bar column + canopy
        let bseg = pick(lvl, 32, 16, 16);
        let sb_bar = merge(
            part(CROWN_Ring, cx: sx, cy: sy, z0: zsd - 4, z1: zsd + 105, r_in: bar_r - 70, r_out: bar_r, seg: pseg, mat: "ST_Stone"),
            part(CROWN_Ring, cx: sx, cy: sy, z0: zsd + 30, z1: zsd + 90, r_in: bar_r - 4, r_out: bar_r + 6, seg: pseg, mat: "ST_BlueLED"),
            part(CROWN_Ring, cx: sx, cy: sy, z0: zsd + 105, z1: zsd + 113, r_in: bar_r - 84, r_out: bar_r + 18, seg: pseg, mat: "ST_DarkMetal"),
            cylinder_at(radius: 140, height: 100, bottom_center: (sx, sy, zsd - 4), segments: bseg, material: "ST_Stone"),
            cylinder_at(radius: 85, height: 115, bottom_center: (sx, sy, zsd + 94), segments: pick(lvl, 24, 12, 12), material: "ST_DarkMetal"),
            cylinder_at(radius: 115, height: 12, bottom_center: (sx, sy, zsd + 207), segments: bseg, material: "ST_Stone"),
            part(CROWN_Ring, cx: sx, cy: sy, z0: zsd + 196, z1: zsd + 207, r_in: 84, r_out: 112, seg: bseg, mat: "ST_BlueLED"));
        // stools on the far side of the bar; an arc point is skipped inside the a_in +-30 deg approach window and
        // wherever it would come within 25 cm of the flight / cheek band (|lateral| < hw + ct + 25, axial < ce + 25)
        // (lvl 1: square post from 1 cm under the deck + 6-sided seat; lvl 2: no stools)
        var stool = empty();
        if lvl < 1 {
            stool = merge(
                cylinder_at(radius: 16, height: 3, bottom_center: (0, 0, zsd - 1), segments: 10, material: "ST_DarkMetal"),
                cylinder_at(radius: 3, height: 72, bottom_center: (0, 0, zsd + 1), segments: 6, material: "ST_DarkMetal"),
                cylinder_at(radius: 19, height: 7, bottom_center: (0, 0, zsd + 72), segments: 12, material: "ST_Stone"));
        } else {
            stool = merge(
                box_at(size: (6, 6, 74), bottom_center: (0, 0, zsd - 1), material: "ST_DarkMetal"),
                cylinder_at(radius: 19, height: 7, bottom_center: (0, 0, zsd + 72), segments: 6, material: "ST_Stone"));
        }
        let r_st = min(bar_r + 60, SR - 90);
        let a_in = atan2(pc.y + suy * s_end - sy, pc.x + sux * s_end - sx);
        let n_stool = max(8, round(r_st * 6.28318 * 300 / 360 / 95));
        let ce_max = max(ce_p, ce_n);
        var st_pts = [];
        var n_st_ok = 0;
        for j in 0..n_stool {
            let a = a_in + 30 + j * 300 / (n_stool - 1);
            let px = sx + r_st * cos(a);
            let py = sy + r_st * sin(a);
            let fs = (px - pc.x) * sux + (py - pc.y) * suy;
            let fl = (px - pc.x) * snx + (py - pc.y) * sny;
            if (abs(fl) < hw + ct + 25) * (fs < ce_max + 25) == 0 {
                st_pts = append(st_pts, (px, py, 0));
                n_st_ok = n_st_ok + 1;
            }
        }
        if lvl < 2 {
            g = merge(g, sb_slab, sb_soffit, sb_deck, sb_curb, sb_posts, sb_rails, sb_bar);
        } else {
            // LOD2: one solid dark rail band on the rail line (post bottoms -> top rail top), ends 2 cm into the cheeks
            let sb_rail_band = sweep_box_path(points: arc_points(center: (sx, sy, zsd + 83), radius: SR - 12, start_degrees: g1, end_degrees: g2, count: 20, plane: "xy"), width: 6, height: 66, up: (0, 0, 1), material: "ST_DarkMetal");
            g = merge(g, sb_slab, sb_soffit, sb_deck, sb_curb, sb_rail_band, sb_bar);
        }
        if n_st_ok * (lvl < 2) > 0 {
            g = merge(g, copy_to_points(stool, points: st_pts));
        }
    }
    if w_stair > 0 {
        // grand stair from the head line down to the Sky Bar (16 treads, 17 risers)
        let n_st = 16;
        let s_tr = (s_end - s_h) / n_st;
        let s_rise = (zt - zsd) / (n_st + 1);
        var stair = empty();
        for k in 0..n_st {
            let top = zt - (k + 1) * s_rise;
            let d0 = s_h + k * s_tr;
            let d1 = s_h + (k + 1) * s_tr;
            stair = merge(stair, beam_between(start: (pc.x + sux * d0, pc.y + suy * d0, (zr + top) * 0.5), end: (pc.x + sux * d1, pc.y + suy * d1, (zr + top) * 0.5), cross_width: hw * 2, cross_height: top - zr, height_direction: (0, 0, 1), material: "ST_Stone"));
        }
        g = merge(g, stair, landing, cheek_p, cheek_n);
    }
} else if mode == 0 {
    let half = hw + ct;
    let se = s_end + 28;
    let blk = extrude_loop(points: [(pc.x + sux * s_h - snx * half, pc.y + suy * s_h - sny * half, zr), (pc.x + sux * se - snx * half, pc.y + suy * se - sny * half, zr), (pc.x + sux * se - snx * half, pc.y + suy * se - sny * half, zsd + 125), (pc.x + sux * s_h - snx * half, pc.y + suy * s_h - sny * half, zt + 120)], offset: (snx * half * 2, sny * half * 2, 0), material: "ST_Stone");
    let disc = cylinder_at(radius: SR, height: (zsd + 52) - (zsd - 190), bottom_center: (sx, sy, zsd - 190), segments: 32, material: "ST_Facade");
    let bar = merge(
        part(CROWN_Ring, cx: sx, cy: sy, z0: zsd + 48, z1: zsd + 90, r_in: bar_r - 70, r_out: bar_r + 6, seg: 32, mat: "ST_BlueLED"),
        part(CROWN_Ring, cx: sx, cy: sy, z0: zsd + 90, z1: zsd + 113, r_in: bar_r - 84, r_out: bar_r + 18, seg: 32, mat: "ST_DarkMetal"));
    g = merge(landing, blk, disc, bar);
} else {
    let se = s_end + 28;
    let ramp = extrude_loop(points: [(pc.x + sux * s_h - snx * hw, pc.y + suy * s_h - sny * hw, zr), (pc.x + sux * se - snx * hw, pc.y + suy * se - sny * hw, zr), (pc.x + sux * se - snx * hw, pc.y + suy * se - sny * hw, zsd), (pc.x + sux * s_h - snx * hw, pc.y + suy * s_h - sny * hw, zt)], offset: (snx * hw * 2, sny * hw * 2, 0), material: "ST_Facade");
    let disc = cylinder_at(radius: SR, height: 190, bottom_center: (sx, sy, zsd - 190), segments: 16, material: "ST_Facade");
    let rim_o = arc_profile(center: (sx, sy), radius: SR, start_degrees: g1, end_degrees: g2, count: 14);
    let rim_i = arc_profile(center: (sx, sy), radius: SR - 25, start_degrees: g1, end_degrees: g2, count: 14);
    let barrier = translate(extrude(points: concat_points(rim_o, reverse_points(rim_i)), height: 115, material: "ST_Facade"), (0, 0, zsd));
    let bar = cylinder_at(radius: bar_r, height: 113, bottom_center: (sx, sy, zsd), segments: 12, material: "ST_Stone");
    // terrace edge barrier: one closed box per balustrade run (same runs as LOD0, 28 cm wide, deck - 2 -> deck + 110), so
    // a bad endpoint can never fold a polygon; built as 8-corner polygon cages (8 collider verts per box instead of 24)
    var edge_wall = empty();
    for i in 0..n_run {
        let a = at(ra, i);
        let b = at(rb, i);
        let rl = max(1, sqrt((b.x - a.x) * (b.x - a.x) + (b.y - a.y) * (b.y - a.y)));
        let wx = 0 - (b.y - a.y) / rl * 14;
        let wy = (b.x - a.x) / rl * 14;
        edge_wall = merge(edge_wall, mesh_cage(points: [
            (a.x - wx, a.y - wy, zt - 2), (b.x - wx, b.y - wy, zt - 2), (b.x + wx, b.y + wy, zt - 2), (a.x + wx, a.y + wy, zt - 2),
            (a.x - wx, a.y - wy, zt + 110), (b.x - wx, b.y - wy, zt + 110), (b.x + wx, b.y + wy, zt + 110), (a.x + wx, a.y + wy, zt + 110)],
            faces: [[0, 3, 2, 1], [4, 5, 6, 7], [0, 1, 5, 4], [1, 2, 6, 5], [2, 3, 7, 6], [3, 0, 4, 7]], material: "ST_Facade"));
    }
    g = merge(ramp, landing, cheek_p, cheek_n, disc, barrier, bar, edge_wall);
}
out.geo = g;
#end

#mesh ST_Crown
budget(verts: 250000, indices: 750000);
sim_box(min: (-9000, -9000, 0), max: (9000, 9000, 25000));
anchor(mode: "origin");

// ---------- (1) dome terrace storey: plinth, inset warm glazing band, piers, fascia, deck ----------
let terrace_shell = part(CROWN_TerraceShell, detail: 1);
// ---------- terrace balustrade + Sirocco tables (layout from the shared stair frame) ----------
let terrace_bal = part(CROWN_SkyBarLink, mode: 2, piece: "bal");
let terrace_tables = part(CROWN_SkyBarLink, mode: 2, piece: "tables");
// ---------- (2) Sky Bar: cantilevered round platform, rim, rail, island bar, stools; stair + landings + cheek walls ----------
let skybar = part(CROWN_SkyBarLink, mode: 2, piece: "platform");
let stair_all = part(CROWN_SkyBarLink, mode: 2, piece: "stair");
// ---------- (3) drum, (4) LED band, (5) gored gold dome + lip + hem + ledge railing, (6) lantern / spire / tip ----------
let drum = part(CROWN_Upper, detail: 1, piece: "drum");
let led_band = part(CROWN_Upper, detail: 1, piece: "led");
let dome_all = part(CROWN_Upper, detail: 1, piece: "dome");
let lantern = part(CROWN_Upper, detail: 1, piece: "lantern");

// ---------- (7) lights: 8 warm dome uplights on the cornice floodlight fixtures (wide, overlapping, modest) ----------
// emitter sockets are mesh-level: their azimuth / radius / height come back from CROWN_Upper's probe (floodlight 0)
let fx0 = bounds_center(part(CROWN_Upper, detail: -1));
let fdx = fx0.x - DOME_C.x;
let fdy = fx0.y - DOME_C.y;
let r_e = sqrt(fdx * fdx + fdy * fdy);
let a_e = atan2(fdy, fdx);
let z_e = fx0.z;
emitter("DomeUp0", at: (DOME_C.x + r_e * cos(a_e), DOME_C.y + r_e * sin(a_e), z_e), axis: (-0.40 * cos(a_e), -0.40 * sin(a_e), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp1", at: (DOME_C.x + r_e * cos(a_e + 45), DOME_C.y + r_e * sin(a_e + 45), z_e), axis: (-0.40 * cos(a_e + 45), -0.40 * sin(a_e + 45), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp2", at: (DOME_C.x + r_e * cos(a_e + 90), DOME_C.y + r_e * sin(a_e + 90), z_e), axis: (-0.40 * cos(a_e + 90), -0.40 * sin(a_e + 90), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp3", at: (DOME_C.x + r_e * cos(a_e + 135), DOME_C.y + r_e * sin(a_e + 135), z_e), axis: (-0.40 * cos(a_e + 135), -0.40 * sin(a_e + 135), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp4", at: (DOME_C.x + r_e * cos(a_e + 180), DOME_C.y + r_e * sin(a_e + 180), z_e), axis: (-0.40 * cos(a_e + 180), -0.40 * sin(a_e + 180), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp5", at: (DOME_C.x + r_e * cos(a_e + 225), DOME_C.y + r_e * sin(a_e + 225), z_e), axis: (-0.40 * cos(a_e + 225), -0.40 * sin(a_e + 225), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp6", at: (DOME_C.x + r_e * cos(a_e + 270), DOME_C.y + r_e * sin(a_e + 270), z_e), axis: (-0.40 * cos(a_e + 270), -0.40 * sin(a_e + 270), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);
emitter("DomeUp7", at: (DOME_C.x + r_e * cos(a_e + 315), DOME_C.y + r_e * sin(a_e + 315), z_e), axis: (-0.40 * cos(a_e + 315), -0.40 * sin(a_e + 315), 0.92), color: "#ffcf86", intensity: 10, radius: 2600, kind: "spot", cone_inner: 70, cone_outer: 88, cast_shadow: false);

let terrace = merge(terrace_shell, terrace_bal, terrace_tables);
out.geo = merge(terrace, skybar, stair_all, drum, led_band, dome_all, lantern);
#end

#mesh ST_Crown lod: 1
// near display (~57 % of LOD0 verts, ~38 % of its indices): every LOD0 feature from the same parts, frame, radii and
// heights (lvl 1). Terrace storey with piers; balustrade with all 447 balusters as square shafts, posts, warm lamp
// blocks; simplified Sirocco tables; Sky Bar platform / rim curb / all rail posts (square) + 24-sided rails / blue bar
// ring + counter + back bar (32 / 16 sides) / simplified stools; stair, landing, cheek walls; 24 columns (10-sided shaft
// + echinus, plinth, abacus), uplights, glazing + mullions + trims, 40-sided entablature with 96 modillions, floodlight
// fixtures; LED band (40 sides) with its full bay grid; gored dome (4 points per gore, 16 rings), lip, hem, ledge
// railing (64 square posts); lantern / spire / orb / lamp / spike with fewer sides.
budget(verts: 60000, indices: 150000);
let terrace = part(CROWN_TerraceShell, detail: 1);
let skybar_all = part(CROWN_SkyBarLink, mode: 2, piece: "all", lvl: 1);
let upper = part(CROWN_Upper, detail: 1, piece: "all", lvl: 1);
out.geo = merge(terrace, skybar_all, upper);
#end

#mesh ST_Crown lod: 2
// mid display (~28 % of LOD0): LOD0 silhouette and colour pattern from the same parts, frame, radii and heights
// (lvl 2). Terrace storey with piers; balustrade as solid panels between the posts (no lamps); no tables / stools;
// Sky Bar disc, rim curb, one solid dark rail band, blue bar ring + counter + back bar; stair, landing, cheek walls;
// 24 columns as 8-sided prisms (plinth, shaft, echinus, abacus), uplights, glazing + mullions + trims, entablature;
// LED band (32 sides) with piers, mullions and X frames; gored dome (4 points per gore, 14 rings), lip, hem; lantern /
// spire / orb / tip with fewer sides.
budget(verts: 30000, indices: 90000);
let terrace = part(CROWN_TerraceShell, detail: 1);
let skybar_all = part(CROWN_SkyBarLink, mode: 2, piece: "all", lvl: 2);
let upper = part(CROWN_Upper, detail: 1, piece: "all", lvl: 2);
out.geo = merge(terrace, skybar_all, upper);
#end

#mesh ST_Crown lod: 3
// far display: terrace storey (plinth / lit glazing band / fascia + deck), drum (stylobate, glass core, 24 column boxes,
// entablature), LED band (white / blue / white), smooth dome, lantern + spire, Sky Bar disc + bar ring + stair block.
// Every value comes from the same shared parts as LOD0.
let terrace = part(CROWN_TerraceShell, detail: 0);
let upper = part(CROWN_Upper, detail: 0);
let skybar = part(CROWN_SkyBarLink, mode: 0);
out.geo = merge(terrace, upper, skybar);
#end

#mesh ST_Crown collider
// coarse walk/collision proxy: terrace prism, drum cylinder, dome frustum; Sky Bar disc + rim barrier + island bar,
// stair ramp, head landings, cheek walls and the terrace edge barrier (CROWN_SkyBarLink mode 1)
let zr = MAIN_ROOF - 2;
let terrace = translate(extrude(points: ROOFDECK_FP, height: ROOFDECK_TOP - zr, material: "ST_Facade"), (0, 0, zr));
// drum proxy at the visible lower stylobate step radius (DRUM_R + 80), so feet stop on the step, not 32 cm inside it
let drum = cylinder_at(radius: DRUM_R + 80, height: DRUM_TOP - DRUM_BASE + 2, bottom_center: (DOME_C.x, DOME_C.y, DRUM_BASE - 2), segments: 16, material: "ST_Facade");
let dome = cylinder_at(r_bot: DOME_R, r_top: 400, height: DOME_TOP - DRUM_TOP, bottom_center: (DOME_C.x, DOME_C.y, DRUM_TOP - 2), segments: 12, material: "ST_Gold");
let skybar = part(CROWN_SkyBarLink, mode: 1);
out.geo = merge(terrace, drum, dome, skybar);
#end
