// ===== ST_Podium - State Tower podium + corner portal (Podium crew, rev 4 = QC/QA round 3 fixes: free-standing portal pairs, LOD1 bands, west bay grid after the P8 niche) =====
// World centimetres, Z up, +X east, +Y true north; authored directly in WORLD coordinates from #meshdefs.
// Owns GRADE -> PODIUM_TOP over PODIUM_FP plus the corner portal on the north neck (to PORTAL_TOP).
// Photo calibration (P1 night / P2 day through the dossier cameras, P3 street):
//   giant colonnade 0 -> 23 m on Charoen Krung (9 bays of 9.6 m) AND on both north stretches (P7-P8, P3-P4),
//   loggias 7 m deep, floor AT GRADE (kerb course on the shopfront line), lit shopfronts + dark upper glazing,
//   P8 corner niche (4.5 m along the west face, 2.15 m deep, 0 -> 44.6 m) holding a pair of free-standing
//   full-height giant columns (r 90, grade -> cornice soffit), balcony storey 24.8 -> 29.6 m (pedestals +
//   colonnette screen), arched bays 30.2 -> 44.6 m (cream screens, paired engaged round columns, 7 window rows,
//   bold two-arch heads at top + mid); NW stretch P7-P8 upper tiers = white fin screen (5 fins, 4 x 7 + 4 x 2 panes),
//   entablature + heavy cornice to 48.9 m, parapet to PODIUM_TOP (roof deck 48.9-49.0 m, see Management note).
//   Portal: giant arch 9.6 m x 21.6 m, paired giant columns r 80 on pair pedestals (all within 50 cm of the
//   neck outline), entablature 22.0-26.2 m, ledge 29.4 m, round-headed recessed panel 29.5-46.7 m holding the
//   stroked "State Tower / Bangkok" lettering and the 9.6 m medallion (gold disc, white pointed 5-petal flower
//   with gold edging), broad paired pilasters, top cornice ledge to 50.06 m, pediment + gable roof to PORTAL_TOP.
// Declared deviations from the work order (photos win; Management to amend the order / log in MASTER_BRIEF s.6):
//   D1 west colonnade columns r 100 (2.0 m dia), 0 -> 23.01 m, 9 bays of 9.6 m (8 columns) - P2 through the fitted
//      camera: bay boundaries every 20-21 px (9.6 m projects to 20.8 px), colonnade top 21-23 m, columns ~5 px (~2.3 m).
//   D2 portal arch: rev 2 had 10.5 m x 18.25 m (P2: north-face crown y 700 px vs ground ~742 / cornice ~628 px at
//      2.28 px/m = ~18.4 m); QC round 2 option b (P3 H/W ~2.1, P1 arch head 21-22 m under ~22.4 m capitals) makes it
//      9.6 m x 21.6 m crown under 22.0 m capitals - back inside the order's 9-10 x 20-24 m (SiteOps item b superseded).
//   D3 portal medallion on the north (street-corner) face only; west and east faces carry fins + slits
//      (P2 x 321-358 px shows fins only; P1/P3 show one medallion on the street face).
//   D4 interface at 50 m: roof deck 49.0 m behind a 50.0 m parapet; tower footprints carry ST_FacadeShade podium
//      plinths 48.85 -> 50.0 m; tower z0 4982-4998 sits inside the plinths (Management to rule, MASTER_BRIEF s.4/6).
//   D5 P8: the old flat 3 m pier became a 4.5 m x 2.15 m corner niche with two free-standing giant columns
//      (P2 red marker ~4.2-4.5 m; P3 x 160-230); its left jamb is the NW fin screen's deep end fin, so the first
//      west arched bay (right of the niche) runs from the niche jamb to X0 = 12 m (rev 4: grid starts after the niche, 8 x ~9.3 m bays).
//   D6 portal ledge 28.6-29.4 m and lettering +0.4 m (lettering 29.7-32.6 m): the raised entablature (QC b) would
//      otherwise cut through "Bangkok"; the medallion stays at 38.8 m (gap 1.36 m, P3 ~1.5 m).
// rev 5 (LOD chain, client ratios LOD1 -38% / LOD2 -72% / LOD3 -96%): the LOD0 parts gained LOD params whose
//   defaults reproduce LOD0 exactly (POD_Column simple, POD_Face lod, POD_FinScreen lod 2, POD_CornerP8 cseg / simple,
//   POD_Portal lod, POD_FaceLod lowwin / skip_a / dec). lod: 1 (near-mid) and lod: 2 (mid-far) reuse the LOD0 parts with
//   reduced values; lod: 3 is the former far-display lod: 1 with its blank S / SE / E lower storeys filled in.

// ---------------------------------------------------------------------------------------------
// One giant column: pedestal (optional), torus base, tapered shaft, flared capital, square abacus.
#meshpart POD_Column
param x = 0;
param y = 0;
param z0 = 0;
param z1 = 2300;
param r = 100;
param ped = 250;
param ped_h = 170;
param segs = 20;
param ped_on = 1;
param base_k = 1.2;
param cap_k = 1.2;
param aba_k = 2.55;
// LOD2 (simple = 1): one tapered shaft from the pedestal top into the abacus + the abacus (no torus base / flared capital)
param simple = 0;
let base_h = r * 0.6;
let cap_h = r * 0.75;
let aba_h = r * 0.6;
let s0 = z0 + ped_h + base_h - 2;
let s1 = z1 - aba_h - cap_h + 1;
let aba = box_at(size: (r * aba_k, r * aba_k, aba_h), bottom_center: (x, y, z1 - aba_h), material: "ST_Stone");
var g = empty();
if simple < 0.5 {
    let base = cylinder_at(r_bot: r * base_k, r_top: r * 1.04, height: base_h, bottom_center: (x, y, z0 + ped_h - 1), segments: segs, material: "ST_Stone");
    let shaft = cylinder_at(r_bot: r, r_top: r * 0.88, height: s1 - s0, bottom_center: (x, y, s0), segments: segs, material: "ST_Stone");
    let cap = cylinder_at(r_bot: r * 0.9, r_top: r * cap_k, height: cap_h, bottom_center: (x, y, s1 - 1), segments: segs, material: "ST_Stone");
    g = merge(base, shaft, cap, aba);
} else {
    g = merge(cylinder_at(r_bot: r * 1.04, r_top: r * 0.9, height: z1 - aba_h + 1 - (z0 + ped_h - 1), bottom_center: (x, y, z0 + ped_h - 1), segments: segs, material: "ST_Stone"), aba);
}
if ped_on > 0.5 {
    g = merge(g, box_at(size: (ped, ped, ped_h), bottom_center: (x, y, z0), material: "ST_Stone"));
}
out.geo = g;
#end

// ---------------------------------------------------------------------------------------------
// Semicircular arch band (archivolt / tracery / window surround) in the XZ plane: springing at z = 0,
// outer radius ro, inner radius ri, straight legs lg below the springing, depth centred on y = 0.
#meshpart POD_ArchBand
param ro = 200;
param ri = 180;
param lg = 20;
param depth = 14;
param segs = 8;
param mat = "ST_Stone";
// rev 5 LOD param: legs = 0 drops the straight legs (the band ends at the springing line)
param legs = 1;
var p = [];
if legs > 0.5 {
    p = append(p, (0 - ro, 0 - lg));
}
for k in 0..(segs + 1) {
    let a = 180 - k * 180 / segs;
    p = append(p, (ro * cos(a), ro * sin(a)));
}
if legs > 0.5 {
    p = append(p, (ro, 0 - lg));
    p = append(p, (ri, 0 - lg));
}
for k in 0..(segs + 1) {
    let a = k * 180 / segs;
    p = append(p, (ri * cos(a), ri * sin(a)));
}
if legs > 0.5 {
    p = append(p, (0 - ri, 0 - lg));
}
out.geo = translate(rotate_x(extrude(points: p, height: depth, material: mat), degrees: 90, pivot: (0, 0, 0)), (0, depth * 0.5, 0));
#end

// ---------------------------------------------------------------------------------------------
// One straight podium facade run A -> B (footprint CCW order: outside on the right of A->B).
// Authored in a local frame (x along the face 0..L, face line y = 0, outward = -y, inward = +y),
// then turned and moved onto A. colonnade = 1 builds the giant colonnade in front of a 7 m deep loggia
// whose floor is at grade (the kerb course on the shopfront line comes from POD_LowBlock mode 0).
#meshpart POD_Face
param ax = 0;
param ay = 0;
param bx = 1000;
param by = 0;
param bay_t = 870;
param colonnade = 0;
param skip_a = 0;
param skip_b = 0;
param pax = -1000;
param pay = 0;
param nbx = 2000;
param nby = 0;
param ext_a = 0;
param ext_b = 0;
// colonnade only: end pier widths along the run (also the loggia glazing extents), end pier blocks
// (0 none, 1 up to the loggia soffit, 2 = corner niche built by POD_CornerP8: run members start pier_a + 10
// inside the niche's right jamb), column count (0 = one per bay boundary,
// N = N columns evenly between the openings' ends), acute-corner pier setback behind the neighbouring facade
param pier_a = 300;
param pier_b = 300;
param epa = 1;
param epb = 1;
param ncol = 0;
param pier_off = 110;
// upper = 0 skips the balcony storey + arched-bay tiers (NW stretch: POD_FinScreen builds them);
// lower = 0 skips the non-colonnade lower storeys (only used to lint a face's tiers separately)
param upper = 1;
param lower = 1;
// display LOD (default 0 = LOD0 unchanged). lod 1 (near-mid): 8-segment engaged columns, 5 / 8-segment sub / head
// arches without their short legs, the column bases merged into the balcony pedestal, solid arched-bay screens with
// one ST_PodiumRooms decal per window (same 7-row grid; the hidden glazing behind them dropped), colonnette decals at
// ~90 cm (30 wide), 4-segment lower window heads without the transom bar, 8-segment colonnade.
// lod 2 (mid-far): 6-sided engaged columns under one capital block per pair, 2 / 3-segment polyline arches,
// lower windows as arched ST_PodiumRooms panels on a solid wall, plain 8-sided colonnade shafts, no shopfront mullions.
param lod = 0;
let cseg = pick(lod, 16, 8, 6);
let sseg = pick(lod, 8, 5, 2);
let oseg = pick(lod, 12, 8, 3);
let wseg = pick(lod, 8, 4, 2);
let bsp = pick(lod, 45, 90, 90);
let bhw = pick(lod, 8, 15, 15);
let kseg = pick(lod, 20, 8, 8);
let dx = bx - ax;
let dy = by - ay;
let L = sqrt(dx * dx + dy * dy);
let ang = atan2(dy, dx);
// corner handling: neighbour edges at the start (prev vertex) and end (next vertex).
// Square or acute corners: run-long members stop short of the corner (no coplanar end faces, no poke-through);
// obtuse corners: members run to the vertex and interpenetrate inside the mass.
let ux = dx / L;
let uy = dy / L;
let wa = sqrt((pax - ax) * (pax - ax) + (pay - ay) * (pay - ay));
let wb = sqrt((nbx - bx) * (nbx - bx) + (nby - by) * (nby - by));
let sin_a = max(0.001, abs(ux * (pay - ay) - uy * (pax - ax)) / wa);
let sin_b = max(0.001, abs(ux * (nby - by) - uy * (nbx - bx)) / wb);
let cot_a = (ux * (pax - ax) + uy * (pay - ay)) / wa / sin_a;
let cot_b = (0 - ux * (nbx - bx) - uy * (nby - by)) / wb / sin_b;
let ka = select(0, 1, cot_a > -0.09);
let kb = select(0, 1, cot_b > -0.09);
let ca = max(0, cot_a);
let cb = max(0, cot_b);
// ends against the portal (ext_* > 0): run members 20 cm into the portal mass instead of stopping short
let t6a = select(6, 0 - ext_a, ext_a > 0.5);
let t6b = select(6, 0 - ext_b, ext_b > 0.5);
// corner niche (ep* = 2): the first/last bay starts 7 cm inside the niche's right jamb (pier_a - 2 .. pier_a + 34),
// its column pair is omitted; run-long members start pier_a + 10 (inside the jamb)
let xlo = select(135 + ca * 80, pier_a - 89, epa > 1.5);
let xhi = select(L - 135 - cb * 80, L - pier_b + 89, epb > 1.5);
let ena = epa > 1.5;
let enb = epb > 1.5;
// rev 4 (QC round 3): with a corner niche at the start (epa = 2) the bay grid starts after the niche: boundary 0 is
// the niche jamb (xlo), boundaries i >= 1 at X0 + (i - 1) * bw (X0 = 12 m, P2: first colonnade column 12-14 m from P8),
// so the first bay is ~0.87 of a standard bay instead of a half-size copy
let X0 = 1200;
let nbB = max(1, round((L - X0) / bay_t));
let nb = select(max(1, round(L / bay_t)), nbB + 1, epa > 1.5);
let bw = select(L / nb, (L - X0) / nbB, epa > 1.5);
let boff = select(0, X0 - bw, epa > 1.5);
let zBase = 130;
let zL1 = 2300;
let zB0 = 2480;
let zB1 = 2960;
let zU0 = 3020;
let zU1 = 4460;
let hU = zU1 - zU0;
var g = empty();

if upper > 0.5 {
// glazing planes behind the stone screens (interior_window_pbr: lit rooms at night)
// (lod >= 1: the arched-tier glazing is hidden behind the solid screens + window decals, so it is left out)
if lod < 0.5 {
g = merge(g, box_bounds(min: (select(t6a + ca * 105, pier_a + 10, ena), 95, zU0 - 7), max: (L - select(t6b + cb * 105, pier_b + 10, enb), 105, zU1 + 7), material: "ST_PodiumRooms"));
}
g = merge(g, box_bounds(min: (select(t6a + ca * 180, pier_a + 10, ena), 170, zB0 - 7), max: (L - select(t6b + cb * 180, pier_b + 10, enb), 180, zB1 + 7), material: "ST_PodiumRooms"));

// bay boundaries: paired ENGAGED ROUND COLUMNS (arched-bay zone, ~62 cm proud of the screen) on a backing
// strip, with base / capital blocks; projecting pedestals in the balcony storey below
for i in 0..(nb + 1) {
    let xc = clamp(boff + i * bw, xlo, xhi);
    let skipp = (i < 0.5) * (epa > 1.5) + (i > nb - 0.5) * (epb > 1.5);
    if skipp < 0.5 {
        let sx0 = select(xc - 118, (t6a + ca * 76), i < 0.5);
        let sx1 = select(xc + 118, L - (t6b + cb * 76), i > nb - 0.5);
        g = merge(g, box_bounds(min: (sx0, 30, zU0 - 4), max: (sx1, 76, zU1 + 4), material: "ST_Facade"));
        for s in 0..2 {
            let px = xc - 55 + s * 110;
            g = merge(g, cylinder_at(radius: 42, height: zU1 - zU0 - 131, bottom_center: (px, 15, zU0 + 58), segments: cseg, material: "ST_Stone"));
            if lod < 1.5 {
                g = merge(g, box_bounds(min: (px - 50, -35, zU1 - 75), max: (px + 50, 60, zU1 + 1), material: "ST_Stone"));
            }
            if lod < 0.5 {
                g = merge(g, box_bounds(min: (px - 50, -35, zB1 - 1), max: (px + 50, 60, zU0 + 60), material: "ST_Stone"));
            }
        }
        if lod > 1.5 {
            g = merge(g, box_bounds(min: (xc - 105, -35, zU1 - 75), max: (xc + 105, 60, zU1 + 1), material: "ST_Stone"));
        }
        // (lod >= 1: the pedestal rises to the column-base tops, standing in for the two base blocks)
        g = merge(g, box_bounds(min: (xc - 118, -40, zB0 - 1), max: (xc + 118, 76, select(zB1 + 1, zU0 + 60, lod > 0.5)), material: "ST_Stone"));
    }
}

// arched bays: recessed cream screen (ST_Facade, white/cream as the pilasters in photos 1-3; the light stone
// tracery reads by relief) with a 3-column x 7-row window grid; bold two-arch tracery at mid height
// and a round-headed outer arch holding two sub-arches at the head (photo 1)
for i in 0..nb {
    let x0 = clamp(boff + i * bw, xlo, xhi) + 116;
    let x1 = clamp(boff + (i + 1) * bw, xlo, xhi) - 116;
    let wp = x1 - x0;
    // (niche runs: window width from the standard screen bw - 232, so the first bay keeps full-size windows)
    let ww = select(wp * 0.14, 0.14 * min(bw - 232, 1.15 * wp), ena);
    let wdx = wp * 0.25;
    let ro_s = wp * 0.25 - 1.5;
    let ro_o = wp * 0.5;
    let zs_h = hU - ro_o - 20;
    let zs_m = 652 - ro_s;
    var holes = [];
    for r in 0..6 {
        let wz = 90 + r * 190;
        for c in 0..3 {
            // rows 2 and 5 sit inside the sub-arches: the middle window gives way to the arches' central mullion
            let arched = (r == 2) + (r == 5);
            if arched * (c == 1) < 0.5 {
                let cx = wp * 0.5 + (c - 1) * wdx;
                holes = append(holes, [(cx - ww * 0.5, wz), (cx + ww * 0.5, wz), (cx + ww * 0.5, wz + 110), (cx - ww * 0.5, wz + 110)]);
            }
        }
    }
    // 7th row: one window in the head tympanum, where it clears the sub-arches
    let dq = wp * 0.25 - ww * 0.5;
    let ext_h = zs_h + sqrt(max(0, ro_s * ro_s - dq * dq));
    if ext_h < 1215 {
        holes = append(holes, [(wp * 0.5 - ww * 0.5, 1225), (wp * 0.5 + ww * 0.5, 1225), (wp * 0.5 + ww * 0.5, 1325), (wp * 0.5 - ww * 0.5, 1325)]);
    }
    if lod < 0.5 {
        let pnl = extrude_shape(outer: [(0, 0), (wp, 0), (wp, hU), (0, hU)], holes: holes, height: 40, material: "ST_Facade");
        g = merge(g, translate(rotate_x(pnl, degrees: 90, pivot: (0, 0, 0)), (x0, 75, zU0)));
    } else {
        // lod >= 1: solid screen (same slab y 35 -> 75) + one ST_PodiumRooms decal per window, 2 cm proud of its face
        g = merge(g, box_bounds(min: (x0, 35, zU0), max: (x0 + wp, 75, zU0 + hU), material: "ST_Facade"));
        for k in 0..len(holes) {
            let hp = at(holes, k);
            let h0 = at(hp, 0);
            let h2 = at(hp, 2);
            g = merge(g, translate(rotate_x(plane(width: h2.x - h0.x, height: h2.y - h0.y, material: "ST_PodiumRooms"), degrees: 90, pivot: (0, 0, 0)), (x0 + (h0.x + h2.x) * 0.5, 33, zU0 + (h0.y + h2.y) * 0.5)));
        }
    }
    let sub = part(POD_ArchBand, ro: ro_s, ri: ro_s - 38, lg: 30, depth: 30, segs: sseg, legs: select(1, 0, lod > 0.5));
    let sub2 = merge(translate(sub, (x0 + wp * 0.25 + 1.5, 30, 0)), translate(sub, (x0 + wp * 0.75 - 1.5, 30, 0)));
    let oarch = translate(part(POD_ArchBand, ro: ro_o, ri: ro_o - 40, lg: 40, depth: 36, segs: oseg, legs: select(1, 0, lod > 0.5)), (x0 + wp * 0.5, 27, zU0 + zs_h));
    g = merge(g, translate(sub2, (0, 0, zU0 + zs_h)), translate(sub2, (0, 0, zU0 + zs_m)), oarch);
}

// balcony storey: plinth rail, top rail, colonnette screen between the pedestals (rails stop inside the niche jamb)
g = merge(g, box_bounds(min: (select(t6a + ca * 62, pier_a + 10, ena), 0, zB0 - 4), max: (L - select(t6b + cb * 62, pier_b + 10, enb), 62, zB0 + 70), material: "ST_Stone"));
g = merge(g, box_bounds(min: (select(t6a + ca * 62, pier_a + 10, ena), -6, zB1 - 60), max: (L - select(t6b + cb * 62, pier_b + 10, enb), 62, zB1 + 4), material: "ST_Stone"));
for i in 0..nb {
    let xs = clamp(boff + i * bw, xlo, xhi) + 128;
    let xe = clamp(boff + (i + 1) * bw, xlo, xhi) - 128;
    let n = max(1, floor((xe - xs) / bsp));
    let sp = (xe - xs) / n;
    if lod < 0.5 {
        let bal = box_bounds(min: (xs + sp * 0.5 - bhw, 22, zB0 + 68), max: (xs + sp * 0.5 + bhw, 38, zB1 - 58), material: "ST_Stone");
        g = merge(g, array(bal, count: n, offset: (sp, 0, 0)));
    } else {
        // lod >= 1: colonnette decals (30 wide at ~90 cm, same stone / void ratio) on the colonnette front plane
        let balp = translate(rotate_x(plane(width: bhw * 2, height: zB1 - zB0 - 126, material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0)), (xs + sp * 0.5, 22, (zB0 + zB1 + 10) * 0.5));
        g = merge(g, array(balp, count: n, offset: (sp, 0, 0)));
    }
}
}

if colonnade > 0 {
    // giant colonnade in front of a 7 m deep loggia (floor at grade): lit shopfronts in the lowest tier,
    // dark glazing above (photo 2 reads the loggia as a deep dark void), shaded piers behind the columns
    let cnt = select(nb - 1, ncol, ncol > 0.5);
    let o0 = pier_a;
    let o1 = select(L, L - pier_b, epb > 0.5);
    let g0 = pier_a;
    let g1 = L - pier_b;
    var cx = [];
    cx = append(cx, o0);
    for k in 0..cnt {
        cx = append(cx, select(boff + (k + 1) * bw, o0 + (k + 1) * (o1 - o0) / (cnt + 1), ncol > 0.5));
    }
    cx = append(cx, o1);
    let zt1 = zBase + (zL1 - zBase) / 4;
    g = merge(g, box_bounds(min: (g0, 690, zBase - 7), max: (g1, 702, zt1), material: "ST_PodiumRooms"));
    g = merge(g, box_bounds(min: (g0, 690, zt1), max: (g1, 702, zL1 + 7), material: "ST_DarkGlass"));
    for k in 1..4 {
        let zk = zBase + k * (zL1 - zBase) / 4;
        g = merge(g, box_bounds(min: (g0, 668, zk - 28), max: (g1, 691, zk + 28), material: "ST_FacadeShade"));
    }
    let mul = box_bounds(min: (-6, 678, zBase - 1), max: (6, 691, zt1 - 27), material: "ST_DarkMetal");
    for k in 0..(cnt + 1) {
        let mx0 = select(at(cx, k) + 70, g0, k < 0.5);
        let mx1 = select(at(cx, k + 1) - 70, g1, k > cnt - 0.5);
        let msp = (mx1 - mx0) / 4;
        if (msp > 50) * (lod < 1.5) > 0.5 {
            g = merge(g, array(translate(mul, (mx0 + msp, 0, 0)), count: 3, offset: (msp, 0, 0)));
        }
    }
    // end piers (ep* = 1): square / obtuse corners stand perpendicular to the run; at an acute corner the pier side
    // follows the neighbouring facade, pier_off behind it (that facade keeps its own wall and windows).
    // ep* = 2: the corner niche (recessed pier + paired giant columns + right jamb) comes from POD_CornerP8.
    if (epa > 0.5) * (epa < 1.5) > 0.5 {
        let xs0 = select(0 - ext_a, pier_off / sin_a - 10 * cot_a, cot_a > 0.05);
        let xs1 = select(0 - ext_a, pier_off / sin_a + 702 * cot_a, cot_a > 0.05);
        g = merge(g, extrude(points: [(xs0, -10), (pier_a, -10), (pier_a, 702), (xs1, 702)], height: zL1 + 14, material: "ST_Stone"));
    }
    if (epb > 0.5) * (epb < 1.5) > 0.5 {
        let xe0 = select(L + ext_b, L - pier_off / sin_b + 10 * cot_b, cot_b > 0.05);
        let xe1 = select(L + ext_b, L - pier_off / sin_b - 702 * cot_b, cot_b > 0.05);
        g = merge(g, extrude(points: [(L - pier_b, -10), (xe0, -10), (xe1, 702), (L - pier_b, 702)], height: zL1 + 14, material: "ST_Stone"));
    }
    for k in 1..(cnt + 1) {
        let c = at(cx, k);
        g = merge(g, box_bounds(min: (c - 70, 660, 0), max: (c + 70, 691, zL1 + 1), material: "ST_FacadeShade"));
        g = merge(g, part(POD_Column, x: c, y: 125, z0: 0, z1: zL1 + 1, r: 100, ped: 250, ped_h: 170, segs: kseg, simple: select(0, 1, lod > 1.5)));
    }
} else if lower > 0.5 {
    // lower storeys: wall with two tiers of tall round-arched windows per bay between pilasters
    let hw = 160;
    var lholes = [];
    for i in 0..nb {
        let xm = (i + 0.5) * bw;
        let skip = (i < 0.5) * skip_a + (i > nb - 1.5) * skip_b;
        for t in 0..(2 - 2 * min(1, skip)) {
            let zs0 = 220 + t * 1000;
            let zsp = zs0 + 640;
            var h = [];
            h = append(h, (xm - hw, zs0));
            h = append(h, (xm + hw, zs0));
            for k in 0..(wseg + 1) {
                let a = k * 180 / wseg;
                h = append(h, (xm + hw * cos(a), zsp + hw * sin(a)));
            }
            lholes = append(lholes, h);
        }
    }
    let nwin = nb - min(nb, skip_a + skip_b);
    // (lod 2: solid wall, the windows are arched ST_PodiumRooms panels in front of it - see below)
    if (nwin > 0) * (lod < 1.5) > 0.5 {
        let w0 = (t6a + ca * 75);
        let w1 = L - (t6b + cb * 75);
        let wl = extrude_shape(outer: [(w0, 0), (w1, 0), (w1, zL1 - zBase), (w0, zL1 - zBase)], holes: lholes, height: 40, material: "ST_Facade");
        g = merge(g, translate(rotate_x(wl, degrees: 90, pivot: (0, 0, 0)), (0, 75, zBase)));
    } else {
        g = merge(g, box_bounds(min: ((t6a + ca * 75), 35, zBase), max: (L - (t6b + cb * 75), 75, zL1), material: "ST_Facade"));
    }
    g = merge(g, box_bounds(min: ((t6a + ca * 105), 95, zBase - 7), max: (L - (t6b + cb * 105), 105, zL1 + 7), material: "ST_PodiumRooms"));
    for i in 0..(nb + 1) {
        let xc = clamp(i * bw, select(65 + ka * (12 + ca * 40), 65 - ext_a, ext_a > 0.5), select(L - 65 - kb * (12 + cb * 40), L - 65 + ext_b, ext_b > 0.5));
        g = merge(g, box_bounds(min: (xc - 65, -8, zBase - 1), max: (xc + 65, 40, zL1 + 1), material: "ST_Stone"));
    }
    var win = empty();
    if lod < 1.5 {
        let sur = translate(part(POD_ArchBand, ro: hw + 25, ri: hw, lg: 640, depth: 14, segs: wseg), (0, 29, 640));
        let sill = box_bounds(min: (0 - hw - 35, 15, -22), max: (hw + 35, 40, 1), material: "ST_Stone");
        let mull = box_bounds(min: (-9, 48, 0), max: (9, 60, 640 + hw - 2), material: "ST_Stone");
        let tran = box_bounds(min: (0 - hw - 5, 48, 631), max: (hw + 5, 60, 649), material: "ST_Stone");
        win = translate(merge(sur, sill, mull, tran), (bw * 0.5, 0, zBase + 220));
        if lod > 0.5 {
            // lod 1: no transom bar (18 cm, inside the reveal)
            win = translate(merge(sur, sill, mull), (bw * 0.5, 0, zBase + 220));
        }
    } else {
        // lod 2: the arched opening as a thin ST_PodiumRooms panel (polyline head), 2 cm proud of the wall face (y 35)
        var ap = [];
        ap = append(ap, (0 - hw, 0));
        ap = append(ap, (hw, 0));
        for k in 0..(wseg + 1) {
            let a = k * 180 / wseg;
            ap = append(ap, (hw * cos(a), 640 + hw * sin(a)));
        }
        win = translate(rotate_x(extrude(points: ap, height: 2, material: "ST_PodiumRooms"), degrees: 90, pivot: (0, 0, 0)), (bw * 0.5, 33, zBase + 220));
    }
    let win2 = merge(win, translate(win, (0, 0, 1000)));
    for i in 0..nb {
        let skip = (i < 0.5) * skip_a + (i > nb - 1.5) * skip_b;
        if skip < 0.5 {
            g = merge(g, translate(win2, (i * bw, 0, 0)));
        }
    }
}
out.geo = translate(rotate_z(g, degrees: ang, pivot: (0, 0, 0)), (ax, ay, 0));
#end

// ---------------------------------------------------------------------------------------------
// Lower mass shared by LOD0 / LOD1 / collider so all three agree on the loggias (floor at grade).
// LOWX = podium outline with the three loggias (west, north-west, north-east; 7 m deep) cut out and the
// end piers kept; the P8 corner niche (recessed pier, paired giant columns) and the colonnade columns are
// added separately (same layout as POD_CornerP8: pier_a / rec_d / cut_b).
//   mode 0: LOD0 kerb course on LOWX (+25 cm, 0 -> 130)    mode 1: LOD1 lower mass    mode 2: collider lower mass
#meshpart POD_LowBlock
param mode = 1;
param d = 700;
param pier_a = 450;
param rec_d = 215;
param cut_b = 100;
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P4 = at(PODIUM_FP, 4);
let P7 = at(PODIUM_FP, 7);
let P8 = at(PODIUM_FP, 8);
let zL1 = 2300;
let zU1 = 4460;
// west face P8 -> P0 and its inward normal
let wl = sqrt((P0.x - P8.x) * (P0.x - P8.x) + (P0.y - P8.y) * (P0.y - P8.y));
let wdx = (P0.x - P8.x) / wl;
let wdy = (P0.y - P8.y) / wl;
let iwx = 0 - wdy;
let iwy = wdx;
// north line P3 -> P8 (P4, P7 on it) and its inward normal
let nl = sqrt((P8.x - P3.x) * (P8.x - P3.x) + (P8.y - P3.y) * (P8.y - P3.y));
let ndx = (P8.x - P3.x) / nl;
let ndy = (P8.y - P3.y) / nl;
let inx = 0 - ndy;
let iny = ndx;
// loggia back corner shared by the west and north-west loggias
let cwn = iwx * inx + iwy * iny;
let ex = P8.x + d * (iwx + inx) / (1 + cwn);
let ey = P8.y + d * (iwy + iny) / (1 + cwn);
// end piers (match the POD_Face calls: NE pier_a 300 / pier_b 120, NW pier_a 120, W pier_b 300)
let q1x = P3.x + ndx * 300;
let q1y = P3.y + ndy * 300;
let c2x = P4.x - ndx * 120;
let c2y = P4.y - ndy * 120;
let d1x = P7.x + ndx * 120;
let d1y = P7.y + ndy * 120;
let a2x = P0.x - wdx * 300;
let a2y = P0.y - wdy * 300;
let LOWX = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (q1x, q1y), (q1x + inx * d, q1y + iny * d), (c2x + inx * d, c2y + iny * d), (c2x, c2y), (d1x, d1y), (d1x + inx * d, d1y + iny * d), (ex, ey), (a2x + iwx * d, a2y + iwy * d), (a2x, a2y)];
var g = empty();
if mode < 0.5 {
    g = extrude_profile(points: LOWX, profile: [(0, 25), (130, 25)], material: "ST_Stone");
} else {
    let lm = select("ST_Facade", "ST_Stone", mode > 1.5);
    g = extrude(points: LOWX, height: zL1 + 1, material: lm);
    // P8 corner niche: recessed pier behind the niche (full height to the cornice), its left side on the NW
    // fin screen's end-fin plane (cut_b before P8, perpendicular to the north line), front rec_d behind the west face
    let kax = P8.x - ndx * cut_b;
    let kay = P8.y - ndy * cut_b;
    let tm = cut_b * (ndx * wdx + ndy * wdy) / (inx * wdx + iny * wdy);
    let tj = (rec_d + cut_b * (ndx * iwx + ndy * iwy)) / (inx * iwx + iny * iwy);
    let pierP = [(kax + inx * tm, kay + iny * tm), (kax + inx * tj, kay + iny * tj), (P8.x + wdx * pier_a + iwx * rec_d, P8.y + wdy * pier_a + iwy * rec_d), (P8.x + wdx * pier_a + iwx * 702, P8.y + wdy * pier_a + iwy * 702), (P8.x + iwx * 702, P8.y + iwy * 702)];
    g = merge(g, extrude(points: pierP, height: select(zU1 + 10, zL1 + 1, mode > 1.5), material: lm));
    let cpa = [(P8.x + wdx * 110 + iwx * 90, P8.y + wdy * 110 + iwy * 90, 0), (P8.x + wdx * 330 + iwx * 90, P8.y + wdy * 330 + iwy * 90, 0)];
    // colonnade columns: west 9 bays of 9.6 m, one column mid-opening on each north stretch
    // rev 4: west columns on the post-niche grid (X0 = 1200 from P8, as POD_Face epa = 2)
    let nbw = round((wl - 1200) / 960) + 1;
    let bww = (wl - 1200) / (nbw - 1);
    let lnw = sqrt((P8.x - P7.x) * (P8.x - P7.x) + (P8.y - P7.y) * (P8.y - P7.y));
    let lne = sqrt((P4.x - P3.x) * (P4.x - P3.x) + (P4.y - P3.y) * (P4.y - P3.y));
    var pts = [];
    for i in 1..nbw {
        pts = append(pts, (P8.x + wdx * (1200 + (i - 1) * bww) + iwx * 125, P8.y + wdy * (1200 + (i - 1) * bww) + iwy * 125, 0));
    }
    pts = append(pts, (P7.x + ndx * (lnw + 120) * 0.5 + inx * 125, P7.y + ndy * (lnw + 120) * 0.5 + iny * 125, 0));
    pts = append(pts, (P3.x + ndx * (lne + 180) * 0.5 + inx * 125, P3.y + ndy * (lne + 180) * 0.5 + iny * 125, 0));
    if mode < 1.5 {
        g = merge(g, copy_to_points(cylinder_at(radius: 100, height: zL1 + 1, bottom_center: (0, 0, 0), segments: 8, material: "ST_Stone"), points: pts));
        // niche: paired giant columns to the cornice soffit + right jamb (LOD0 jamb is pier_a - 2 .. pier_a + 34; the LOD1
        // one runs to pier_a + 90 so it also closes the inset LOD1 bands' notch faces)
        g = merge(g, copy_to_points(cylinder_at(radius: 90, height: zU1, bottom_center: (0, 0, 0), segments: 8, material: "ST_Stone"), points: cpa));
        let jy = (rec_d + 8) * 0.5;
        let jz = (zL1 + zU1 - 7) * 0.5;
        g = merge(g, beam_between(start: (P8.x + wdx * (pier_a - 2) + iwx * jy, P8.y + wdy * (pier_a - 2) + iwy * jy, jz), end: (P8.x + wdx * (pier_a + 90) + iwx * jy, P8.y + wdy * (pier_a + 90) + iwy * jy, jz), cross_width: rec_d + 32, cross_height: zU1 - zL1 + 9, height_direction: (0, 0, 1), material: "ST_Facade"));
        // loggia back walls: lit shopfront tier + dark glazing above, 6 cm in front of the back line
        let zt = 130 + (zL1 - 130) / 4;
        let ox = 0 - iwx * 6;
        let oy = 0 - iwy * 6;
        let mx = 0 - inx * 6;
        let my = 0 - iny * 6;
        g = merge(g, beam_between(start: (ex + ox, ey + oy, (130 + zt) * 0.5), end: (a2x + iwx * d + ox, a2y + iwy * d + oy, (130 + zt) * 0.5), cross_width: 12, cross_height: zt - 130, height_direction: (0, 0, 1), material: "ST_PodiumRooms"));
        g = merge(g, beam_between(start: (ex + ox, ey + oy, (zt + zL1) * 0.5), end: (a2x + iwx * d + ox, a2y + iwy * d + oy, (zt + zL1) * 0.5), cross_width: 12, cross_height: zL1 - zt, height_direction: (0, 0, 1), material: "ST_DarkGlass"));
        g = merge(g, beam_between(start: (d1x + inx * d + mx, d1y + iny * d + my, (130 + zL1) * 0.5), end: (ex + mx, ey + my, (130 + zL1) * 0.5), cross_width: 12, cross_height: zL1 - 130, height_direction: (0, 0, 1), material: "ST_DarkGlass"));
        g = merge(g, beam_between(start: (q1x + inx * d + mx, q1y + iny * d + my, (130 + zL1) * 0.5), end: (c2x + inx * d + mx, c2y + iny * d + my, (130 + zL1) * 0.5), cross_width: 12, cross_height: zL1 - 130, height_direction: (0, 0, 1), material: "ST_DarkGlass"));
    } else {
        g = merge(g, copy_to_points(box_at(size: (200, 200, zL1 + 1), bottom_center: (0, 0, 0), material: "ST_Stone"), points: pts));
        // niche: one 180 x 180 box per giant column (the solid 'up' mass covers everything above zL1)
        g = merge(g, copy_to_points(box_at(size: (180, 180, zL1 + 1), bottom_center: (0, 0, 0), material: "ST_Stone"), points: cpa));
    }
}
out.geo = g;
#end

// ---------------------------------------------------------------------------------------------
// LOD1 bay rhythm: one stone pilaster block per bay boundary of a facade run (same layout as POD_Face) and
// one ST_PodiumRooms window panel per bay (~0.35 bay wide, z 3110-4380), 12 cm proud of the cream LOD1 band
// (band face at local y +40; a panel behind it would be buried in the band solid). panes = 0: pilasters only.
#meshpart POD_FaceLod
param ax = 0;
param ay = 0;
param bx = 1000;
param by = 0;
param pax = -1000;
param pay = 0;
param nbx = 2000;
param nby = 0;
param bay_t = 870;
param epa = 1;
param epb = 1;
param pier_a = 300;
param pier_b = 300;
param panes = 1;
// rev 5 (LOD3 = this level, renamed from lod: 1). lowwin = 1 (S / SE / E): the pilasters run down to grade and each
// bay gets the two LOD0 lower-storey windows as ST_PodiumRooms decals (320 x 760, 2 cm proud of the lower mass face;
// skip_a = 1 leaves the first bay blank as LOD0). dec = 1: the window columns become decals 2 cm proud of the band.
param lowwin = 0;
param skip_a = 0;
param dec = 0;
let dx = bx - ax;
let dy = by - ay;
let L = sqrt(dx * dx + dy * dy);
let ang = atan2(dy, dx);
let ux = dx / L;
let uy = dy / L;
let wa = sqrt((pax - ax) * (pax - ax) + (pay - ay) * (pay - ay));
let wb = sqrt((nbx - bx) * (nbx - bx) + (nby - by) * (nby - by));
let cot_a = (ux * (pax - ax) + uy * (pay - ay)) / wa / max(0.001, abs(ux * (pay - ay) - uy * (pax - ax)) / wa);
let cot_b = (0 - ux * (nbx - bx) - uy * (nby - by)) / wb / max(0.001, abs(ux * (nby - by) - uy * (nbx - bx)) / wb);
let xlo = select(135 + max(0, cot_a) * 80, pier_a - 25, epa > 1.5);
let xhi = select(L - 135 - max(0, cot_b) * 80, L - pier_b + 25, epb > 1.5);
let X0 = 1200;
let nbB = max(1, round((L - X0) / bay_t));
let nb = select(max(1, round(L / bay_t)), nbB + 1, epa > 1.5);
let bw = select(L / nb, (L - X0) / nbB, epa > 1.5);
let boff = select(0, X0 - bw, epa > 1.5);
var g = empty();
for i in 0..(nb + 1) {
    let skipp = (i < 0.5) * (epa > 1.5) + (i > nb - 0.5) * (epb > 1.5);
    if skipp < 0.5 {
        let xc = clamp(boff + i * bw, xlo, xhi);
        g = merge(g, box_bounds(min: (xc - 115, -20, select(3018, 0, lowwin > 0.5)), max: (xc + 115, 50, 4462), material: "ST_Stone"));
    }
}
if panes > 0.5 {
    for i in 0..nb {
        let x0 = clamp(boff + i * bw, xlo, xhi) + 115;
        let x1 = clamp(boff + (i + 1) * bw, xlo, xhi) - 115;
        // rev 4 (QC round 3): 3 narrow window columns per bay (0.1 bay wide, centres at 0 / +-0.25 wp) in the white
        // screen instead of one tall lit stripe
        let wpl = x1 - x0;
        let hw = min(0.05 * bw, 0.08 * wpl);
        let xm = (x0 + x1) * 0.5;
        for c in [0, 1, 2] {
            let xw = xm + (c - 1) * 0.25 * wpl;
            if dec > 0.5 {
                g = merge(g, translate(rotate_x(plane(width: hw * 2, height: 1270, material: "ST_PodiumRooms"), degrees: 90, pivot: (0, 0, 0)), (xw, 38, 3745)));
            } else {
                g = merge(g, box_bounds(min: (xw - hw, 28, 3110), max: (xw + hw, 41, 4380), material: "ST_PodiumRooms"));
            }
        }
    }
}
if lowwin > 0.5 {
    let lwin = translate(rotate_x(plane(width: 320, height: 760, material: "ST_PodiumRooms"), degrees: 90, pivot: (0, 0, 0)), (0, -2, 730));
    for i in 0..nb {
        if (i < 0.5) * skip_a < 0.5 {
            g = merge(g, translate(lwin, (boff + (i + 0.5) * bw, 0, 0)), translate(lwin, (boff + (i + 0.5) * bw, 0, 1000)));
        }
    }
}
out.geo = translate(rotate_z(g, degrees: ang, pivot: (0, 0, 0)), (ax, ay, 0));
#end

// ---------------------------------------------------------------------------------------------
// Ring-mitred courses / LOD1 bands on RN = podium outline (portal neck excluded, P4/P7 on the north line) with the
// P8 corner niche notched out. The niche walls (left = NW end-fin plane cut_b before P8 perpendicular to the north
// line, back = rec_d behind the west face, right = pier_a along it) are pushed s cm into the solid, so a course with
// outer offset o shows its niche-side face at (s - o) cm inside the niche wall: the courses stop at the niche
// (the giant columns stand free between 23 and 44.6 m) and only their end returns show in front of the jambs.
//   kind 0: LOD0 courseLow   1: LOD0 string course   2: LOD1 mid course   3: LOD1 balcony glass band
//   kind 4: LOD1 string course   5: LOD1 cream arched-tier band   6: LOD1 balustrade rail band (rev 4)
#meshpart POD_NotchRing
param kind = 0;
param s = 51;
param pier_a = 450;
param rec_d = 215;
param cut_b = 100;
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P8 = at(PODIUM_FP, 8);
let zL1 = 2300;
let zB0 = 2480;
let zB1 = 2960;
let zU0 = 3020;
let zU1 = 4460;
let wl = sqrt((P0.x - P8.x) * (P0.x - P8.x) + (P0.y - P8.y) * (P0.y - P8.y));
let wdx = (P0.x - P8.x) / wl;
let wdy = (P0.y - P8.y) / wl;
let iwx = 0 - wdy;
let iwy = wdx;
let nl = sqrt((P8.x - P3.x) * (P8.x - P3.x) + (P8.y - P3.y) * (P8.y - P3.y));
let ndx = (P8.x - P3.x) / nl;
let ndy = (P8.y - P3.y) / nl;
let inx = 0 - ndy;
let iny = ndx;
let kc = cut_b + s;
let kx = P8.x - ndx * kc;
let ky = P8.y - ndy * kc;
let t = (rec_d + s + kc * (ndx * iwx + ndy * iwy)) / (inx * iwx + iny * iwy);
let RN = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (kx, ky), (kx + inx * t, ky + iny * t), (P8.x + wdx * (pier_a + s) + iwx * (rec_d + s), P8.y + wdy * (pier_a + s) + iwy * (rec_d + s)), (P8.x + wdx * (pier_a + s), P8.y + wdy * (pier_a + s))];
var g = empty();
if kind < 0.5 {
    g = extrude_profile(points: RN, profile: [(zL1, 30), (zL1 + 100, 30), (zL1 + 100, 45), (zB0, 45)], material: "ST_Stone");
} else if kind < 1.5 {
    g = extrude_profile(points: RN, profile: [(zB1, 25), (zU0, 25)], material: "ST_Stone");
} else if kind < 2.5 {
    g = extrude_profile(points: RN, profile: [(zL1, 30), (zB0, 30)], material: "ST_Stone");
} else if kind < 3.5 {
    // rev 4 (QC round 3): dark recessed balcony storey (not a continuous lit ribbon), the white rail comes from kind 6
    g = translate(extrude(points: offset_polygon(points: RN, delta: -150), height: zB1 - zB0 + 2, material: "ST_DarkGlass"), (0, 0, zB0 - 1));
} else if kind < 4.5 {
    g = extrude_profile(points: RN, profile: [(zB1 - 60, 25), (zU0, 25)], material: "ST_Stone");
} else if kind < 5.5 {
    g = translate(extrude(points: offset_polygon(points: RN, delta: -40), height: zU1 - zU0 + 9, material: "ST_Facade"), (0, 0, zU0 - 4));
} else {
    // kind 6: LOD1 white balustrade rail band zB0 -> zB0 + 70 (10 cm proud, on top of the mid course)
    g = extrude_profile(points: RN, profile: [(zB0 - 6, 10), (zB0 + 70, 10)], material: "ST_Stone");
}
out.geo = g;
#end

// ---------------------------------------------------------------------------------------------
// P8 corner niche (photo 3 x 160-230, photo 2 red marker ~4.2-4.5 m, QC round 2): a pair of free-standing,
// full-height giant round columns (r 90, grade -> cornice soffit, abaci 1 cm into the cornice) on one pair pedestal,
// fronts on the west face line, standing in a niche pier_a along the west face and rec_d deep. Behind: the recessed
// cream pier (to the loggia backs, grade -> cornice); right: a jamb closing the west arched bays (first bay starts
// 7 cm inside it); left: the deep end fin of POD_FinScreen (cut_b before P8, perpendicular to the north line).
// Authored in the west-face frame at P8 (x along P8 -> P0, y inward), then turned onto the world.
#meshpart POD_CornerP8
param pier_a = 450;
param rec_d = 215;
param cut_b = 100;
// rev 5 LOD params (defaults = LOD0): giant column segments, simple = 1 plain shafts (POD_Column simple)
param cseg = 20;
param simple = 0;
let P0 = at(PODIUM_FP, 0);
let P3 = at(PODIUM_FP, 3);
let P8 = at(PODIUM_FP, 8);
let zL1 = 2300;
let zU1 = 4460;
let wl = sqrt((P0.x - P8.x) * (P0.x - P8.x) + (P0.y - P8.y) * (P0.y - P8.y));
let wdx = (P0.x - P8.x) / wl;
let wdy = (P0.y - P8.y) / wl;
let ang = atan2(wdy, wdx);
let nl = sqrt((P8.x - P3.x) * (P8.x - P3.x) + (P8.y - P3.y) * (P8.y - P3.y));
let ndx = (P8.x - P3.x) / nl;
let ndy = (P8.y - P3.y) / nl;
// north-line direction (nlx, nly) and its inward normal (ilx, ily) in the west-face frame
let nlx = ndx * wdx + ndy * wdy;
let nly = ndy * wdx - ndx * wdy;
let ilx = ndx * wdy - ndy * wdx;
let ily = ndy * wdy + ndx * wdx;
let kax = 0 - cut_b * nlx;
let kay = 0 - cut_b * nly;
let tm = cut_b * nlx / ilx;
let tj = (rec_d + cut_b * nly) / ily;
var g = empty();
// recessed pier: its left edge on the end-fin plane (from the x = 0 plane to the niche back), grade -> 10 cm into the cornice
g = merge(g, extrude(points: [(0, kay + ily * tm), (kax + ilx * tj, rec_d), (pier_a, rec_d), (pier_a, 702), (0, 702)], height: zU1 + 10, material: "ST_Facade"));
// right jamb (zL1 - 8 -> cornice)
g = merge(g, box_bounds(min: (pier_a - 2, -12, zL1 - 8), max: (pier_a + 34, rec_d + 20, zU1 + 1), material: "ST_Facade"));
// pair pedestal + the two giant columns (separate abaci 2.07 m, 13 cm apart)
g = merge(g, box_bounds(min: (-5, -25, 0), max: (445, rec_d + 1, 220), material: "ST_Stone"));
let col = part(POD_Column, x: 0, y: 0, z0: 0, z1: zU1 + 1, r: 90, ped_on: 0, ped_h: 220, segs: cseg, aba_k: 2.3, simple: simple);
g = merge(g, translate(col, (110, 90, 0)), translate(col, (330, 90, 0)));
out.geo = translate(rotate_z(g, degrees: ang, pivot: (0, 0, 0)), (P8.x, P8.y, 0));
#end

// ---------------------------------------------------------------------------------------------
// NW stretch (P7 -> P8) upper tiers zB0 -> zU1 (photo 2 between the portal flank and P8, photo 3 x 90-160): the
// portal flank's fin vocabulary - 5 white ST_Stone fins (110 wide, 34 cm proud of a cream ST_Facade wall) with a
// 4-column grid of small ST_PodiumRooms panes (56 x 110: 7 rows in the arched tier, 2 in the balcony storey). The
// last fin is the deep left jamb of the P8 corner niche (ends cut_b before P8, runs jamb_d back to the recessed
// pier, down to zL1 - 8). The NW loggia below stays POD_Face's. lod = 1 (LOD3): fins + one pane panel per gap.
// lod = 2 (LOD1 / LOD2, rev 5): LOD0 fins + a solid cream wall (same slab) with one ST_PodiumRooms decal per pane.
#meshpart POD_FinScreen
param ax = 0;
param ay = 0;
param bx = 1000;
param by = 0;
param cut_b = 100;
param ext_a = 20;
param jamb_d = 215;
param lod = 0;
let dx = bx - ax;
let dy = by - ay;
let L = sqrt(dx * dx + dy * dy);
let ang = atan2(dy, dx);
let Lf = L - cut_b;
let zL1 = 2300;
let zB0 = 2480;
let zU0 = 3020;
let zU1 = 4460;
let fw = 110;
let x00 = 0 - ext_a;
let p = (Lf - fw - x00) / 4;
let pw = 56;
let fd = select(34, 41, (lod > 0.5) * (lod < 1.5) > 0.5);
var g = empty();
for k in 0..4 {
    g = merge(g, box_bounds(min: (x00 + k * p, 0, zB0 - 2), max: (x00 + k * p + fw, fd, zU1 + 1), material: "ST_Stone"));
}
g = merge(g, box_bounds(min: (Lf - fw, 0, zL1 - 8), max: (Lf, jamb_d, zU1 + 1), material: "ST_Stone"));
if lod < 0.5 {
    let zw0 = zB0 - 2;
    // wall top 6 cm above the fin tops (all inside the cornice): no flush caps where the wall enters the end fin
    let hw = zU1 + 7 - zw0;
    var holes = [];
    for k in 0..4 {
        let cx = x00 + k * p + fw + (p - fw) * 0.5;
        for r in 0..9 {
            let wz = select(zB0 + 90 + r * 180, zU0 + 90 + (r - 2) * 190, r > 1.5) - zw0;
            holes = append(holes, [(cx - pw * 0.5, wz), (cx + pw * 0.5, wz), (cx + pw * 0.5, wz + 110), (cx - pw * 0.5, wz + 110)]);
        }
    }
    let wall = extrude_shape(outer: [(x00, 0), (Lf - 40, 0), (Lf - 40, hw), (x00, hw)], holes: holes, height: 30, material: "ST_Facade");
    g = merge(g, translate(rotate_x(wall, degrees: 90, pivot: (0, 0, 0)), (0, 64, zw0)));
    g = merge(g, box_bounds(min: (x00, 74, zw0), max: (Lf - 50, 84, zU1 + 2), material: "ST_PodiumRooms"));
} else if lod > 1.5 {
    let zw0 = zB0 - 2;
    g = merge(g, box_bounds(min: (x00, 34, zw0), max: (Lf - 40, 64, zU1 + 7), material: "ST_Facade"));
    let pane = rotate_x(plane(width: pw, height: 110, material: "ST_PodiumRooms"), degrees: 90, pivot: (0, 0, 0));
    for k in 0..4 {
        let cx = x00 + k * p + fw + (p - fw) * 0.5;
        for r in 0..9 {
            let wz = select(zB0 + 90 + r * 180, zU0 + 90 + (r - 2) * 190, r > 1.5);
            g = merge(g, translate(pane, (cx, 32, wz + 55)));
        }
    }
} else {
    for k in 0..4 {
        let cx = x00 + k * p + fw + (p - fw) * 0.5;
        g = merge(g, box_bounds(min: (cx - pw * 0.5, 28, 3110), max: (cx + pw * 0.5, 41, 4380), material: "ST_PodiumRooms"));
    }
}
out.geo = translate(rotate_z(g, degrees: ang, pivot: (0, 0, 0)), (ax, ay, 0));
#end

// ---------------------------------------------------------------------------------------------
// Corner portal (gate tower) on the north neck. Local frame: origin O = neck SW corner, x along the
// podium north line toward E (width W), y north (depth D), z up. North face (y = D) = street corner.
#meshpart POD_Portal
param ox = 0;
param oy = 0;
param ex = 1000;
param ey = 0;
param nx = 0;
param ny = 1000;
// rev 5 display LOD (default 0 = LOD0 unchanged). lod 1: 10-segment arches, 8-segment columns, 24-segment medallion,
// no gold petal edging (gold relief on the gold disc), coarser petal / lettering curves. lod 2: 6-segment arches,
// plain 6-sided column shafts, 16-segment medallion, no imposts / lobby mullions / cove strips / lettering, one block
// per pilaster.
param lod = 0;
let aseg = pick(lod, 16, 10, 6);
let pcseg = pick(lod, 18, 8, 6);
let mseg = pick(lod, 48, 24, 16);
let wx = ex - ox;
let wy = ey - oy;
let W = sqrt(wx * wx + wy * wy);
let ux = wx / W;
let uy = wy / W;
let D = (nx - ox) * (0 - uy) + (ny - oy) * ux;
let ang = atan2(uy, ux);
// rev 3 (QC round 2, option b): arch 9.6 m wide, crown 21.6 m just under the 22.0 m capitals (P3 H/W ~2.1,
// P1 arch head 21-22 m); entablature + ressauts shifted up 160 cm; attic + ledge up 100 / 60 cm so the ledge stays
// under the lettering (P3: ledge directly under "Bangkok", ~1.5 m from lettering to medallion)
let AR = 480;
let ZS = 1680;
let ZP1 = 2200;
let ZPE = 2620;
let ZLG0 = 2860;
let ZLG1 = 2940;
let ZU = 4720;
let ZC = PODIUM_TOP;
let ZTA = PORTAL_TOP - 95;
let ZMED = 3880;
let PW = W * 0.5 - AR;
let PD = D * 0.5 - AR;
let RECT = [(0, 0), (W, 0), (W, D), (0, D)];
// recessed round-headed panel on the north face (medallion + lettering): 20 cm deep
let RP = 540;
let RZ0 = ZLG1 + 10;
let RZS = 4130;
let RD = 20;
var g = empty();

// four corner piers + plinths. rev 4 (QC round 3): the lower-tier outer faces are recessed REC = 140 cm (north
// piers y max D - REC; west / east piers x min REC / x max W - REC) so the paired round shafts (cpos, r 80) stand
// free 10 cm clear of the piers with dark gaps behind them (P2 / P3). The south piers keep a 60 cm full-width return
// (y 0 -> RT) against the podium face so the recess never opens into the podium behind the portal.
let REC = 140;
let RT = 60;
let pierS = extrude(points: [(0, 0), (PW, 0), (PW, PD), (REC, PD), (REC, RT), (0, RT)], height: ZP1, material: "ST_Stone");
let pierN = box_bounds(min: (REC, D - PD, 0), max: (PW, D - REC, ZP1), material: "ST_Stone");
g = merge(g, mirrored(merge(pierS, pierN), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
let plS = extrude(points: [(-25, -25), (PW + 25, -25), (PW + 25, PD + 25), (REC - 25, PD + 25), (REC - 25, RT + 25), (-25, RT + 25)], height: 136, material: "ST_Stone");
let plN = box_bounds(min: (REC - 25, D - PD - 25, 0), max: (PW + 25, D - REC + 25, 136), material: "ST_Stone");
g = merge(g, mirrored(merge(plS, plN), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
// soffit over the recess (the entablature ceiling above the free-standing pairs)
g = merge(g, translate(extrude(points: [(0, 0), (REC + 1, 0), (REC + 1, D - REC - 15), (W - REC - 1, D - REC - 15), (W - REC - 1, 0), (W, 0), (W, D), (0, D)], height: 27, material: "ST_Stone"), (0, 0, ZP1 - 6)));

// arch heads (spandrels) on all four sides: giant round arch through the base (north / west / east recessed REC)
var sp = [];
sp = append(sp, (0, ZS));
sp = append(sp, (0, ZP1));
sp = append(sp, (2 * AR, ZP1));
sp = append(sp, (2 * AR, ZS));
for k in 1..aseg {
    let a = k * 180 / aseg;
    sp = append(sp, (AR + AR * cos(a), ZS + AR * sin(a)));
}
let spN = rotate_x(extrude(points: sp, height: PD, material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0));
let spNr = rotate_x(extrude(points: sp, height: PD - REC, material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0));
g = merge(g, translate(spNr, (PW, D - REC, 0)), translate(spN, (PW, PD, 0)));
let spW = rotate_z(rotate_x(extrude(points: sp, height: PW - REC, material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0)), degrees: 90, pivot: (0, 0, 0));
g = merge(g, translate(spW, (REC, PD, 0)), translate(spW, (W - PW, PD, 0)));

// archivolts + keystones (north, west, east), imposts: moved back with the recessed pier faces
let av = translate(part(POD_ArchBand, ro: AR + 38, ri: AR, lg: 20, depth: 24, segs: aseg), (0, 0, ZS));
let key = box_bounds(min: (-55, -22, ZS + AR - 30), max: (55, 22, ZP1 + 1), material: "ST_Stone");
let impN = merge(box_bounds(min: (PW - 1, D - PD - 1, ZS - 45), max: (PW + 18, D - REC + 1, ZS + 5), material: "ST_Stone"), box_bounds(min: (W - PW - 18, D - PD - 1, ZS - 45), max: (W - PW + 1, D - REC + 1, ZS + 5), material: "ST_Stone"), box_bounds(min: (PW - 75, D - REC - 1, ZS - 50), max: (PW + 22, D - REC + 16, ZS + 8), material: "ST_Stone"), box_bounds(min: (W - PW - 22, D - REC - 1, ZS - 50), max: (W - PW + 75, D - REC + 16, ZS + 8), material: "ST_Stone"));
let impW = merge(box_bounds(min: (REC - 1, PD - 1, ZS - 45), max: (PW + 1, PD + 18, ZS + 5), material: "ST_Stone"), box_bounds(min: (REC - 1, D - PD - 18, ZS - 45), max: (PW + 1, D - PD + 1, ZS + 5), material: "ST_Stone"), box_bounds(min: (REC - 16, PD - 75, ZS - 50), max: (REC + 1, PD + 22, ZS + 8), material: "ST_Stone"), box_bounds(min: (REC - 16, D - PD - 22, ZS - 50), max: (REC + 1, D - PD + 75, ZS + 8), material: "ST_Stone"));
if lod < 1.5 {
    g = merge(g, impN, mirrored(impW, normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
}
let avk = merge(av, key);
g = merge(g, translate(avk, (W * 0.5, D - REC + 11, 0)));
g = merge(g, mirrored(translate(rotate_z(avk, degrees: 90, pivot: (0, 0, 0)), (REC - 11, D * 0.5, 0)), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));

// glazed lobby entrance in the south arch (toward the podium) + dark metal frame
g = merge(g, box_bounds(min: (PW - 1, 300, 0), max: (W - PW + 1, 318, ZS + AR + 5), material: "ST_PodiumRooms"));
if lod < 1.5 {
for k in 1..5 {
    let mx = PW + k * 2 * AR / 5;
    let dxm = mx - W * 0.5;
    g = merge(g, box_bounds(min: (mx - 7, 317, 0), max: (mx + 7, 332, ZS + sqrt(AR * AR - dxm * dxm) + 2), material: "ST_DarkMetal"));
}
g = merge(g, box_bounds(min: (PW - 1, 317, 560), max: (W - PW + 1, 332, 580), material: "ST_DarkMetal"));
g = merge(g, box_bounds(min: (PW - 1, 317, ZS - 10), max: (W - PW + 1, 332, ZS + 10), material: "ST_DarkMetal"));
// warm cove strips under the vault ceiling (small fixtures)
g = merge(g, box_bounds(min: (PW, PD, ZP1 - 15), max: (W - PW, PD + 10, ZP1 + 1), material: "ST_WarmLight"));
g = merge(g, box_bounds(min: (PW, D - PD - 10, ZP1 - 15), max: (W - PW, D - PD, ZP1 + 1), material: "ST_WarmLight"));
g = merge(g, box_bounds(min: (PW, PD + 10, ZP1 - 15), max: (PW + 10, D - PD - 10, ZP1 + 1), material: "ST_WarmLight"));
g = merge(g, box_bounds(min: (W - PW - 10, PD + 10, ZP1 - 15), max: (W - PW, D - PD - 10, ZP1 + 1), material: "ST_WarmLight"));
}

// paired giant columns (r 80) at the corners of the north, west and east faces, each pair on one pedestal.
// rev 4: the shafts stand free (10 cm clear of the recessed piers, dark gaps behind them); pedestals (~1/6 of the
// order, 320 cm) run back into the recessed pier faces; pedestals and abaci stay within 50 cm of the neck outline.
let colA = part(POD_Column, x: 0, y: 0, z0: 0, z1: ZP1, r: 80, ped_h: 320, ped_on: 0, segs: pcseg, base_k: 1.07, cap_k: 1.05, aba_k: 2.1, simple: select(0, 1, lod > 1.5));
let cpos = [(135, D - 50, 0), (312, D - 50, 0), (W - 312, D - 50, 0), (W - 135, D - 50, 0), (50, D - 200, 0), (50, D - 385, 0), (50, 385, 0), (50, 200, 0), (W - 50, D - 200, 0), (W - 50, D - 385, 0), (W - 50, 385, 0), (W - 50, 200, 0)];
g = merge(g, copy_to_points(colA, points: cpos));
// (the north and west-north pair pedestals are one L-shaped block: no coplanar tops where they meet)
let pedNW = extrude(points: [(-50, D - 477), (REC + 10, D - 477), (REC + 10, D - REC - 10), (404, D - REC - 10), (404, D + 50), (43, D + 50), (43, D - 108), (-50, D - 108)], height: 320, material: "ST_Stone");
let pedWs = box_bounds(min: (-50, 108, 0), max: (REC + 10, 477, 320), material: "ST_Stone");
g = merge(g, mirrored(merge(pedNW, pedWs), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
// entablature breaks (ressauts) over the column pairs
let rA = extrude(points: [(-65, D - 485), (1, D - 485), (1, D - 1), (410, D - 1), (410, D + 65), (-65, D + 65)], height: 310, material: "ST_Stone");
let rC = extrude(points: [(-105, D - 525), (1, D - 525), (1, D - 1), (450, D - 1), (450, D + 105), (-105, D + 105)], height: 135, material: "ST_Stone");
g = merge(g, mirrored(merge(translate(rA, (0, 0, ZP1 - 10)), translate(rC, (0, 0, ZP1 + 300))), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
let rsA = box_bounds(min: (-65, -1, ZP1 - 10), max: (1, 485, ZP1 + 300), material: "ST_Stone");
let rsC = box_bounds(min: (-105, -1, ZP1 + 300), max: (1, 525, ZP1 + 435), material: "ST_Stone");
g = merge(g, mirrored(merge(rsA, rsC), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));

// upper mass: core recessed RD on the north face + a front slab with the round-headed panel opening
g = merge(g, box_bounds(min: (0, 0, ZP1 + 20), max: (W, D - RD, ZC - 10), material: "ST_Stone"));
var rh = [];
rh = append(rh, (W * 0.5 - RP, RZ0));
rh = append(rh, (W * 0.5 + RP, RZ0));
for k in 0..(aseg + 1) {
    let a = k * 180 / aseg;
    rh = append(rh, (W * 0.5 + RP * cos(a), RZS + RP * sin(a)));
}
let slab = extrude_shape(outer: [(0, ZP1 + 20), (W, ZP1 + 20), (W, ZC - 10), (0, ZC - 10)], holes: [rh], height: RD, material: "ST_Stone");
g = merge(g, translate(rotate_x(slab, degrees: 90, pivot: (0, 0, 0)), (0, D, 0)));
g = merge(g, translate(part(POD_ArchBand, ro: RP + 25, ri: RP - 2, lg: RZS - RZ0, depth: 14, segs: aseg), (W * 0.5, D + 5, RZS)));
// mitred horizontal courses (top course ledge ends 6 cm above the podium parapet top: no coplanar caps)
// (entablature: the 5 -> 30 overhang step sits 5 cm BELOW the ressaut rC/rsC bottoms at ZP1 + 300, so the two
//  downward faces are never coplanar - ENG round 2)
g = merge(g, extrude_profile(points: RECT, profile: [(ZP1, 15), (ZP1 + 150, 15), (ZP1 + 150, 5), (ZP1 + 295, 5), (ZP1 + 295, 30), (ZP1 + 340, 30), (ZP1 + 340, 80), (ZPE, 80)], material: "ST_Stone"));
g = merge(g, extrude_profile(points: RECT, profile: [(ZLG0, 10), (ZLG0 + 40, 10), (ZLG0 + 40, 45), (ZLG1, 45)], material: "ST_Stone"));
g = merge(g, extrude_profile(points: RECT, profile: [(ZU, 15), (4800, 15), (4800, 5), (4890, 5), (4890, 45), (4930, 45), (4930, 90), (ZC + 6, 90)], material: "ST_Stone"));
// attic panels
g = merge(g, box_bounds(min: (300, D - 1, ZPE + 20), max: (W - 300, D + 10, ZLG0 - 20), material: "ST_Stone"));
g = merge(g, mirrored(box_bounds(min: (-10, 300, ZPE + 20), max: (1, D - 300, ZLG0 - 20), material: "ST_Stone"), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));

// upper tier: paired corner pilasters (north), pilasters + broad white flutes with dark slits (west / east)
var pil = empty();
// broad paired pilasters (QC round 2: P1/P3 read ~1.3-1.5 m wide with ~0.4 m between): shafts 1.2 m, 30 cm apart
// (lod 2: one block per pilaster, capital / base width, full height)
for c in [85, 235] {
    if lod < 1.5 {
    pil = merge(pil, box_bounds(min: (c - 60, D - 1, ZLG1 + 58), max: (c + 60, D + 30, ZU - 78), material: "ST_Stone"));
    pil = merge(pil, box_bounds(min: (c - 70, D - 1, ZU - 80), max: (c + 70, D + 42, ZU + 1), material: "ST_Stone"));
    pil = merge(pil, box_bounds(min: (c - 70, D - 1, ZLG1 - 1), max: (c + 70, D + 42, ZLG1 + 60), material: "ST_Stone"));
    } else {
    pil = merge(pil, box_bounds(min: (c - 66, D - 1, ZLG1 - 1), max: (c + 66, D + 36, ZU + 1), material: "ST_Stone"));
    }
}
g = merge(g, mirrored(pil, normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
var side = empty();
for c in [75, 195, D - 195, D - 75] {
    if lod < 1.5 {
    side = merge(side, box_bounds(min: (-30, c - 37, ZLG1 + 58), max: (1, c + 37, ZU - 78), material: "ST_Stone"));
    side = merge(side, box_bounds(min: (-42, c - 45, ZU - 80), max: (1, c + 45, ZU + 1), material: "ST_Stone"));
    side = merge(side, box_bounds(min: (-42, c - 45, ZLG1 - 1), max: (1, c + 45, ZLG1 + 60), material: "ST_Stone"));
    } else {
    side = merge(side, box_bounds(min: (-36, c - 41, ZLG1 - 1), max: (1, c + 41, ZU + 1), material: "ST_Stone"));
    }
}
for k in 0..10 {
    let c = 305 + k * (D - 610) / 9;
    side = merge(side, box_bounds(min: (-30, c - 60, ZLG1 + 20), max: (1, c + 60, ZU - 20), material: "ST_Stone"));
}
side = merge(side, box_bounds(min: (-2, 300, ZLG1 + 140), max: (1, D - 300, ZU - 140), material: "ST_DarkGlass"));
g = merge(g, mirrored(side, normal: (1, 0, 0), point: (W * 0.5, 0, 0)));

// medallion in the recessed panel: white moulded ring, gold disc, white pointed 5-petal star-flower band
// with a thin raised gold edging on both sides, gold centre star
let ym = D - RD;
let flower = "M 0.0,-55.0 C 62.0,-78.0 138.0,-160.0 122.0,-240.0 C 110.0,-292.0 46.0,-318.0 0.0,-342.0 C -46.0,-318.0 -110.0,-292.0 -122.0,-240.0 C -138.0,-160.0 -62.0,-78.0 0.0,-55.0 Z M 52.3,-17.0 C 93.3,34.9 194.8,81.8 266.0,41.9 C 311.7,14.4 316.7,-54.5 325.3,-105.7 C 288.2,-142.0 243.7,-194.8 190.6,-190.2 C 109.5,-180.7 55.0,-83.1 52.3,-17.0 Z M 32.3,44.5 C -4.3,99.5 -17.6,210.6 42.4,265.9 C 82.6,300.9 149.7,284.3 201.0,276.7 C 224.1,230.2 260.6,171.6 239.8,122.5 C 205.7,48.3 96.0,26.7 32.3,44.5 Z M -32.3,44.5 C -96.0,26.7 -205.7,48.3 -239.8,122.5 C -260.6,171.6 -224.1,230.2 -201.0,276.7 C -149.7,284.3 -82.6,300.9 -42.4,265.9 C 17.6,210.6 4.3,99.5 -32.3,44.5 Z M -52.3,-17.0 C -55.0,-83.1 -109.5,-180.7 -190.6,-190.2 C -243.7,-194.8 -288.2,-142.0 -325.3,-105.7 C -316.7,-54.5 -311.7,14.4 -266.0,41.9 C -194.8,81.8 -93.3,34.9 -52.3,-17.0 Z";
let mback = translate(rotate_x(cylinder_at(radius: 482, height: 14, bottom_center: (0, 0, 0), segments: mseg, material: "ST_Stone"), degrees: -90, pivot: (0, 0, 0)), (W * 0.5, ym - 2, ZMED));
let mring = translate(rotate_x(torus_center(major_radius: 445, tube_radius: 32, segments: mseg, tube_segments: pick(lod, 8, 4, 3), center: (0, 0, 0), material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0)), (W * 0.5, ym + 16, ZMED));
let mgold = translate(rotate_x(cylinder_at(radius: 418, height: 20, bottom_center: (0, 0, 0), segments: mseg, material: "ST_Gold"), degrees: -90, pivot: (0, 0, 0)), (W * 0.5, ym + 8, ZMED));
let mstar = translate(rotate_x(extrude(points: star_profile(center: (0, 0), points: 5, r_outer: 80, r_inner: 34, rotation_degrees: -90), height: 10, material: "ST_Gold"), degrees: -90, pivot: (0, 0, 0)), (W * 0.5, ym + 38, ZMED));
if lod < 0.5 {
    let fgold = translate(svg_shape(d: flower, view_box: [-400, -400, 800, 800], origin: "center", scale: 1, stroke: 50, depth: 8, material: "ST_Gold"), (W * 0.5, ym + 34, ZMED));
    let fwhite = translate(svg_shape(d: flower, view_box: [-400, -400, 800, 800], origin: "center", scale: 1, stroke: 36, depth: 10, material: "ST_Stone"), (W * 0.5, ym + 42, ZMED));
    g = merge(g, mback, mring, mgold, fgold, fwhite, mstar);
} else {
    // lod >= 1: white petal band only (its gold edging is gold relief on the gold disc), coarser curve flattening
    let fwhite = translate(svg_shape(d: flower, view_box: [-400, -400, 800, 800], origin: "center", scale: 1, stroke: 36, depth: 10, tolerance: pick(lod, 1, 6, 25), material: "ST_Stone"), (W * 0.5, ym + 42, ZMED));
    g = merge(g, mback, mring, mgold, fwhite, mstar);
}
// "State Tower / Bangkok" lettering under the medallion: single-stroke ST_Gold relief (no external font)
// (lod 1: coarser curve flattening; lod 2: omitted)
if lod < 1.5 {
let ld1 = "M 62.0,-86.0 C 56.0,-97.0 44.0,-100.0 33.0,-100.0 C 17.0,-100.0 6.0,-90.0 6.0,-76.0 C 6.0,-47.0 66.0,-56.0 66.0,-25.0 C 66.0,-9.0 52.0,-0.0 35.0,-0.0 C 22.0,-0.0 10.0,-5.0 4.0,-16.0 M 104.0,-92.0 L 104.0,-12.0 C 104.0,-3.0 110.0,-0.0 118.0,-0.0 L 126.0,-2.0 M 90.0,-68.0 L 124.0,-68.0 M 196.0,-35.0 C 196.0,-58.0 184.0,-70.0 172.0,-70.0 C 158.0,-70.0 150.0,-55.0 150.0,-35.0 C 150.0,-14.0 158.0,-0.0 172.0,-0.0 C 184.0,-0.0 196.0,-12.0 196.0,-35.0 Z M 198.0,-70.0 L 198.0,-0.0 M 238.0,-92.0 L 238.0,-12.0 C 238.0,-3.0 244.0,-0.0 252.0,-0.0 L 260.0,-2.0 M 224.0,-68.0 L 258.0,-68.0 M 285.0,-37.0 L 332.0,-37.0 C 332.0,-58.0 322.0,-70.0 308.0,-70.0 C 293.0,-70.0 284.0,-55.0 284.0,-35.0 C 284.0,-13.0 294.0,-0.0 310.0,-0.0 C 320.0,-0.0 328.0,-5.0 332.0,-12.0 M 401.0,-100.0 L 463.0,-100.0 M 432.0,-100.0 L 432.0,-0.0 M 511.0,-0.0 C 527.0,-0.0 537.0,-14.0 537.0,-35.0 C 537.0,-56.0 527.0,-70.0 511.0,-70.0 C 495.0,-70.0 485.0,-56.0 485.0,-35.0 C 485.0,-14.0 495.0,-0.0 511.0,-0.0 Z M 559.0,-70.0 L 577.0,-0.0 L 598.0,-60.0 L 619.0,-0.0 L 637.0,-70.0 M 660.0,-37.0 L 707.0,-37.0 C 707.0,-58.0 697.0,-70.0 683.0,-70.0 C 668.0,-70.0 659.0,-55.0 659.0,-35.0 C 659.0,-13.0 669.0,-0.0 685.0,-0.0 C 695.0,-0.0 703.0,-5.0 707.0,-12.0 M 737.0,-70.0 L 737.0,-0.0 M 737.0,-42.0 C 743.0,-62.0 755.0,-70.0 769.0,-68.0";
let ld2 = "M 8.0,-0.0 L 8.0,-100.0 L 36.0,-100.0 C 52.0,-100.0 60.0,-90.0 60.0,-76.0 C 60.0,-62.0 50.0,-53.0 36.0,-53.0 L 8.0,-53.0 M 36.0,-53.0 C 54.0,-53.0 64.0,-42.0 64.0,-27.0 C 64.0,-10.0 52.0,-0.0 36.0,-0.0 L 8.0,-0.0 M 132.0,-35.0 C 132.0,-58.0 120.0,-70.0 108.0,-70.0 C 94.0,-70.0 86.0,-55.0 86.0,-35.0 C 86.0,-14.0 94.0,-0.0 108.0,-0.0 C 120.0,-0.0 132.0,-12.0 132.0,-35.0 Z M 134.0,-70.0 L 134.0,-0.0 M 166.0,-70.0 L 166.0,-0.0 M 166.0,-50.0 C 172.0,-64.0 182.0,-70.0 192.0,-70.0 C 204.0,-70.0 210.0,-62.0 210.0,-48.0 L 210.0,-0.0 M 284.0,-35.0 C 284.0,-58.0 272.0,-70.0 260.0,-70.0 C 246.0,-70.0 238.0,-55.0 238.0,-35.0 C 238.0,-14.0 246.0,-0.0 260.0,-0.0 C 272.0,-0.0 284.0,-12.0 284.0,-35.0 Z M 286.0,-70.0 L 286.0,8.0 C 286.0,24.0 276.0,30.0 262.0,30.0 C 252.0,30.0 244.0,26.0 240.0,20.0 M 318.0,-100.0 L 318.0,-0.0 M 360.0,-70.0 L 318.0,-30.0 M 334.0,-45.0 L 364.0,-0.0 M 412.0,-0.0 C 428.0,-0.0 438.0,-14.0 438.0,-35.0 C 438.0,-56.0 428.0,-70.0 412.0,-70.0 C 396.0,-70.0 386.0,-56.0 386.0,-35.0 C 386.0,-14.0 396.0,-0.0 412.0,-0.0 Z M 466.0,-100.0 L 466.0,-0.0 M 508.0,-70.0 L 466.0,-30.0 M 482.0,-45.0 L 512.0,-0.0";
var lt1 = empty();
var lt2 = empty();
if lod < 0.5 {
    lt1 = svg_shape(d: ld1, view_box: [-10, -110, 790, 150], origin: "bottom_center", scale: 1.25, stroke: 13, depth: 8, material: "ST_Gold");
    lt2 = svg_shape(d: ld2, view_box: [-10, -110, 532, 150], origin: "bottom_center", scale: 0.62, stroke: 8, depth: 8, material: "ST_Gold");
} else {
    lt1 = svg_shape(d: ld1, view_box: [-10, -110, 790, 150], origin: "bottom_center", scale: 1.25, stroke: 13, depth: 8, tolerance: 6, material: "ST_Gold");
    lt2 = svg_shape(d: ld2, view_box: [-10, -110, 532, 150], origin: "bottom_center", scale: 0.62, stroke: 8, depth: 8, tolerance: 6, material: "ST_Gold");
}
// (rev 3: +40 cm so "Bangkok" clears the raised ledge; baselines 31.3 / 29.95 m)
g = merge(g, translate(rotate_z(lt1, degrees: 180, pivot: (0, 0, 0)), (W * 0.5, ym - 1, 3130 - 40 * 1.25)));
g = merge(g, translate(rotate_z(lt2, degrees: 180, pivot: (0, 0, 0)), (W * 0.5, ym - 1, 2995 - 40 * 0.62)));
}

// pediment (north) on a gable roof running back to the podium
let sl = (ZTA - ZC) / (W * 0.5);
g = merge(g, translate(rotate_x(extrude(points: [(0, ZC - 2), (W, ZC - 2), (W * 0.5, ZTA)], height: D, material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0)), (0, D, 0)));
// rake cornice ends at -96 / W + 96: 6 cm clear of the top course flanks at -90 / W + 90 (no coplanar end faces)
let rk = extrude(points: [(-96, ZC - 2 - 96 * sl), (W * 0.5, ZTA - 2), (W + 96, ZC - 2 - 96 * sl), (W + 96, ZC + 93 - 96 * sl), (W * 0.5, ZTA + 93), (-96, ZC + 93 - 96 * sl)], height: 100, material: "ST_Stone");
g = merge(g, translate(rotate_x(rk, degrees: 90, pivot: (0, 0, 0)), (0, D + 95, 0)));
let nrm = 12 / sqrt(1 + sl * sl);
let roofL = extrude_loop(points: [(-60, -10, ZC - 4 - 60 * sl), (W * 0.5, -10, ZTA - 4), (W * 0.5, D - 6, ZTA - 4), (-60, D - 6, ZC - 4 - 60 * sl)], offset: (0 - sl * nrm, 0, nrm), material: "ST_Concrete");
g = merge(g, mirrored(roofL, normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
g = merge(g, cylinder_between(start: (W * 0.5, -18, ZTA + 4), end: (W * 0.5, D - 3, ZTA + 4), radius: 16, segments: 8, material: "ST_Stone"));

out.geo = translate(rotate_z(g, degrees: ang, pivot: (0, 0, 0)), (ox, oy, 0));
#end

// ---------------------------------------------------------------------------------------------
// Coarse portal mass: piers, upper block, gable. LOD1 (detail = 1) adds arch lintels, lobby glazing, the
// column shafts and the medallion disc; the collider (detail = 0) adds one box per column pair and the
// lobby glazing (walk-through north / west / east arches).
#meshpart POD_PortalMass
param ox = 0;
param oy = 0;
param ex = 1000;
param ey = 0;
param nx = 0;
param ny = 1000;
param detail = 1;
let wx = ex - ox;
let wy = ey - oy;
let W = sqrt(wx * wx + wy * wy);
let ux = wx / W;
let uy = wy / W;
let D = (nx - ox) * (0 - uy) + (ny - oy) * ux;
let ang = atan2(uy, ux);
let AR = 480;
let ZS = 1680;
let ZP1 = 2200;
let ZC = PODIUM_TOP;
let PW = W * 0.5 - AR;
let PD = D * 0.5 - AR;
// flat lintel standing in for the round arch head (2/3 of the rise above the springing)
let ZLT = ZS + AR * 0.67;
var g = box_bounds(min: (0, 0, ZP1), max: (W, D, ZC), material: "ST_Stone");
if detail > 0 {
    // rev 4: LOD1 piers recessed 140 cm on the north / west / east faces (as LOD0) so the 8-segment shafts stand
    // free; south piers keep the 60 cm full-width return against the podium face
    let REC = 140;
    let RT = 60;
    let pierS = extrude(points: [(0, 0), (PW, 0), (PW, PD), (REC, PD), (REC, RT), (0, RT)], height: ZP1 + 1, material: "ST_Stone");
    let pierN = box_bounds(min: (REC, D - PD, 0), max: (PW, D - REC, ZP1 + 1), material: "ST_Stone");
    g = merge(g, mirrored(merge(pierS, pierN), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
    g = merge(g, box_bounds(min: (PW - 1, D - PD, ZLT), max: (W - PW + 1, D - REC, ZP1 + 1), material: "ST_Stone"));
    g = merge(g, box_bounds(min: (REC, PD - 1, ZLT), max: (PW, D - PD + 1, ZP1 + 1), material: "ST_Stone"));
    g = merge(g, box_bounds(min: (W - PW, PD - 1, ZLT), max: (W - REC, D - PD + 1, ZP1 + 1), material: "ST_Stone"));
} else {
    let pier = box_bounds(min: (0, 0, 0), max: (PW, PD, ZP1 + 1), material: "ST_Stone");
    g = merge(g, pier, translate(pier, (W - PW, 0, 0)), translate(pier, (0, D - PD, 0)), translate(pier, (W - PW, D - PD, 0)));
}
g = merge(g, translate(rotate_x(extrude(points: [(0, ZC - 2), (W, ZC - 2), (W * 0.5, PORTAL_TOP)], height: D, material: "ST_Stone"), degrees: 90, pivot: (0, 0, 0)), (0, D, 0)));
if detail > 0 {
    g = merge(g, box_bounds(min: (PW - 1, 0, ZLT), max: (W - PW + 1, PD, ZP1 + 1), material: "ST_Stone"));
    g = merge(g, box_bounds(min: (PW, 300, 0), max: (W - PW, 318, ZLT), material: "ST_PodiumRooms"));
    let cpos = [(135, D - 50, 0), (312, D - 50, 0), (W - 312, D - 50, 0), (W - 135, D - 50, 0), (50, D - 200, 0), (50, D - 385, 0), (50, 385, 0), (50, 200, 0), (W - 50, D - 200, 0), (W - 50, D - 385, 0), (W - 50, 385, 0), (W - 50, 200, 0)];
    g = merge(g, copy_to_points(cylinder_at(radius: 80, height: ZP1 + 1, bottom_center: (0, 0, 0), segments: 8, material: "ST_Stone"), points: cpos));
    g = merge(g, translate(rotate_x(cylinder_at(radius: 440, height: 30, bottom_center: (0, 0, 0), segments: 20, material: "ST_Gold"), degrees: -90, pivot: (0, 0, 0)), (W * 0.5, D - 12, 3880)));
} else {
    let pedN = box_bounds(min: (43, D - 100, 0), max: (404, D + 50, ZP1), material: "ST_Stone");
    let pedWn = box_bounds(min: (-50, D - 477, 0), max: (100, D - 108, ZP1), material: "ST_Stone");
    let pedWs = box_bounds(min: (-50, 108, 0), max: (100, 477, ZP1), material: "ST_Stone");
    g = merge(g, mirrored(merge(pedN, pedWn, pedWs), normal: (1, 0, 0), point: (W * 0.5, 0, 0)));
    g = merge(g, box_bounds(min: (PW, 300, 0), max: (W - PW, 318, ZS + AR), material: "ST_Stone"));
}
out.geo = translate(rotate_z(g, degrees: ang, pivot: (0, 0, 0)), (ox, oy, 0));
#end

// =============================================================================================
#mesh ST_Podium
budget(verts: 250000, indices: 750000);
sim_box(min: (-9000, -9000, 0), max: (9000, 9000, 6000));
anchor(mode: "origin");
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P4 = at(PODIUM_FP, 4);
let P5 = at(PODIUM_FP, 5);
let P6 = at(PODIUM_FP, 6);
let P7 = at(PODIUM_FP, 7);
let P8 = at(PODIUM_FP, 8);
// main podium outline without the portal neck (P4, P7 lie on the straight north line P3 -> P8)
let RING = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (P8.x, P8.y)];
let zL1 = 2300;
let zB0 = 2480;
let zB1 = 2960;
let zU0 = 3020;
let zU1 = 4460;
let zCor = PODIUM_TOP - PARAPET_H;
// P8 corner niche: width along the west face, depth behind it, NW end-fin plane distance before P8 (shared by
// POD_Face / POD_CornerP8 / POD_FinScreen / POD_NotchRing / POD_LowBlock / POD_FaceLod)
let NPA = 450;
let NRD = 215;
let NCB = 100;

// facades (CCW runs). Giant colonnades + 7 m loggias at grade: west (Charoen Krung, 9 bays of 9.6 m,
// P8 corner niche with paired giant columns) and both north stretches beside the portal (one column mid-opening);
// the NW stretch's upper tiers are the fin screen (POD_FinScreen), not arched bays.
let faceS = part(POD_Face, ax: P0.x, ay: P0.y, bx: P1.x, by: P1.y, pax: P8.x, pay: P8.y, nbx: P2.x, nby: P2.y, skip_a: 1);
let faceSE = part(POD_Face, ax: P1.x, ay: P1.y, bx: P2.x, by: P2.y, pax: P0.x, pay: P0.y, nbx: P3.x, nby: P3.y);
let faceE = part(POD_Face, ax: P2.x, ay: P2.y, bx: P3.x, by: P3.y, pax: P1.x, pay: P1.y, nbx: P4.x, nby: P4.y);
let faceNE = part(POD_Face, ax: P3.x, ay: P3.y, bx: P4.x, by: P4.y, pax: P2.x, pay: P2.y, nbx: P5.x, nby: P5.y, ext_b: 20, colonnade: 1, pier_a: 300, pier_b: 120, epa: 1, epb: 1, ncol: 1);
let faceNW = part(POD_Face, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, pax: P6.x, pay: P6.y, nbx: P0.x, nby: P0.y, ext_a: 20, colonnade: 1, pier_a: 120, pier_b: 300, epa: 1, epb: 0, ncol: 1, upper: 0);
let finNW = part(POD_FinScreen, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, cut_b: NCB, ext_a: 20, jamb_d: NRD);
let faceW = part(POD_Face, ax: P8.x, ay: P8.y, bx: P0.x, by: P0.y, pax: P7.x, pay: P7.y, nbx: P1.x, nby: P1.y, colonnade: 1, bay_t: 960, pier_a: NPA, pier_b: 300, epa: 2, epb: 1);
let cornerP8 = part(POD_CornerP8, pier_a: NPA, rec_d: NRD, cut_b: NCB);

// mitred horizontal courses: base kerb on the loggia-recessed outline (loggia floors at grade); courseLow and the
// string course on the niche-notched ring (they stop at the P8 niche); cornice, parapet, roof on RING
let courseBase = part(POD_LowBlock, mode: 0);
let courseLow = part(POD_NotchRing, kind: 0, s: 51, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let courseString = part(POD_NotchRing, kind: 1, s: 51, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let cornice = extrude_profile(points: RING, profile: [(zU1, 15), (zU1 + 100, 15), (zU1 + 100, 5), (zCor - 190, 5), (zCor - 190, 45), (zCor - 145, 45), (zCor - 145, 135), (zCor - 40, 135), (zCor - 40, 158), (zCor, 158)], material: "ST_Facade");
let parapet = translate(extrude_shape(outer: offset_polygon(points: RING, delta: 125), holes: [offset_polygon(points: RING, delta: 75)], height: PODIUM_TOP - zCor + 2, material: "ST_Stone"), (0, 0, zCor - 2));
let roof = translate(extrude(points: offset_polygon(points: RING, delta: 80), height: 20, material: "ST_Concrete"), (0, 0, zCor - 10));
// tower bearing plinths: the tower parts start at z 4998 inside their footprints (shaded sides = tower base)
let pl_h = PODIUM_TOP - zCor + 5;
let plinths = translate(merge(extrude(points: MAIN_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: STRIP210_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING170_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING160_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING150_FP, height: pl_h, material: "ST_FacadeShade")), (0, 0, zCor - 5));

let portal = part(POD_Portal, ox: P7.x, oy: P7.y, ex: P4.x, ey: P4.y, nx: P6.x, ny: P6.y);
out.geo = merge(faceS, faceSE, faceE, faceNE, faceNW, finNW, faceW, cornerP8, courseBase, courseLow, courseString, cornice, parapet, roof, plinths, portal);
#end

// =============================================================================================
// LOD1 (near-mid, ~60 % of LOD0): every LOD0 part and feature in the LOD0 frame, reduced through the parts' LOD
// params (see POD_Face / POD_Portal / POD_FinScreen / POD_CornerP8 headers).
#mesh ST_Podium lod: 1
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P4 = at(PODIUM_FP, 4);
let P5 = at(PODIUM_FP, 5);
let P6 = at(PODIUM_FP, 6);
let P7 = at(PODIUM_FP, 7);
let P8 = at(PODIUM_FP, 8);
let RING = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (P8.x, P8.y)];
let zU1 = 4460;
let zCor = PODIUM_TOP - PARAPET_H;
let NPA = 450;
let NRD = 215;
let NCB = 100;
let faceS = part(POD_Face, ax: P0.x, ay: P0.y, bx: P1.x, by: P1.y, pax: P8.x, pay: P8.y, nbx: P2.x, nby: P2.y, skip_a: 1, lod: 1);
let faceSE = part(POD_Face, ax: P1.x, ay: P1.y, bx: P2.x, by: P2.y, pax: P0.x, pay: P0.y, nbx: P3.x, nby: P3.y, lod: 1);
let faceE = part(POD_Face, ax: P2.x, ay: P2.y, bx: P3.x, by: P3.y, pax: P1.x, pay: P1.y, nbx: P4.x, nby: P4.y, lod: 1);
let faceNE = part(POD_Face, ax: P3.x, ay: P3.y, bx: P4.x, by: P4.y, pax: P2.x, pay: P2.y, nbx: P5.x, nby: P5.y, ext_b: 20, colonnade: 1, pier_a: 300, pier_b: 120, epa: 1, epb: 1, ncol: 1, lod: 1);
let faceNW = part(POD_Face, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, pax: P6.x, pay: P6.y, nbx: P0.x, nby: P0.y, ext_a: 20, colonnade: 1, pier_a: 120, pier_b: 300, epa: 1, epb: 0, ncol: 1, upper: 0, lod: 1);
let finNW = part(POD_FinScreen, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, cut_b: NCB, ext_a: 20, jamb_d: NRD, lod: 2);
let faceW = part(POD_Face, ax: P8.x, ay: P8.y, bx: P0.x, by: P0.y, pax: P7.x, pay: P7.y, nbx: P1.x, nby: P1.y, colonnade: 1, bay_t: 960, pier_a: NPA, pier_b: 300, epa: 2, epb: 1, lod: 1);
let cornerP8 = part(POD_CornerP8, pier_a: NPA, rec_d: NRD, cut_b: NCB, cseg: 10);
let courseBase = part(POD_LowBlock, mode: 0);
let courseLow = part(POD_NotchRing, kind: 0, s: 51, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let courseString = part(POD_NotchRing, kind: 1, s: 51, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let cornice = extrude_profile(points: RING, profile: [(zU1, 15), (zU1 + 100, 15), (zU1 + 100, 5), (zCor - 190, 5), (zCor - 190, 45), (zCor - 145, 45), (zCor - 145, 135), (zCor - 40, 135), (zCor - 40, 158), (zCor, 158)], material: "ST_Facade");
let parapet = translate(extrude_shape(outer: offset_polygon(points: RING, delta: 125), holes: [offset_polygon(points: RING, delta: 75)], height: PODIUM_TOP - zCor + 2, material: "ST_Stone"), (0, 0, zCor - 2));
let roof = translate(extrude(points: offset_polygon(points: RING, delta: 80), height: 20, material: "ST_Concrete"), (0, 0, zCor - 10));
let pl_h = PODIUM_TOP - zCor + 5;
let plinths = translate(merge(extrude(points: MAIN_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: STRIP210_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING170_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING160_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING150_FP, height: pl_h, material: "ST_FacadeShade")), (0, 0, zCor - 5));
let portal = part(POD_Portal, ox: P7.x, oy: P7.y, ex: P4.x, ey: P4.y, nx: P6.x, ny: P6.y, lod: 1);
out.geo = merge(faceS, faceSE, faceE, faceNE, faceNW, finNW, faceW, cornerP8, courseBase, courseLow, courseString, cornice, parapet, roof, plinths, portal);
#end

// =============================================================================================
// LOD2 (mid-far, ~30 % of LOD0): same parts at lod 2 - silhouette, bay / arch / column rhythm, cornice, portal arch,
// medallion and pediment; the cornice keeps its three main projections (sub-10 cm steps merged).
#mesh ST_Podium lod: 2
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P4 = at(PODIUM_FP, 4);
let P5 = at(PODIUM_FP, 5);
let P6 = at(PODIUM_FP, 6);
let P7 = at(PODIUM_FP, 7);
let P8 = at(PODIUM_FP, 8);
let RING = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (P8.x, P8.y)];
let zU1 = 4460;
let zCor = PODIUM_TOP - PARAPET_H;
let NPA = 450;
let NRD = 215;
let NCB = 100;
let faceS = part(POD_Face, ax: P0.x, ay: P0.y, bx: P1.x, by: P1.y, pax: P8.x, pay: P8.y, nbx: P2.x, nby: P2.y, skip_a: 1, lod: 2);
let faceSE = part(POD_Face, ax: P1.x, ay: P1.y, bx: P2.x, by: P2.y, pax: P0.x, pay: P0.y, nbx: P3.x, nby: P3.y, lod: 2);
let faceE = part(POD_Face, ax: P2.x, ay: P2.y, bx: P3.x, by: P3.y, pax: P1.x, pay: P1.y, nbx: P4.x, nby: P4.y, lod: 2);
let faceNE = part(POD_Face, ax: P3.x, ay: P3.y, bx: P4.x, by: P4.y, pax: P2.x, pay: P2.y, nbx: P5.x, nby: P5.y, ext_b: 20, colonnade: 1, pier_a: 300, pier_b: 120, epa: 1, epb: 1, ncol: 1, lod: 2);
let faceNW = part(POD_Face, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, pax: P6.x, pay: P6.y, nbx: P0.x, nby: P0.y, ext_a: 20, colonnade: 1, pier_a: 120, pier_b: 300, epa: 1, epb: 0, ncol: 1, upper: 0, lod: 2);
let finNW = part(POD_FinScreen, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, cut_b: NCB, ext_a: 20, jamb_d: NRD, lod: 2);
let faceW = part(POD_Face, ax: P8.x, ay: P8.y, bx: P0.x, by: P0.y, pax: P7.x, pay: P7.y, nbx: P1.x, nby: P1.y, colonnade: 1, bay_t: 960, pier_a: NPA, pier_b: 300, epa: 2, epb: 1, lod: 2);
let cornerP8 = part(POD_CornerP8, pier_a: NPA, rec_d: NRD, cut_b: NCB, cseg: 8, simple: 1);
let courseBase = part(POD_LowBlock, mode: 0);
let courseLow = part(POD_NotchRing, kind: 0, s: 51, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let courseString = part(POD_NotchRing, kind: 1, s: 51, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let cornice = extrude_profile(points: RING, profile: [(zU1, 10), (zCor - 190, 10), (zCor - 190, 45), (zCor - 145, 45), (zCor - 145, 150), (zCor, 150)], material: "ST_Facade");
let parapet = translate(extrude_shape(outer: offset_polygon(points: RING, delta: 125), holes: [offset_polygon(points: RING, delta: 75)], height: PODIUM_TOP - zCor + 2, material: "ST_Stone"), (0, 0, zCor - 2));
let roof = translate(extrude(points: offset_polygon(points: RING, delta: 80), height: 20, material: "ST_Concrete"), (0, 0, zCor - 10));
let pl_h = PODIUM_TOP - zCor + 5;
let plinths = translate(merge(extrude(points: MAIN_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: STRIP210_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING170_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING160_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING150_FP, height: pl_h, material: "ST_FacadeShade")), (0, 0, zCor - 5));
let portal = part(POD_Portal, ox: P7.x, oy: P7.y, ex: P4.x, ey: P4.y, nx: P6.x, ny: P6.y, lod: 2);
out.geo = merge(faceS, faceSE, faceE, faceNE, faceNW, finNW, faceW, cornerP8, courseBase, courseLow, courseString, cornice, parapet, roof, plinths, portal);
#end

// =============================================================================================
// LOD3 (far display, rev 5: the former lod: 1 renamed). rev 5 fix: the S / SE / E faces were blank from grade to
// 23 m - their bay pilasters now run down to grade with the two lower-storey windows per bay as ST_PodiumRooms decals
// (POD_FaceLod lowwin), and the upper window columns are decals (dec) to stay inside 3-6 % of LOD0.
#mesh ST_Podium lod: 3
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P4 = at(PODIUM_FP, 4);
let P5 = at(PODIUM_FP, 5);
let P6 = at(PODIUM_FP, 6);
let P7 = at(PODIUM_FP, 7);
let P8 = at(PODIUM_FP, 8);
let RING = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (P8.x, P8.y)];
let zL1 = 2300;
let zB0 = 2480;
let zB1 = 2960;
let zU0 = 3020;
let zU1 = 4460;
let zCor = PODIUM_TOP - PARAPET_H;
let NPA = 450;
let NRD = 215;
let NCB = 100;
// lower mass with the three loggias at grade, P8 niche (recessed pier, giant column pair, right jamb),
// colonnade shafts, loggia glazing
let low = part(POD_LowBlock, mode: 1, pier_a: NPA, rec_d: NRD, cut_b: NCB);
// niche-notched ring bands (their niche faces land inside the jamb / pier / end fin): mid course, recessed
// balcony glass, string course, cream arched-tier band inset 40 cm (ST_Facade, as LOD0's cream screens)
let mid = part(POD_NotchRing, kind: 2, s: 36, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let balc = part(POD_NotchRing, kind: 3, s: -70, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let rail = part(POD_NotchRing, kind: 6, s: 36, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let strc = part(POD_NotchRing, kind: 4, s: 36, pier_a: NPA, rec_d: NRD, cut_b: NCB);
let band = part(POD_NotchRing, kind: 5, s: 36, pier_a: NPA, rec_d: NRD, cut_b: NCB);
// one stone pilaster block per bay boundary + three window-column decals per bay; NW stretch: its 5 fins + pane
// panels; S / SE / E: pilasters to grade + two lower window decals per bay (S: first bay blank, as LOD0)
let pils = merge(part(POD_FaceLod, ax: P0.x, ay: P0.y, bx: P1.x, by: P1.y, pax: P8.x, pay: P8.y, nbx: P2.x, nby: P2.y, dec: 1, lowwin: 1, skip_a: 1), part(POD_FaceLod, ax: P1.x, ay: P1.y, bx: P2.x, by: P2.y, pax: P0.x, pay: P0.y, nbx: P3.x, nby: P3.y, dec: 1, lowwin: 1), part(POD_FaceLod, ax: P2.x, ay: P2.y, bx: P3.x, by: P3.y, pax: P1.x, pay: P1.y, nbx: P4.x, nby: P4.y, dec: 1, lowwin: 1), part(POD_FaceLod, ax: P3.x, ay: P3.y, bx: P4.x, by: P4.y, pax: P2.x, pay: P2.y, nbx: P5.x, nby: P5.y, dec: 1), part(POD_FinScreen, ax: P7.x, ay: P7.y, bx: P8.x, by: P8.y, cut_b: NCB, ext_a: 20, jamb_d: NRD, lod: 1), part(POD_FaceLod, ax: P8.x, ay: P8.y, bx: P0.x, by: P0.y, pax: P7.x, pay: P7.y, nbx: P1.x, nby: P1.y, bay_t: 960, epa: 2, pier_a: NPA, dec: 1));
let corn = extrude_profile(points: RING, profile: [(zU1, 15), (zCor - 145, 15), (zCor - 145, 150), (zCor, 150)], material: "ST_Facade");
let parapet = translate(extrude_shape(outer: offset_polygon(points: RING, delta: 125), holes: [offset_polygon(points: RING, delta: 75)], height: PODIUM_TOP - zCor + 2, material: "ST_Stone"), (0, 0, zCor - 2));
let roof = translate(extrude(points: offset_polygon(points: RING, delta: 80), height: 20, material: "ST_Concrete"), (0, 0, zCor - 10));
let pl_h = PODIUM_TOP - zCor + 5;
let plinths = translate(merge(extrude(points: MAIN_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: STRIP210_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING170_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING160_FP, height: pl_h, material: "ST_FacadeShade"), extrude(points: WING150_FP, height: pl_h, material: "ST_FacadeShade")), (0, 0, zCor - 5));
let portal = part(POD_PortalMass, ox: P7.x, oy: P7.y, ex: P4.x, ey: P4.y, nx: P6.x, ny: P6.y, detail: 1);
out.geo = merge(low, mid, balc, rail, strc, band, pils, corn, parapet, roof, plinths, portal);
#end

// =============================================================================================
#mesh ST_Podium collider
let P0 = at(PODIUM_FP, 0);
let P1 = at(PODIUM_FP, 1);
let P2 = at(PODIUM_FP, 2);
let P3 = at(PODIUM_FP, 3);
let P4 = at(PODIUM_FP, 4);
let P6 = at(PODIUM_FP, 6);
let P7 = at(PODIUM_FP, 7);
let P8 = at(PODIUM_FP, 8);
let RING = [(P0.x, P0.y), (P1.x, P1.y), (P2.x, P2.y), (P3.x, P3.y), (P8.x, P8.y)];
let zL1 = 2300;
let zRoof = PODIUM_TOP - PARAPET_H + 10;
// walkable loggias at grade (west + both north stretches): same outline, piers and columns as LOD0 / LOD1
let low = part(POD_LowBlock, mode: 2, pier_a: 450, rec_d: 215, cut_b: 100);
let up = translate(extrude(points: RING, height: zRoof - zL1, material: "ST_Stone"), (0, 0, zL1));
let slab = translate(extrude(points: offset_polygon(points: RING, delta: 125), height: 20, material: "ST_Stone"), (0, 0, zRoof - 20));
let rim = extrude_shape(outer: offset_polygon(points: RING, delta: 125), holes: [offset_polygon(points: RING, delta: 75)], height: PODIUM_TOP - zRoof + 1, material: "ST_Stone");
// (rev 3: the five tower-plinth prisms are dropped - ENG round 2: the tower colliders start at 4986-4998 above the
//  4880-4900 walking slab, and the cap margin is restored)
let portal = part(POD_PortalMass, ox: P7.x, oy: P7.y, ex: P4.x, ey: P4.y, nx: P6.x, ny: P6.y, detail: 0);
out.geo = merge(low, up, slab, translate(rim, (0, 0, zRoof - 1)), portal);
#end
